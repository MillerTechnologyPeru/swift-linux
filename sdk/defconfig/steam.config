# Steam (x86_64 native, Stage 1)
#
# Installs the Steam launcher only; the client and Steam Runtime download on
# first launch. Needs a 32-bit userland (lib32 profile / SWIFT_LINUX_LIB32_ROOT)
# for the bootstrap binary, and XWayland for the X11 UI under sway.
#
# NSS is intentionally not built: modern Steam ships libnss3 in its own Steam
# Runtime, so the host does not need it for Stage 1.

BR2_PACKAGE_STEAM=y

# Steam's UI is X11 and relies on XWayland, which is enabled image-wide in
# image.config (BR2_PACKAGE_XORG7 / XWAYLAND / WLROOTS_XWAYLAND).

# bash (the Steam launcher is a bash script). BR2_PACKAGE_BASH depends on
# busybox not hiding programs it also provides.
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_BASH=y
