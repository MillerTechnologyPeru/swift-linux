# Audio: PipeWire + WirePlumber (no systemd).
#
# PipeWire is the sound server; enabling it also builds its PulseAudio-
# compatible server (pipewire-pulse), so Steam, SDL and other PulseAudio
# clients get sound, and its ALSA plugin so ALSA clients route through it.
# Bluetooth audio (A2DP) comes via the bluez audio plugins PipeWire selects.
# WirePlumber is the session/policy manager. All run as user-session daemons
# launched from the sway session (see the sway config), not as system
# services, so no systemd is involved.

BR2_PACKAGE_PIPEWIRE=y
# Bluetooth audio. PipeWire's entire bluez5 support is gated on sbc being
# present (it is the mandatory A2DP codec) - without it the build silently
# disables Bluetooth audio altogether. fdk-aac adds the AAC codec on top.
BR2_PACKAGE_SBC=y
BR2_PACKAGE_FDK_AAC=y
# Higher-quality Bluetooth codecs. PipeWire's meson auto-detects ldac and
# aptx from staging, so packaging the libraries is enough; LC3 (LE Audio)
# additionally needs the pipewire buildroot patch applied (see
# external/patches/buildroot/README.md) - the library is enabled here so
# the codec lights up the moment the patch is in the tree.
BR2_PACKAGE_LIBLDAC=y
BR2_PACKAGE_LIBFREEAPTX=y
BR2_PACKAGE_LIBLC3=y
# Sound file loading for pw-cat and friends.
BR2_PACKAGE_LIBSNDFILE=y
BR2_PACKAGE_WIREPLUMBER=y
# WirePlumber depends on (does not select) Lua, so enable it explicitly or
# WirePlumber is silently dropped from the config. Deliberately repeated
# from runtimes.config, which is where Lua belongs as a language runtime:
# the lib32 companion includes this fragment but not that one, and the
# 32-bit WirePlumber would vanish if the declaration lived only there.
# Same value either way, so whichever fragment lands last is fine.
BR2_PACKAGE_LUA=y
BR2_PACKAGE_LUA_5_4=y

# ALSA command-line tools for bring-up/testing on target (aplay, amixer,
# speaker-test). alsa-lib itself is pulled in by PipeWire.
# Codec routing data. alsa-lib carries the Use Case Manager code but none of
# its data; without these profiles, audio on most ARM SoCs does not route at
# all (nothing enables the amplifier or selects speaker vs headphone paths).
# The topology files serve DSP-routed cards (SOF and similar) the same way.
BR2_PACKAGE_ALSA_UCM_CONF=y
BR2_PACKAGE_ALSA_TOPOLOGY_CONF=y

BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_UTILS_SPEAKER_TEST=y
