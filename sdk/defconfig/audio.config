# Audio: PipeWire + WirePlumber (no systemd).
#
# PipeWire is the sound server; enabling it also builds its PulseAudio-
# compatible server (pipewire-pulse), so Steam, SDL and other PulseAudio
# clients get sound, and its ALSA plugin so ALSA clients route through it.
# Bluetooth audio (A2DP) comes via the bluez audio plugins PipeWire selects.
# WirePlumber is the session/policy manager. All run as user-session daemons
# launched from the sway session (see the sway config), not as system
# services, so no systemd is involved.

BR2_PACKAGE_PIPEWIRE=y
BR2_PACKAGE_WIREPLUMBER=y
# WirePlumber depends on (does not select) Lua, so enable it explicitly or
# WirePlumber is silently dropped from the config.
BR2_PACKAGE_LUA=y
BR2_PACKAGE_LUA_5_4=y

# ALSA command-line tools for bring-up/testing on target (aplay, amixer,
# speaker-test). alsa-lib itself is pulled in by PipeWire.
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_UTILS_SPEAKER_TEST=y
