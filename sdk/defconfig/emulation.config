# Binary translation and compatibility layers.
#
# Running programs built for another architecture, or another operating
# system, than the board itself. Collected here rather than scattered
# through the arch fragments because every entry answers the same
# question and because each one's Kconfig already carries the
# architecture rule that decides where it applies - so this single
# fragment can be included everywhere and each symbol lands only where it
# means something:
#
#   box64      aarch64 (and riscv/ppc64le) - runs x86-64 Linux binaries
#   box86      32-bit ARM - runs x86 Linux binaries; built in the armv7
#              companion and merged into the arm64 image (see
#              post-build-lib32.sh)
#   wine       i386 only, per Buildroot's package - built in the i386
#              companion, which is what gives the x86_64 images 32-bit
#              Windows support
#   qemu       everywhere
#
# The fragment is included by both the image and lib32 profiles, since
# some of these are native to the image and others are by definition
# built in the 32-bit companion. In the lib32 profiles it is emitted
# BEFORE lib32.config, which negates what makes no sense in a library
# companion (QEMU).

# box64/box86: lightweight x86 translation, wrapping native libraries
# rather than emulating them, which is what makes them fast enough for
# games on handheld hardware.
BR2_PACKAGE_BOX64=y
BR2_PACKAGE_BOX86=y

# Wine. Buildroot builds it from source; the package is x86-specific
# ("Wine has much CPU specific code and mostly makes sense on x86") and
# i386-only, which is exactly the companion paired with an x86_64 image.
# A 32-bit Wine on a 64-bit kernel is what runs the bulk of Windows
# software.
BR2_PACKAGE_WINE=y

# QEMU. Two distinct things, both wanted:
#
#   linux-user - runs a single foreign-architecture binary directly,
#                which is what the binfmt handlers registered at boot
#                (see S07binfmt) dispatch to for architectures box64 and
#                box86 do not cover.
#   system     - full machine emulation, so a device can boot an image
#                (including this distribution's own) to test it. KVM
#                where the hardware allows, TCG where it does not.
#
# The target list is deliberately narrow - the architectures this
# project builds for, plus the x86 ones worth emulating - because each
# target adds build time and size.
BR2_PACKAGE_QEMU=y
BR2_PACKAGE_QEMU_LINUX_USER=y
BR2_PACKAGE_QEMU_SYSTEM=y
BR2_PACKAGE_QEMU_SYSTEM_KVM=y
BR2_PACKAGE_QEMU_SYSTEM_TCG=y
BR2_PACKAGE_QEMU_SLIRP=y
BR2_PACKAGE_QEMU_TARGET_I386=y
BR2_PACKAGE_QEMU_TARGET_X86_64=y
BR2_PACKAGE_QEMU_TARGET_ARM=y
BR2_PACKAGE_QEMU_TARGET_AARCH64=y

# Steam (this repo's package: the launcher .deb only - the client and its
# runtime download into the user's home on first start). x86_64 runs it
# natively; aarch64 through box64, which its Config.in selects there. The
# 32-bit bootstrap needs the merged lib32 companion either way, and the
# UI needs the XWayland the frontends already run. The package gates
# itself to x86_64/aarch64 glibc, so this line is inert elsewhere.
BR2_PACKAGE_STEAM=y
