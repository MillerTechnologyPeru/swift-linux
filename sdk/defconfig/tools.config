# Command line tools present in every build.
#
# Deliberately free of graphics dependencies so this fragment is safe in the
# sdk and lib32 profiles too; the image adds its own graphical diagnostics.
BR2_PACKAGE_FILE=y
BR2_PACKAGE_HTOP=y
BR2_PACKAGE_NANO=y
BR2_PACKAGE_SUDO=y

# Networking
BR2_PACKAGE_LIBCURL_CURL=y

// Basic Bash support
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_BASH=y
# Debugging and session tools whose busybox counterparts fall short, per
# the comparison with the leading gaming distro's shared board config:
# full ps/top field support for scripts, fuser/killall/pstree, open-file
# inspection, a real pager, and terminal multiplexing for ssh sessions
# on devices. Still graphics-free, so the sdk profiles stay safe.
BR2_PACKAGE_PROCPS_NG=y
BR2_PACKAGE_PSMISC=y
BR2_PACKAGE_LSOF=y
BR2_PACKAGE_LESS=y
BR2_PACKAGE_TMUX=y

# GNU tar over busybox tar: long-name/xattr edge cases matter to podman
# image handling and backup archives.
BR2_PACKAGE_TAR=y

# ldd and getent - shared-library and NSS debugging on the device.
BR2_PACKAGE_GLIBC_UTILS=y

# clear/tput/tset for scripts and terminals.
BR2_PACKAGE_NCURSES=y
BR2_PACKAGE_NCURSES_TARGET_PROGS=y

# The util-linux binaries (lsblk, losetup, more): the block-device view
# for storage debugging (S15data, automount, RAUC slots). This Buildroot
# has no per-tool split for lsblk, so the binaries set it is; busybox's
# noclobber install keeps whichever arrives first for the overlaps.
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y

# evtest: dump input events straight from /dev/input. Gamepad and button
# bring-up on new boards is the first thing every port needs debugged,
# and there is no busybox equivalent at all.
BR2_PACKAGE_EVTEST=y

# lspci with the ID database: which GPU/wifi actually sits in the device,
# and which kernel driver bound to it - the first question on any real
# x86 or ARM PCIe board.
BR2_PACKAGE_PCIUTILS=y

# lsusb: the same question for USB - controllers, dongles, gamepads.
# busybox's lsusb prints bare IDs with no database and no tree view.
BR2_PACKAGE_USBUTILS=y

# mksquashfs/unsquashfs. The frontend launches .squashfs bundles (see
# es-squashfs), and podman makes the device a build environment for
# itself - this closes the loop so bundles can be authored and inspected
# on-device, not just consumed.
BR2_PACKAGE_SQUASHFS=y

# Archive formats users actually download: 7z (ROM sets and firmware dumps
# ship as .7z; busybox has no extractor at all), Info-ZIP's zip/unzip
# (busybox unzip chokes on zip64 and non-UTF-8 names, and cannot create
# archives), and xar (.pkg and .xar archives - macOS installer packages
# and update payloads). Of the rest, only gzip is busybox; bzip2, xz and
# zstd are named in libs.config for their libraries and install their own
# binaries over the applets, which is what gives the system an xz compressor
# - busybox has the decompress half only.
BR2_PACKAGE_P7ZIP=y
BR2_PACKAGE_ZIP=y
BR2_PACKAGE_UNZIP=y
BR2_PACKAGE_XAR=y

# CUPS: printing support. The client libraries (libcups) are also what
# GTK/Qt print dialogs and PDF-to-printer pipelines link against, so this
# is needed even on builds that never run cupsd itself.
BR2_PACKAGE_CUPS=y

# rsync: the copy that can resume and verify. The install-to-internal and
# backup paths move a rootfs or a save directory between partitions, where
# cp offers no way to continue an interrupted transfer and no check that
# what landed matches what was read. busybox has no rsync applet at all.
BR2_PACKAGE_RSYNC=y
