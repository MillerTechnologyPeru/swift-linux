# Opt-in initramfs (see external/package/swift-initramfs): a board or
# profile includes this fragment to boot through the minimal initramfs -
# root-device wait for slow SD/USB media, PARTUUID resolution via sysfs,
# and a rescue shell instead of a kernel panic when the root never
# appears. The UEFI images' grub.cfg loads /boot/initrd only when the
# slot ships it, so nothing changes for images without this fragment.
#
# This is also the building block for boot chains that structurally
# require an initramfs - Android boot images on the Qualcomm boards and
# Chromebook depthcharge kernels consume the same cpio at bring-up - and
# the future home of dm-verity root setup.
BR2_PACKAGE_SWIFT_INITRAMFS=y
