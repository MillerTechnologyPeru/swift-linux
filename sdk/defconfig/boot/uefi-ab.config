# Boot capability: UEFI with GRUB and A/B update slots.
#
# For boards whose firmware loads an EFI payload: the QEMU/virt boards, the
# Steam Deck, Apple Silicon (via its own loader chain) and the SM8250 handhelds
# that chainload GRUB from the vendor bootloader.
#
# Boards booting some other way must not include this: Chromebooks use
# Depthcharge kernel partitions with cgpt slot attributes, the Rockchip/
# Allwinner/Amlogic handhelds use U-Boot with extlinux, and the Android phones
# are flashed as a boot image - none of them ever load GRUB, and their A/B
# comes from the firmware rather than RAUC.
#
# GRUB reads its slot choice from grubenv, so the builtin module list needs
# load_env and [ (test). Without them GRUB reports "can't find command" and
# silently boots entry 0. The EFI target (x86_64 vs arm64) is set per board.
#
# "erofs" is load-bearing, not optional: grub.cfg does "set root=(hd0,gpt2)"
# and then loads /boot/bzImage FROM THE ROOT SLOT, so GRUB has to be able to
# read the root filesystem - which is EROFS (see image.config). GRUB gained
# an EROFS driver after 2.12, so this needs the 2.14 bump in
# external/patches/buildroot/grub2-2.14; on 2.12 the module does not exist
# and the image does not boot at all. ext2 stays for boards that override
# the rootfs filesystem, fat for the ESP.
BR2_TARGET_GRUB2=y
BR2_TARGET_GRUB2_INSTALL_TOOLS=y
BR2_TARGET_GRUB2_BUILTIN_MODULES_EFI="boot linux erofs ext2 fat squash4 part_msdos part_gpt normal efi_gop loadenv test echo"

# A/B update manager. RAUC 1.15.2 uses the OpenSSL ENGINE API, which Buildroot
# compiles out unless LIBOPENSSL_ENGINES is set (openssl is built "no-engine"
# by default) - without it rauc fails with implicit ENGINE_* declarations.
BR2_PACKAGE_RAUC=y
BR2_PACKAGE_LIBOPENSSL_ENGINES=y
