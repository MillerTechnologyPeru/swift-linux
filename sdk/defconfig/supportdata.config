# Runtime support data every build needs.

# TLS trust store. Without it /etc/ssl/certs is empty and every HTTPS client
# fails to verify a certificate - curl, the Swift runtime's networking, and
# anything fetching over TLS.
BR2_PACKAGE_CA_CERTIFICATES=y

# Timezone database, so the system can express local time rather than UTC only.
BR2_TARGET_TZ_INFO=y

# Device firmware (Wi-Fi, Bluetooth, GPU microcode). The x86_64 board's GPU
# capability also selects this; here it covers every other board, notably
# arm64, which otherwise ships no firmware at all.
BR2_PACKAGE_LINUX_FIRMWARE=y
