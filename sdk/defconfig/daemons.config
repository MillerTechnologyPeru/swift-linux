# System service daemons. No systemd: init is OpenRC (image.config), which
# runs each package's SysV script from /etc/init.d in S??* order for the
# packages that ship no OpenRC service - which is most of these.
#
# Read-only-rootfs notes:
#   - openssh host keys are generated on /data (the writable partition) by a
#     replacement S50sshd; the shipped sshd_config points HostKey there.
#   - ntpd's drift file is redirected to /tmp by the shipped ntp.conf.
#   - avahi and acpid keep their runtime state in /run, so they need nothing.
#
# Three daemons are already here without being named: busybox's default
# config carries the syslogd, klogd and crond applets, and busybox.mk
# installs S01syslogd, S02klogd and S50crond for them unless another
# package claims the job (sysklogd, rsyslog, syslog-ng; none is selected).
# So system logging and cron are running - what logging does NOT have is
# anywhere durable to write, since /var/log is a skeleton symlink to ../tmp
# and /tmp is a tmpfs. Every log is lost at reboot, which is exactly when
# the log matters. Fixing that is about where syslogd points, not about
# adding a daemon.

# NTP time sync (correct clock for TLS / Steam login). S48sntp does a one-shot
# sync at boot; S49ntp runs the ntpd daemon.
BR2_PACKAGE_NTP=y
BR2_PACKAGE_NTP_NTPD=y
BR2_PACKAGE_NTP_SNTP=y
# libcap builds ntpd with --enable-linuxcaps, without which its "-u ntp:ntp"
# is a hard error ("The 'user' option has been disabled") - and that is
# exactly how Buildroot's own init script starts it, so ntpd never came up
# at all. With capabilities it drops privileges as intended.
BR2_PACKAGE_LIBCAP=y

# SSH server (remote shell / scp) plus the client tools.
BR2_PACKAGE_OPENSSH=y
BR2_PACKAGE_OPENSSH_SERVER=y
BR2_PACKAGE_OPENSSH_CLIENT=y

# Avahi (mDNS / zeroconf): .local resolution and local service discovery.
# Uses the system D-Bus, which the image already has.
BR2_PACKAGE_AVAHI=y
BR2_PACKAGE_AVAHI_DAEMON=y
BR2_PACKAGE_NSS_MDNS=y

# acpid: handle power-button/ACPI events (clean shutdown on power button).
BR2_PACKAGE_ACPID=y

# seatd DAEMON (the in-process builtin backend needs root). The daemon ships
# /etc/init.d/S70seatd running `seatd -g video`, giving the non-root user
# (in group video) seat access to DRM/input.
BR2_PACKAGE_SEATD=y
BR2_PACKAGE_SEATD_DAEMON=y

# haveged: entropy at boot, before there is any. getrandom() blocks until the
# kernel pool is initialised, and on an ARM board with no hardware RNG and no
# disk seek times there is very little to initialise it with - so the calls
# that come first are the ones that hang: sshd generating a host key on first
# boot, and the TLS handshake behind ntpd's time sync. A headless board with
# no keyboard or network traffic can sit there for minutes.
#
# haveged rather than rng-tools because it needs no hardware: rngd feeds the
# pool from /dev/hwrng, which is the case this is meant to cover the absence
# of. Where a board does have one the kernel already uses it and haveged
# costs a few hundred KB and an idle thread.
#
# busybox's seedrng carries a seed across reboots, which helps from the
# second boot onward - haveged is what covers the first one, and any boot
# after the /data partition is wiped.
BR2_PACKAGE_HAVEGED=y

# upower: battery state over D-Bus, so a frontend can show a real percentage
# and a charging state instead of parsing /sys/class/power_supply itself -
# where the node names, the units and even which of "capacity" or
# "charge_now" exists differ between the PMICs across these boards. upower
# already knows those quirks. It is also what GTK/Qt battery indicators and
# idle/suspend logic expect to find on the bus.
BR2_PACKAGE_UPOWER=y
