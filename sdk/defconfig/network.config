# Connectivity: D-Bus, BlueZ and ConnMan
#
# All three run under busybox init - Buildroot ships SysV init scripts
# (S40bluetoothd, S45connman) so none of this pulls in systemd.
#
# D-Bus is not optional here: it is BlueZ's and ConnMan's control API
# (org.bluez / net.connman), and both packages select it unconditionally.

# System message bus
BR2_PACKAGE_DBUS=y

# Bluetooth: bluetoothd plus the bluetoothctl client
BR2_PACKAGE_BLUEZ5_UTILS=y
BR2_PACKAGE_BLUEZ5_UTILS_CLIENT=y
BR2_PACKAGE_BLUEZ5_UTILS_MONITOR=y
BR2_PACKAGE_BLUEZ5_UTILS_TOOLS=y
BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_A2DP=y
BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_HEALTH=y

# Network management: connmand plus the connmanctl client.
# WiFi support pulls in wpa_supplicant (with its D-Bus interface) as the
# runtime supplicant; iptables is ConnMan's default firewall backend.
BR2_PACKAGE_CONNMAN=y
BR2_PACKAGE_CONNMAN_IPTABLES=y
BR2_PACKAGE_CONNMAN_ETHERNET=y
BR2_PACKAGE_CONNMAN_WIFI=y
BR2_PACKAGE_CONNMAN_LOOPBACK=y
BR2_PACKAGE_CONNMAN_BLUETOOTH=y
BR2_PACKAGE_CONNMAN_CLIENT=y

# Wireless tooling and regulatory database (needed for real WiFi hardware)
BR2_PACKAGE_IW=y
BR2_PACKAGE_WIRELESS_REGDB=y
