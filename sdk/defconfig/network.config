# Connectivity: D-Bus, BlueZ and NetworkManager
#
# All three run under busybox init - Buildroot ships SysV init scripts
# (S40bluetoothd, S45NetworkManager) so none of this pulls in systemd.
#
# D-Bus is not optional here: it is BlueZ's and NetworkManager's control
# API (org.bluez / org.freedesktop.NetworkManager), and both packages
# select it unconditionally.

# System message bus
BR2_PACKAGE_DBUS=y

# Bluetooth: bluetoothd plus the bluetoothctl client
BR2_PACKAGE_BLUEZ5_UTILS=y
BR2_PACKAGE_BLUEZ5_UTILS_CLIENT=y
BR2_PACKAGE_BLUEZ5_UTILS_MONITOR=y
BR2_PACKAGE_BLUEZ5_UTILS_TOOLS=y
BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_A2DP=y
BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_HEALTH=y

# Network management: NetworkManager on every image, not just the GNOME
# ones. It used to be ConnMan here with NetworkManager substituted under
# GNOME, which meant the desktop and the handheld images disagreed about
# who owns an interface and about where a saved network lives - two
# behaviours, two sets of bugs, and helpers that had to speak both. One
# manager everywhere: the GNOME shell's network indicator and Settings
# panel drive it natively, and nmcli gives the frontends and scripts the
# same interface on boards with no desktop at all.
#
# Connection profiles live in /var/lib/NetworkManager, which S15data binds
# to the data partition so they survive a reboot of the read-only rootfs.
# The image's /etc/resolv.conf already points into tmpfs, which is what
# NetworkManager's resolv.conf handling needs to be able to write.
BR2_PACKAGE_NETWORK_MANAGER=y
BR2_PACKAGE_NETWORK_MANAGER_CLI=y

# WiFi: NetworkManager drives wpa_supplicant over D-Bus (it has no
# built-in supplicant), so both the nl80211 driver and the D-Bus control
# interface have to be in the build.
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_DBUS=y

# Wireless tooling and regulatory database (needed for real WiFi hardware)
BR2_PACKAGE_IW=y
BR2_PACKAGE_WIRELESS_REGDB=y
