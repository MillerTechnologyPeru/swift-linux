# Graphical tools and diagnostics.
#
# Separate from tools.config because these need a GL/Wayland stack: in a
# profile without one Buildroot would silently drop them rather than fail, so
# only profiles that carry the graphics stack (image, app-sdk) compose this.
#
# wayland-info reports the compositor's globals and outputs, glmark2 and
# kmscube exercise GL on the target, and xterm is an X11 client for checking
# that the XWayland path works.
# Mesa's own utilities: eglinfo reports the EGL/GLES renderer in use,
# es2gears_wayland draws through the compositor, and glxinfo/glxgears exercise
# the XWayland path. They need a window-system backend or the package builds
# nothing installable at all - GLX comes from the GPU capability, and the
# Wayland backend needs libdecor for client-side decorations.
BR2_PACKAGE_MESA3D_DEMOS=y
BR2_PACKAGE_LIBDECOR=y

BR2_PACKAGE_WAYLAND_UTILS=y
BR2_PACKAGE_GLMARK2=y
BR2_PACKAGE_KMSCUBE=y
BR2_PACKAGE_XTERM=y
BR2_PACKAGE_MESA3D_DEMOS=y
BR2_PACKAGE_SDL3_TESTS=y

# grim: screenshot utility for the compositor. The image cannot otherwise be
# captured once the display is a GL scanout on the host GPU (qemu screendump
# reports "no surface"), so verification needs a tool inside the guest.
BR2_PACKAGE_GRIM=y