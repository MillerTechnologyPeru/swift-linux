# Playback codecs for the image's media paths: EmulationStation's video
# snaps (VLC), GNOME's Showtime/Decibels (GStreamer), and SDL games.
#
# The workhorse is ffmpeg: it provides the H.264/HEVC/AAC software
# decoders directly, gst1-libav exposes them to every GStreamer player,
# and VLC's avcodec module lights up from the same package. The GStreamer
# plugin sets follow the leading gaming distro's selection, minus the
# encoders (x264/x265/openh264) - this fragment is playback-only, and
# source-built openh264 would not carry Cisco's patent grant anyway.
#
# PATENT NOTE: H.264/HEVC/AAC decoding is patent-encumbered in some
# jurisdictions regardless of implementation. Fine to build for yourself;
# a consideration before distributing images.
#
# Hardware decode: the V4L2 stateless plugin serves the ARM SoCs' video
# engines (rkvdec/hantro on the Rockchip handhelds); x86 Intel comes from
# the gpu/x86-desktop fragment. AMD (VA over radeonsi) is blocked for
# now: this Buildroot builds mesa3d with -Dgallium-va=disabled (circular
# libva dependency) - lifting that needs a buildroot-tree patch like the
# freedreno one, a deliberate follow-up.

# GStreamer itself, its runtime, and V4L2 userspace.
BR2_PACKAGE_GSTREAMER1=y
BR2_PACKAGE_ORC=y
BR2_PACKAGE_LIBV4L=y

# Base, with the GL video sinks for whichever window systems the board
# has (unmet ones drop out in kconfig).
BR2_PACKAGE_GST1_PLUGINS_BASE=y
BR2_PACKAGE_GST1_PLUGINS_BASE_LIB_OPENGL=y
BR2_PACKAGE_GST1_PLUGINS_BASE_LIB_OPENGL_EGL=y
BR2_PACKAGE_GST1_PLUGINS_BASE_LIB_OPENGL_GLES2=y
BR2_PACKAGE_GST1_PLUGINS_BASE_LIB_OPENGL_WAYLAND=y
BR2_PACKAGE_GST1_PLUGINS_BASE_LIB_OPENGL_X11=y

# Good: mp3 (mpg123), flac, vorbis, opus, wavpack - most of an audio
# library - plus classic V4L2.
BR2_PACKAGE_GST1_PLUGINS_GOOD=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_V4L2=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_V4L2_PROBE=y

# Bad: the stateless V4L2 decoders (ARM SoC video engines), the Wayland
# sink, and the VA plugin where libva exists.
BR2_PACKAGE_GST1_PLUGINS_BAD=y
BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_V4L2CODECS=y
BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_WAYLAND=y
BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_VA=y

# Ugly: MPEG-2 decode (DVD-era content).
BR2_PACKAGE_GST1_PLUGINS_UGLY=y
BR2_PACKAGE_GST1_PLUGINS_UGLY_PLUGIN_MPEG2DEC=y

# The decoder engine, and its GStreamer bridge.
BR2_PACKAGE_FFMPEG=y
BR2_PACKAGE_FFMPEG_SWSCALE=y
BR2_PACKAGE_GST1_LIBAV=y

# Deliberately not enabled:
#   - MIDI (fluidsynth + fluid-soundfont): the soundfont alone is ~140 MB
#     of image; boards that want ScummVM/DOS-era MIDI opt in themselves:
#         BR2_PACKAGE_FLUIDSYNTH=y
#         BR2_PACKAGE_FLUID_SOUNDFONT=y
#   - Tracker modules (MOD/S3M/XM): this Buildroot's gst1-plugins-bad
#     carries no modplug/xmp plugin; packaging libopenmpt in external/
#     is the clean path if wanted.
