# Bootable A/B UEFI image (arch-independent part)
#
# Produces a GPT disk.img (ESP + root-a + root-b + data) that boots via
# UEFI -> GRUB -> read-only ext4 rootfs, auto-logs a non-root user into a
# sway session, and keeps state on a separate data partition. RAUC manages
# the A/B slots. No initramfs (monolithic kernel, drivers built in).
#
# The arch-specific pieces (kernel defconfig, GRUB EFI target, serial port)
# live in sdk/board/<arch>/board.config. Two placeholders are rewritten by
# generate-config.sh: @SWIFT_LINUX@ -> this repo, @BOARD@ -> sdk/board/<arch>.

# Linux kernel (installed into the rootfs /boot for GRUB to load per slot).
# The defconfig is arch-specific and set in board.config.
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_LATEST_VERSION=y
BR2_LINUX_KERNEL_INSTALL_TARGET=y

# Read-only ext4 root slot image
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="2G"
BR2_TARGET_ROOTFS_EXT2_LABEL="rootfs"

# The boot mechanism is a board capability: boards include the fragment that
# matches their firmware (sdk/defconfig/boot/), since a Chromebook, an Android
# phone and a UEFI machine share none of it.

# ext4 tooling for formatting the data partition on first boot
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_E2FSPROGS_RESIZE2FS=y

# Image assembly
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_MTOOLS=y

# Console / login (the serial getty port is arch-specific: see board.config)
BR2_TARGET_GENERIC_ROOT_PASSWD="root"
# A UTF-8 locale. foot (and Wayland terminals generally) refuse to start
# under the default "C" locale: "'C' is not a UTF-8 locale, and failed to
# find a fallback". The session exports LANG to match (see sway-session).
BR2_GENERATE_LOCALE="en_US.UTF-8"
# No BR2_SYSTEM_DHCP: it writes an /etc/network/interfaces entry that runs
# udhcpc on the interface, which fights ConnMan for the same device.
# ConnMan (see network.config) manages ethernet and wifi instead.

# Keep the rootfs read-only (A/B slots are immutable; state lives on /data).
# Without this Buildroot adds "mount -o remount,rw /" to inittab's sysinit,
# which silently defeats the ro mount from the kernel command line.
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set

# Default non-root user + session (shared) + board-specific overlay/scripts
BR2_ROOTFS_USERS_TABLES="@SWIFT_LINUX@/sdk/board/common/users.txt"
BR2_ROOTFS_OVERLAY="@SWIFT_LINUX@/sdk/board/common/rootfs-overlay @BOARD@/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="@SWIFT_LINUX@/sdk/board/common/post-build.sh @SWIFT_LINUX@/sdk/board/common/post-build-lib32.sh @BOARD@/post-build.sh"

# Wayland compositor: sway (a wlroots-based i3-style compositor), from this repo's
# BR2_EXTERNAL. Buildroot's own sway package hardcodes libsystemd as its
# sd-bus provider and so depends on systemd; swaywm builds the same sources
# against basu instead. Terminal is foot, sway's default.
BR2_PACKAGE_SWAYWM=y
BR2_PACKAGE_SWAYWM_SWAYBAR=y
BR2_PACKAGE_FOOT=y
# fontconfig comes from applibs; the image chooses the font it ships.
BR2_PACKAGE_DEJAVU=y

# XWayland, so X11 apps (Steam and others) run under the sway session.
# XORG7 pulls the X.org stack (libxcb, xcb-util-wm, xlib_libxshmfence) that
# XWayland needs; WLROOTS_XWAYLAND makes the swaywm package build sway with
# X11 support.
BR2_PACKAGE_XWAYLAND=y
BR2_PACKAGE_WLROOTS_XWAYLAND=y
# XWayland accelerates X11 clients with glamor, which Buildroot enables only
# when libepoxy is present (applibs provides it). Without libepoxy XWayland
# still advertises GLX, since it has libGL, but offers no accelerated
# fbconfigs, and X11 GL clients fail with "couldn't find RGB GLX visual or
# fbconfig" - so applibs must stay in this profile.

# The X11 client libraries those apps link come from applibs.

# OpenGL: wlroots (and therefore sway) requires EGL, GLES and GBM. virgl is the
# baseline every board can use (it is what the QEMU/virt boards run on); boards
# with real GPUs add their own capability on top - x86_64 pulls in the full
# desktop stack, the Adreno/Mali handhelds their vendor drivers.
include sdk/defconfig/gpu/virgl.config
