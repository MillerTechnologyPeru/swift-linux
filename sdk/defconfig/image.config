# Bootable A/B UEFI image (QEMU x86_64)
#
# Produces a GPT disk.img (ESP + root-a + root-b + data) that boots via
# OVMF -> GRUB -> read-only ext4 rootfs, auto-logs a non-root user into a
# Weston session, and keeps state on a separate data partition. RAUC manages
# the A/B slots. No initramfs (monolithic kernel, drivers built in).
#
# @SWIFT_LINUX@ paths are rewritten to this repo's absolute path by
# generate-config.sh. This fragment targets x86_64.

# Linux kernel (installed into the rootfs /boot for GRUB to load per slot)
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_LATEST_VERSION=y
BR2_LINUX_KERNEL_USE_DEFCONFIG=y
BR2_LINUX_KERNEL_DEFCONFIG="x86_64"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="@SWIFT_LINUX@/sdk/board/x86_64/linux.fragment"
BR2_LINUX_KERNEL_INSTALL_TARGET=y

# Read-only ext4 root slot image
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="2G"
BR2_TARGET_ROOTFS_EXT2_LABEL="rootfs"

# Bootloader: GRUB2 (x86_64 UEFI), with grub-editenv on target for RAUC.
# The builtin module list adds "loadenv" and "test" to Buildroot's default:
# the A/B logic in grub.cfg needs load_env (to read grubenv) and [ (test).
# Without them GRUB reports "can't find command" and silently boots entry 0.
BR2_TARGET_GRUB2=y
BR2_TARGET_GRUB2_X86_64_EFI=y
BR2_TARGET_GRUB2_INSTALL_TOOLS=y
BR2_TARGET_GRUB2_BUILTIN_MODULES_EFI="boot linux ext2 fat squash4 part_msdos part_gpt normal efi_gop loadenv test echo"

# A/B update manager
BR2_PACKAGE_RAUC=y

# ext4 tooling for formatting the data partition on first boot
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_E2FSPROGS_RESIZE2FS=y

# Image assembly
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_MTOOLS=y

# Console / login
BR2_TARGET_GENERIC_GETTY_PORT="ttyS0"
BR2_TARGET_GENERIC_ROOT_PASSWD="root"
# No BR2_SYSTEM_DHCP: it writes an /etc/network/interfaces entry that runs
# udhcpc on the interface, which fights ConnMan for the same device.
# ConnMan (see network.config) manages ethernet and wifi instead.

# Keep the rootfs read-only (A/B slots are immutable; state lives on /data).
# Without this Buildroot adds "mount -o remount,rw /" to inittab's sysinit,
# which silently defeats the ro mount from the kernel command line.
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set

# Default non-root user + session (shared) + board-specific overlay/scripts
BR2_ROOTFS_USERS_TABLES="@SWIFT_LINUX@/sdk/board/common/users.txt"
BR2_ROOTFS_OVERLAY="@SWIFT_LINUX@/sdk/board/common/rootfs-overlay @SWIFT_LINUX@/sdk/board/x86_64/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="@SWIFT_LINUX@/sdk/board/common/post-build.sh @SWIFT_LINUX@/sdk/board/x86_64/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="@SWIFT_LINUX@/sdk/board/x86_64/post-image.sh"

# Wayland compositor + terminal font
BR2_PACKAGE_WESTON=y
BR2_PACKAGE_WESTON_DEFAULT_DRM=y
BR2_PACKAGE_FONTCONFIG=y
BR2_PACKAGE_DEJAVU=y

# seatd DAEMON (weston only auto-selects the in-process builtin backend, which
# needs root). The daemon ships /etc/init.d/S70seatd running `seatd -g video`,
# giving the non-root user (in group video) seat access to DRM/input.
BR2_PACKAGE_SEATD=y
BR2_PACKAGE_SEATD_DAEMON=y
