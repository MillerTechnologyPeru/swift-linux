# Bootable A/B UEFI image (arch-independent part)
#
# Produces a GPT disk.img (ESP + root-a + root-b + data) that boots via
# UEFI -> GRUB -> read-only EROFS rootfs, auto-logs a non-root user into a
# sway session, and keeps state on a separate data partition. RAUC manages
# the A/B slots. No initramfs (monolithic kernel, drivers built in).
#
# The arch-specific pieces (kernel defconfig, GRUB EFI target, serial port)
# live in sdk/board/<arch>/board.config. Two placeholders are rewritten by
# generate-config.sh: @SWIFT_LINUX@ -> this repo, @BOARD@ -> sdk/board/<arch>.

# Linux kernel (installed into the rootfs /boot for GRUB to load per slot).
# The defconfig is arch-specific and set in board.config.
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_LATEST_VERSION=y
BR2_LINUX_KERNEL_INSTALL_TARGET=y

# Device firmware. The bare option installs NOTHING - Buildroot's package
# only copies what suboptions select - so a baseline is spelled out here:
# the common USB wifi/BT dongles and USB-C dock ethernet, a few MB that
# make "plug in an adapter" work on every board. GPU microcode and
# board-soldered radios are the GPU capability's and board fragment's
# business. An image concern, not a supportdata one: the sdk profiles are
# sysroots and nothing cross-compiles against firmware blobs.
BR2_PACKAGE_LINUX_FIRMWARE=y
# Atheros ath9k_htc dongles (TL-WN722N and friends), everywhere.
BR2_PACKAGE_LINUX_FIRMWARE_ATHEROS_7010=y
BR2_PACKAGE_LINUX_FIRMWARE_ATHEROS_9271=y
# MediaTek/Ralink USB: mt7601u and mt76x2 cover most cheap dongles.
BR2_PACKAGE_LINUX_FIRMWARE_MEDIATEK_MT7601U=y
BR2_PACKAGE_LINUX_FIRMWARE_MEDIATEK_MT76X2E=y
# Realtek wifi (rtl8723/8821/8822 families, legacy and rtw88/89 stacks)
# with their Bluetooth halves - the radios in most retro handhelds too.
BR2_PACKAGE_LINUX_FIRMWARE_RTL_87XX=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_87XX_BT=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_88XX=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_88XX_BT=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_RTW88=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_RTW89=y
# r8152: USB-C dock and adapter ethernet.
BR2_PACKAGE_LINUX_FIRMWARE_RTL_815X=y

# Read-only EROFS root slot image.
#
# EROFS instead of ext4: the rootfs is read-only for the life of the slot
# (see BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW below), which is exactly what
# EROFS is for - a compressed, mount-in-place filesystem with no journal
# and no free-space bookkeeping to carry. It shrinks the image (LZ4HC by
# default: fast to decompress, which matters more than ratio for boot
# time) and removes an entire class of "did the ext4 metadata survive a
# power cut mid-write" concern a read-only slot never needed.
#
# Unlike the ext2/ext4 image this replaces, the output size now reflects
# the compressed content, not a fixed number - so slot CAPACITY (the
# partition size RAUC updates into) has to be set explicitly instead of
# implicitly. That lives in genimage.cfg / post-image.sh per board, not
# here, because it is a partition-table concern, not a filesystem one.
BR2_TARGET_ROOTFS_EROFS=y
BR2_TARGET_ROOTFS_EROFS_LZ4HC=y

# Kernel support for the root (EROFS) and data (ext4/f2fs) filesystems -
# see external/package/image-storage.
BR2_PACKAGE_IMAGE_STORAGE=y

# Container runtime: rootless-capable podman with crun. Lets the device run
# containerized services and gives it a build environment for itself. The
# Buildroot package fixes the kernel configuration up itself (namespaces,
# cgroups, overlayfs, seccomp), selects its runtime pieces (conmon, netavark,
# cgroupfs-v2 mount for a non-systemd init) and the CA certificates pulls
# from registries need. This is an image concern, not a tools one: the sdk
# profiles are sysroots and never run containers.
BR2_PACKAGE_PODMAN=y
BR2_PACKAGE_CRUN=y
# passt/pasta: user-mode networking, which is what makes rootless containers
# able to reach the network. The default user's subuid/subgid ranges come from
# the shared overlay.
BR2_PACKAGE_PASST=y

# The boot mechanism is a board capability: boards include the fragment that
# matches their firmware (sdk/defconfig/boot/), since a Chromebook, an Android
# phone and a UEFI machine share none of it.

# Data partition tooling: mkfs/fsck/resize for BOTH filesystems S15data and
# the installer can format the data partition as (ext4 default, f2fs
# optional - see S15data and system-install), and parted to extend the
# partition itself over whatever space the medium has beyond the image.
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_E2FSPROGS_RESIZE2FS=y
BR2_PACKAGE_F2FS_TOOLS=y
BR2_PACKAGE_PARTED=y


# Playback codecs (ffmpeg + the GStreamer plugin sets); see the fragment
# for the patent notes and the hardware-decode status per platform.
include sdk/defconfig/media-codecs.config

# Removable media: automount to /media/<label> (this repo's
# media-automount: udev rule + helper + the FAT/exFAT/NTFS kernel
# drivers). The GNOME frontend layers the desktop volume-monitor tier
# on top of the same udisks machinery.
BR2_PACKAGE_MEDIA_AUTOMOUNT=y
# exFAT userspace tools (mkfs/fsck); the kernel driver comes from the
# media-automount fixups.
BR2_PACKAGE_EXFATPROGS=y

# Image assembly
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_MTOOLS=y

# Console / login (the serial getty port is arch-specific: see board.config)
BR2_TARGET_GENERIC_ROOT_PASSWD="root"
# UTF-8 locales. foot (and Wayland terminals generally) refuse to start
# under the default "C" locale, and the frontends ship translations these
# make selectable: English (US/GB), Spanish (Spain/US), French, German,
# Italian, Russian. The plain POSIX/C locale needs no generating - glibc
# carries it built in. The session exports LANG=en_US.UTF-8 by default
# (see sway-session).
BR2_GENERATE_LOCALE="en_US.UTF-8 en_GB.UTF-8 es_ES.UTF-8 es_US.UTF-8 fr_FR.UTF-8 de_DE.UTF-8 it_IT.UTF-8 ru_RU.UTF-8"
# No BR2_SYSTEM_DHCP: it writes an /etc/network/interfaces entry that runs
# udhcpc on the interface, which fights NetworkManager for the same device.
# NetworkManager (see network.config) manages ethernet and wifi instead.

# Init: OpenRC (not systemd - the image avoids it throughout, see swaywm/basu
# below). OpenRC runs on top of pid 1 rather than replacing it, so busybox init
# stays pid 1 and /etc/inittab hands boot over to it (see the overlay's inittab).
#
# Two knock-on effects Buildroot handles for us:
#   - eudev stops installing S10udevd (package/eudev/eudev.mk) and udev is
#     started from the sysinit runlevel by udev-gentoo-scripts, which
#     eudev's Config.in selects automatically under OpenRC. That still
#     orders udev before S15data, which needs /dev/disk/by-partuuid.
#   - packages without an OpenRC service (openssh, NetworkManager, bluez, dbus)
#     fall back to their SysV script (package/pkg-generic.mk), which the
#     openrc package's "sysv-rcs" service runs from the default runlevel in
#     /etc/init.d/S??* order - so this repo's S07/S15/S50 keep working.
BR2_INIT_OPENRC=y

# Keep the rootfs read-only (A/B slots are immutable; state lives on /data).
# Without this Buildroot adds "mount -o remount,rw /" to inittab's sysinit,
# which silently defeats the ro mount from the kernel command line.
# It also makes skeleton-init-openrc leave the "/dev/root / erofs ro" line in
# fstab uncommented, which is how OpenRC knows not to remount / rw itself.
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set

# Default non-root user + session (shared) + board-specific overlay/scripts.
#
# The order of the post-build scripts matters at the end: post-build-ldcache.sh
# runs last because it turns /etc/ld.so.conf.d into the /etc/ld.so.cache the
# loader actually reads, so it has to see every .conf the scripts before it
# wrote - lib32.conf among them.
BR2_ROOTFS_USERS_TABLES="@SWIFT_LINUX@/sdk/board/common/users.txt"
BR2_ROOTFS_OVERLAY="@SWIFT_LINUX@/sdk/board/common/rootfs-overlay @BOARD@/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="@SWIFT_LINUX@/sdk/board/common/post-build.sh @SWIFT_LINUX@/sdk/board/common/post-build-lib32.sh @BOARD@/post-build.sh @SWIFT_LINUX@/sdk/board/common/post-build-ldcache.sh"

# Frontend: the user-facing shell of the image. EmulationStation on sway is
# the default; a board picks another by including a different
# sdk/defconfig/frontend/*.config from its board.config - board fragments
# are emitted after this file, and the alternatives negate the default's
# packages, so the last include wins (see sdk/defconfig/frontend/README.md).
include sdk/defconfig/frontend/emulationstation.config

# OpenGL: wlroots (and therefore sway) requires EGL, GLES and GBM. virgl is the
# baseline every board can use (it is what the QEMU/virt boards run on); boards
# with real GPUs add their own capability on top - x86_64 pulls in the full
# desktop stack, the Adreno/Mali handhelds their vendor drivers.
include sdk/defconfig/gpu/virgl.config
