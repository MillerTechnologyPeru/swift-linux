# Application managers.
#
# How software gets ONTO an image whose rootfs is read-only: everything
# here installs into the user's home or /var/lib/flatpak, both of which
# live on the data partition. Included by the desktop frontends
# (frontend/gnome.config, frontend/xfce.config) - a game-frontend
# handheld gets its content through EmulationStation and PortMaster
# instead.
#
# Not a store monoculture, deliberately:
#
#   flatpak + GNOME Software   general applications, from Flathub et al.
#   lutris                     games from installer scripts, GOG, itch.io,
#                              plus the Wine/emulator plumbing they need
#   heroic                     GOG / Epic / Amazon libraries (x86_64 only:
#                              upstream publishes no Linux arm64 build,
#                              and it is the tree's one prebuilt package -
#                              Electron is not buildable here)
#
# /var/lib/flatpak is bind-mounted from the data partition by S15data, so
# system-wide installations survive both reboots and A/B updates.

BR2_PACKAGE_FLATPAK=y
BR2_PACKAGE_GNOME_SOFTWARE=y
BR2_PACKAGE_LUTRIS=y
BR2_PACKAGE_HEROIC=y

# PortMaster belongs in this category too - it is the app manager for the
# native game ports. The frontend fragment declares it as well (handheld
# images do not include this fragment); here it reaches the ARM desktop
# images, where the frontend they build (see PR #51) gives it its Tools
# entry. Its Config.in gates it to ARM with EmulationStation, so on
# x86_64 desktops the line is inert.
BR2_PACKAGE_PORTMASTER=y
