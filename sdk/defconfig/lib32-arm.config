# 32-bit ARM (armv7) companion additions.
#
# box86 runs 32-bit x86 Linux binaries on 32-bit ARM. On the arm64 image its
# armv7 binary runs through aarch32 compat, so it is built as part of the
# armv7 lib32 userland and merged into the arm64 image by post-build-lib32.sh.
BR2_PACKAGE_BOX86=y

# GPU drivers for the companion. A 32-bit process cannot load the 64-bit
# image's DRI drivers or Vulkan ICDs, so without these a 32-bit game gets
# software rendering at best.
#
# Unlike the x86 side there is no single "desktop" answer here: the arm64
# boards use different GPUs, and which one an image has is a board choice
# (sdk/defconfig/gpu/). The companion therefore builds the union of what
# the ARM boards in this tree use - panfrost (Mali) and freedreno (Adreno)
# - plus virgl for the QEMU/virt boards and llvmpipe as the fallback that
# works anywhere. Drivers for absent hardware cost disk in /usr/lib32 and
# nothing else; they are simply never opened.
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_LLVM=y
BR2_PACKAGE_MESA3D_GBM=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_PANFROST=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_FREEDRENO=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_VIRGL=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_LLVMPIPE=y

# Vulkan, matching the same hardware.
BR2_PACKAGE_VULKAN_LOADER=y
BR2_PACKAGE_MESA3D_VULKAN_DRIVER_PANFROST=y
BR2_PACKAGE_MESA3D_VULKAN_DRIVER_FREEDRENO=y
BR2_PACKAGE_MESA3D_VULKAN_DRIVER_SWRAST=y
BR2_PACKAGE_MESA3D_VULKAN_DRIVER_VIRTIO=y
