# Capability: cellular modem on a Qualcomm SoC, reached over QRTR.
#
# A board capability rather than a profile fragment, like gpu/ and boot/:
# only the SoC families that carry an on-die modem include it, because every
# other board this repo builds has no modem at all and this pulls in libqmi,
# libqrtr-glib and their D-Bus services.
#
# QRTR, not MBIM. On these SoCs the modem is not a USB device but a remote
# processor on the die, reached over Qualcomm's IPC Router (QRTR) rather than
# a CDC interface. QMI is the protocol spoken over it, and selecting QRTR
# support pulls libqrtr-glib in and turns QMI on with it. MBIM is for the
# standards-compliant USB dongles these are not.
#
# NetworkManager (network.config) drives ModemManager over D-Bus, so nothing
# further is needed to make a connection once the modem is recognised.
#
# On the handheld families this is included from, most retail models have no
# modem fitted at all - the SoC supports one, the board may not populate it.
# ModemManager on such a device starts, finds no hardware and idles, which
# costs a D-Bus service and some build time and breaks nothing. It is
# included at SoC level so that the cellular variants which do exist are
# covered without maintaining a per-model list.
BR2_PACKAGE_MODEM_MANAGER=y
BR2_PACKAGE_MODEM_MANAGER_LIBQRTR=y

# pppd for the fallback path. A QMI modem normally hands over a raw IP
# interface that NetworkManager configures directly, with no PPP anywhere,
# but a modem that only offers a serial AT interface still needs a PPP
# session and ModemManager expects to find pppd when it takes that route.
BR2_PACKAGE_PPPD=y
