# GPU capability: AMD Radeon (radeonsi OpenGL + RADV Vulkan).
#
# For discrete and APU Radeon parts (GCN/RDNA). Unlike the virgl and
# freedreno/panfrost capabilities, radeonsi *requires* LLVM for shader
# compilation - that is a large build, which is why this is a separate
# capability rather than something the generic image carries.
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_LLVM=y
BR2_PACKAGE_MESA3D_GBM=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_MESA3D_OPENGL_GLX=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_RADEONSI=y
# RADV: the Vulkan driver Proton/DXVK titles need.
BR2_PACKAGE_MESA3D_VULKAN_DRIVER_AMD=y
BR2_PACKAGE_VULKAN_LOADER=y
BR2_PACKAGE_VULKAN_TOOLS=y
# Runtime shader compilation for Vulkan consumers (RetroArch's vulkan
# video driver, GL-over-Vulkan translation): glslang via shaderc, plus
# the SPIR-V toolkit.
BR2_PACKAGE_SHADERC=y
BR2_PACKAGE_SPIRV_TOOLS=y
# GPU microcode.
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_AMDGPU=y
