# GPU capability: virtio-gpu / virgl OpenGL stack (QEMU and virtualized hosts).
#
# wlroots (and therefore sway) requires EGL, GLES and GBM. virgl forwards
# rendering to the host through virtio-gpu, avoiding LLVM/llvmpipe; run QEMU
# with "-device virtio-gpu-gl-pci -display egl-headless".
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_GBM=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_VIRGL=y

# Mesa demos/utilities for checking the GL stack on target: eglinfo reports the
# EGL/GLES renderer in use, and es2gears_wayland draws through the compositor.
BR2_PACKAGE_MESA3D_DEMOS=y
