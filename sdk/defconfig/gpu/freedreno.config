# GPU capability: Adreno (freedreno) OpenGL/GLES + Vulkan (turnip).
#
# For Qualcomm Adreno GPUs. No LLVM needed. The Vulkan driver requires the
# mesa3d change carried in external/patches/buildroot (stock Buildroot has
# freedreno GL but no freedreno Vulkan).
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_GBM=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_FREEDRENO=y
BR2_PACKAGE_MESA3D_VULKAN_DRIVER_FREEDRENO=y
BR2_PACKAGE_VULKAN_LOADER=y
# vulkaninfo, to confirm the turnip ICD loads on the device.
BR2_PACKAGE_VULKAN_TOOLS=y
# Runtime shader compilation for Vulkan consumers (RetroArch's vulkan
# video driver, GL-over-Vulkan translation): glslang via shaderc, plus
# the SPIR-V toolkit.
BR2_PACKAGE_SHADERC=y
BR2_PACKAGE_SPIRV_TOOLS=y

# Adreno GPU microcode and Venus video-decoder firmware: the drivers
# probe but render nothing without them, the same way amdgpu/i915 need
# theirs on x86. Mirrors what the x86 desktop capability does for its
# GPUs.
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_QCOM_ADRENO=y
BR2_PACKAGE_LINUX_FIRMWARE_QCOM_VENUS=y
