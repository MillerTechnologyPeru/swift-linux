# GPU capability: every GPU stack an x86_64 PC might need.
#
# A generic PC image cannot know its GPU in advance, so it carries all of
# them and lets Mesa pick at runtime from the kernel's DRM device:
#
#   radeonsi  AMD GCN/RDNA        iris     Intel Gen8+ (Broadwell and later)
#   crocus    Intel Gen4-7        r600/r300  older AMD (TeraScale/pre-TeraScale)
#   nouveau   NVIDIA (open)       i915     Intel Gen3 (i915/i945)
#   virgl     virtio-gpu (VMs)    svga     VMware SVGA3D
#   llvmpipe  software fallback, so the image still boots to a desktop on
#             hardware with no supported GPU, or with no GPU firmware
#
# This pulls in LLVM (radeonsi and llvmpipe both require it), which is a large
# build - that is the trade for an image that boots on arbitrary hardware.
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_LLVM=y
BR2_PACKAGE_MESA3D_GBM=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_MESA3D_OPENGL_GLX=y

# Gallium (OpenGL/GLES)
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_RADEONSI=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_R600=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_R300=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_IRIS=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_CROCUS=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_I915=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_NOUVEAU=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_VIRGL=y
# VMware SVGA3D, so the image also accelerates under VMware/ESXi.
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_SVGA=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_LLVMPIPE=y

# Vulkan: RADV (AMD), ANV (Intel), lavapipe (software) and the virtio driver.
BR2_PACKAGE_MESA3D_VULKAN_DRIVER_AMD=y
BR2_PACKAGE_MESA3D_VULKAN_DRIVER_INTEL=y
BR2_PACKAGE_MESA3D_VULKAN_DRIVER_SWRAST=y
BR2_PACKAGE_MESA3D_VULKAN_DRIVER_VIRTIO=y
BR2_PACKAGE_VULKAN_LOADER=y
BR2_PACKAGE_VULKAN_TOOLS=y


# GPU microcode: amdgpu and i915 need firmware before the driver will bind.
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_AMDGPU=y
BR2_PACKAGE_LINUX_FIRMWARE_I915=y
BR2_PACKAGE_LINUX_FIRMWARE_AMD_UCODE=y
BR2_PACKAGE_LINUX_FIRMWARE_INTEL_UCODE=y
