# GPU capability: Arm Mali (panfrost) OpenGL ES + the panvk Vulkan driver.
#
# For Mali Midgard/Bifrost/Valhall GPUs (G31/G52/G610, ...) used by most
# Rockchip and Allwinner handhelds. No LLVM needed. panvk (Vulkan) is still
# experimental upstream; GL/GLES is the reliable path.
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_GBM=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_PANFROST=y
BR2_PACKAGE_MESA3D_VULKAN_DRIVER_PANFROST=y
BR2_PACKAGE_VULKAN_LOADER=y
BR2_PACKAGE_VULKAN_TOOLS=y
# Runtime shader compilation for Vulkan consumers (RetroArch's vulkan
# video driver, GL-over-Vulkan translation): glslang via shaderc, plus
# the SPIR-V toolkit.
BR2_PACKAGE_SHADERC=y
BR2_PACKAGE_SPIRV_TOOLS=y
