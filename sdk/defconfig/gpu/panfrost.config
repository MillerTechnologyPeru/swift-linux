# GPU capability: Arm Mali (panfrost) OpenGL ES + the panvk Vulkan driver.
#
# For Mali Midgard/Bifrost/Valhall GPUs (G31/G52/G610, ...) used by most
# Rockchip and Allwinner handhelds. panvk (Vulkan) is still experimental
# upstream; GL/GLES is the reliable path.
BR2_PACKAGE_MESA3D=y

# LLVM is not optional here, however much it costs. Both panfrost drivers
# "depends on BR2_PACKAGE_MESA3D_LLVM" since mesa grew its precompiled-shader
# compiler (-Dmesa-clc=system -Dprecomp-compiler=system), and an unmet
# dependency does not fail the build - Kconfig just drops the symbol, leaving
# an image whose only GL is virgl and llvmpipe. So a Mali board silently lost
# hardware acceleration entirely. Selecting it pulls llvm, clang and libclc
# onto the target (mesa's own NEEDS_PRECOMP_COMPILER selects the OpenCL path),
# which is a large part of these images and hours of the build.
BR2_PACKAGE_MESA3D_LLVM=y
BR2_PACKAGE_MESA3D_GBM=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_PANFROST=y
BR2_PACKAGE_MESA3D_VULKAN_DRIVER_PANFROST=y
BR2_PACKAGE_VULKAN_LOADER=y
BR2_PACKAGE_VULKAN_TOOLS=y
# Runtime shader compilation for Vulkan consumers (RetroArch's vulkan
# video driver, GL-over-Vulkan translation): glslang via shaderc, plus
# the SPIR-V toolkit.
BR2_PACKAGE_SHADERC=y
BR2_PACKAGE_SPIRV_TOOLS=y
