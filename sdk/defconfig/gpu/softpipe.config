# GPU capability: software GL with no LLVM, for targets that have neither a
# GPU driver nor an llvmpipe build (32-bit PowerPC under QEMU).
#
# wlroots needs EGL, GLES and GBM to link, so Mesa is still built, but
# nothing is meant to draw through it: sway composites with the pixman
# renderer (the board sets WLR_RENDERER=pixman) and foot renders on the CPU
# into shared memory. softpipe is only there so EGL has a driver to load if
# a client asks for one. It needs no LLVM, unlike llvmpipe, which would add
# a cross LLVM build for a renderer nothing uses.
#
# Include this from a board.config: it negates what image.config and
# applibs.config turn on for the QEMU boards. virgl and venus need the
# host's virtio-gpu GL path, which these targets do not use.
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_GBM=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_SOFTPIPE=y
# BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_VIRGL is not set
# BR2_PACKAGE_MESA3D_VULKAN_DRIVER_VIRTIO is not set
