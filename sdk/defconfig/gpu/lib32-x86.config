# GPU capability for the i386 companion userland.
#
# The 32-bit companion exists so 32-bit games find the libraries their
# 64-bit counterparts have (see the lib32 profile in generate-config.sh).
# Graphics is the part that most obviously breaks without it: a 32-bit
# process cannot load a 64-bit DRI driver or Vulkan ICD, so it silently
# falls back to software rendering - or fails outright.
#
# This mirrors the GL and Vulkan driver selection of gpu/x86-desktop.config,
# the capability the paired x86_64 image uses, and nothing else from it:
# firmware and the VA-API driver are image-wide data the 64-bit side
# already installs, and installing them twice would only add size.
#
# The Vulkan ICD manifests Mesa writes here carry absolute /usr/lib paths,
# which are wrong once these libraries are merged into /usr/lib32; the
# merge script rewrites them into 32-bit variants (see post-build-lib32.sh).

BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_LLVM=y
BR2_PACKAGE_MESA3D_GBM=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_MESA3D_OPENGL_GLX=y

# Gallium drivers: the same set the 64-bit desktop capability builds.
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_RADEONSI=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_R600=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_R300=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_IRIS=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_CROCUS=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_I915=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_NOUVEAU=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_VIRGL=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_SVGA=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_LLVMPIPE=y

# Vulkan: the loader plus the drivers a 32-bit title might ask for. INTEL
# is included here although x86-desktop.config does not name it - the
# 64-bit image gets it anyway (an intel_icd manifest is in the built
# image), and a 32-bit Vulkan game on Intel graphics is exactly the case
# this fragment exists for.
BR2_PACKAGE_VULKAN_LOADER=y
BR2_PACKAGE_MESA3D_VULKAN_DRIVER_AMD=y
BR2_PACKAGE_MESA3D_VULKAN_DRIVER_INTEL=y
BR2_PACKAGE_MESA3D_VULKAN_DRIVER_SWRAST=y
BR2_PACKAGE_MESA3D_VULKAN_DRIVER_VIRTIO=y
