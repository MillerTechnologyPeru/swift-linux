# Frontend: EmulationStation on a sway session (the default; see
# frontend/README.md for how a board picks a different frontend).
#
# Suits every board with working OpenGL(ES): the compositor needs EGL/GBM,
# and the frontend renders through SDL2's Wayland driver. Boards without a
# GL-capable GPU use frontend/gmenu2x.config instead.

# Wayland compositor: sway (a wlroots-based i3-style compositor), from this repo's
# BR2_EXTERNAL. Buildroot's own sway package hardcodes libsystemd as its
# sd-bus provider and so depends on systemd; swaywm builds the same sources
# against basu instead. Terminal is foot, sway's default.
BR2_PACKAGE_SWAYWM=y
BR2_PACKAGE_SWAYWM_SWAYBAR=y
BR2_PACKAGE_FOOT=y
# fontconfig comes from applibs; the image chooses the fonts it ships.
BR2_PACKAGE_DEJAVU=y
# Liberation: metric-compatible substitutes for Arial, Times New Roman and
# Courier New (the mono/sans/serif sub-options default on). fontconfig
# falls back to these when games and web content ask for the Microsoft
# fonts, so their layout survives instead of reflowing onto DejaVu.
BR2_PACKAGE_LIBERATION=y

# XWayland, so X11 apps (Steam and others) run under the sway session.
# XORG7 pulls the X.org stack (libxcb, xcb-util-wm, xlib_libxshmfence) that
# XWayland needs; WLROOTS_XWAYLAND makes the swaywm package build sway with
# X11 support.
BR2_PACKAGE_XWAYLAND=y
BR2_PACKAGE_WLROOTS_XWAYLAND=y
# XWayland accelerates X11 clients with glamor, which Buildroot enables only
# when libepoxy is present (applibs provides it). Without libepoxy XWayland
# still advertises GLX, since it has libGL, but offers no accelerated
# fbconfigs, and X11 GL clients fail with "couldn't find RGB GLX visual or
# fbconfig" - so applibs must stay in this profile.
# X core Type1 fonts for the legacy X11 apps XWayland hosts: pre-fontconfig
# toolkits request fonts through the core protocol (XLFD names), which the
# TTF fonts above never satisfy. XWayland's built-ins only cover "fixed"
# and "cursor"; these two add the scalable Courier/Helvetica/Times set old
# games and Motif/Xt apps expect.
BR2_PACKAGE_XFONT_FONT_BITSTREAM_TYPE1=y
BR2_PACKAGE_XFONT_FONT_XFREE86_TYPE1=y

# The X11 client libraries those apps link come from applibs.

# Game frontend: EmulationStation, started by the sway session in place of
# the terminal when installed. An image concern like podman: the sdk
# profiles are sysroots and never run it.
include sdk/defconfig/emulationstation.config
