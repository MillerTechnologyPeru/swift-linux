# Frontend: GNOME (Wayland, mutter/gnome-shell), for desktop x86_64/arm64
# machines - the systemd-free arrangement Gentoo and Alpine ship: elogind
# provides org.freedesktop.login1 (D-Bus activated), gnome-session runs
# its builtin startup, and the session is registered through pam_elogind
# at login (see the overlay's /etc/pam.d/login).
#
# Include this AFTER the image profile (i.e. from a board.config): the
# negations below unwind the default EmulationStation/sway frontend, which
# works because board fragments are emitted last and later assignments win.
#
# STATUS: all five stages packaged and kconfig-validated; nothing compiled
# or booted yet (see frontend/README.md). mozjs is the expected trouble
# spot on first build.

# No sway session and no game-frontend stack. Xwayland STAYS: mutter runs
# it for X11 apps.
# BR2_PACKAGE_SWAYWM is not set
# BR2_PACKAGE_SWAYWM_SWAYBAR is not set
# BR2_PACKAGE_FOOT is not set
# BR2_PACKAGE_EMULATIONSTATION is not set
# BR2_PACKAGE_RETROARCH is not set
# BR2_PACKAGE_LIBRETRO_FCEUMM is not set
# BR2_PACKAGE_WLROOTS_XWAYLAND is not set
BR2_PACKAGE_XWAYLAND=y
BR2_PACKAGE_XAPP_XKBCOMP=y

# The shell drives the whole stack through GObject introspection typelibs.
BR2_PACKAGE_GOBJECT_INTROSPECTION=y

# Session registration: PAM with pam_elogind (elogind builds its module
# when linux-pam is present), and util-linux login - busybox login speaks
# no PAM.
BR2_PACKAGE_LINUX_PAM=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_LOGIN=y

# libpulse for gnome-settings-daemon's volume control; the server side is
# pipewire-pulse, which the image already runs - the PulseAudio daemon
# itself stays off.
BR2_PACKAGE_PULSEAUDIO=y

# GTK 4 (Wayland + X11 for Xwayland clients) and the GNOME platform
# libraries.
BR2_PACKAGE_LIBGTK3=y
BR2_PACKAGE_LIBGTK3_X11=y
BR2_PACKAGE_LIBGTK4=y
BR2_PACKAGE_LIBGTK4_WAYLAND=y
BR2_PACKAGE_LIBGTK4_X11=y
BR2_PACKAGE_LIBADWAITA=y
BR2_PACKAGE_LIBRSVG=y
BR2_PACKAGE_SHARED_MIME_INFO=y
BR2_PACKAGE_HICOLOR_ICON_THEME=y

# The stack itself; gnome-shell selects mutter's and its own runtime set
# (gnome-session, gnome-settings-daemon, e-d-s, ibus, gcr4...).
BR2_PACKAGE_ELOGIND=y
BR2_PACKAGE_DCONF=y
BR2_PACKAGE_LIBNOTIFY=y
BR2_PACKAGE_MOZJS128=y
BR2_PACKAGE_GJS=y
BR2_PACKAGE_MUTTER=y
BR2_PACKAGE_GNOME_SHELL=y
BR2_PACKAGE_GNOME_SESSION=y
BR2_PACKAGE_GNOME_SETTINGS_DAEMON=y

# Network: NetworkManager replaces ConnMan on GNOME images - the shell's
# network indicator and the Settings network panel both drive NM, and
# running two network managers would have them fight over interfaces.
# WiFi goes through wpa_supplicant's D-Bus interface. The image's
# /etc/resolv.conf already points into tmpfs, which NM's resolv.conf
# handling follows. /var/lib/NetworkManager persists via S15data.
# BR2_PACKAGE_CONNMAN is not set
BR2_PACKAGE_NETWORK_MANAGER=y
BR2_PACKAGE_NETWORK_MANAGER_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_DBUS=y

# Core applications. Web needs webkitgtk (built in its GTK 4 mode since
# libgtk4 is in this config); Settings drags the deepest tree - cups,
# NetworkManager/libnma, ModemManager, accountsservice, online-accounts,
# udisks; the network stack switch above keeps it consistent. The Image Viewer (Loupe) and Camera
# (Snapshot) are Rust applications and deliberately not packaged yet.
BR2_PACKAGE_WEBKITGTK=y
BR2_PACKAGE_EPIPHANY=y
BR2_PACKAGE_GNOME_CONTROL_CENTER=y
BR2_PACKAGE_NAUTILUS=y
BR2_PACKAGE_GNOME_CALCULATOR=y
BR2_PACKAGE_GNOME_CALENDAR=y
BR2_PACKAGE_GNOME_CONSOLE=y
BR2_PACKAGE_GNOME_DISK_UTILITY=y
BR2_PACKAGE_DECIBELS=y
BR2_PACKAGE_SHOWTIME=y
BR2_PACKAGE_GST1_PLUGINS_BASE=y
BR2_PACKAGE_GST1_PLUGINS_GOOD=y

# Portals: the GNOME backend plus the GTK3 fallback.
BR2_PACKAGE_XDG_DESKTOP_PORTAL=y
BR2_PACKAGE_XDG_DESKTOP_PORTAL_GNOME=y
BR2_PACKAGE_XDG_DESKTOP_PORTAL_GTK=y

# KNOWN GAP, checked at first build: evolution-data-server needs libical
# built with its GLib bindings (ICAL_GLIB); if Buildroot's libical package
# does not enable them, that package needs a tweak upstream or a fragment
# here.
