# Frontend: gmenu2x (MiyooCFW's fork) straight on the framebuffer, for
# armv5 boards and anything else with no OpenGL ES - SDL 1.2 with the
# fbcon driver needs no GPU, no Wayland and no GL at all.
#
# Include this AFTER the image profile (i.e. from a board.config): the
# negations below unwind the default EmulationStation/sway frontend that
# image.config selects, which works because board fragments are emitted
# last and later assignments win.

# No Wayland session and no GL frontend stack.
# BR2_PACKAGE_SWAYWM is not set
# BR2_PACKAGE_SWAYWM_SWAYBAR is not set
# BR2_PACKAGE_FOOT is not set
# BR2_PACKAGE_XWAYLAND is not set
# BR2_PACKAGE_WLROOTS_XWAYLAND is not set
# BR2_PACKAGE_EMULATIONSTATION is not set
# BR2_PACKAGE_RETROARCH is not set
# BR2_PACKAGE_LIBRETRO_FCEUMM is not set

# The frontend itself (external/package/gmenu2x) and its SDL 1.2 stack.
# fbcon is SDL1's framebuffer video driver - the whole point of this
# frontend. gmenu2x launches emulators/apps from its own menus, the same
# model MiyooCFW uses; how it is started (inittab respawn on tty1, in
# place of the sway session) is the board's concern.
BR2_PACKAGE_GMENU2X=y
BR2_PACKAGE_SDL=y
BR2_PACKAGE_SDL_FBCON=y
BR2_PACKAGE_SDL_IMAGE=y
BR2_PACKAGE_SDL_IMAGE_PNG=y
BR2_PACKAGE_SDL_TTF=y
