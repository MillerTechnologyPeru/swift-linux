# Frontend: the XFCE desktop, themed Chicago95 out of the box - for boards
# that want a desktop rather than a game launcher. XFCE 4.18 is X11-only
# (xfwm4 has no Wayland backend), so the session runs on a ROOTFUL XWayland
# hosted by cage, a wlroots kiosk compositor: cage owns KMS and input
# through seatd - the same non-root path the sway images boot through, no
# setuid X server involved - and its single client is an Xwayland
# presenting the entire X screen as one fullscreen surface. xfwm4 manages
# windows inside that screen exactly as it would on a bare X.org server
# (see the overlay's xfce-session / xfce-x11-session).
#
# GL is required: cage (wlroots) needs EGL, GLES and GBM, which the gpu
# fragment every board includes provides (virgl at minimum).
#
# Include this AFTER the image profile (i.e. from a board.config): the
# negations below unwind the default EmulationStation/sway frontend, which
# works because board fragments are emitted last and later assignments win.
#
# UNTESTED: packaged and kconfig-validated, but no board has booted it yet.

# No sway session. (XWAYLAND stays enabled from the default frontend: it
# is the display server here, not an add-on.)
#
# The game stack is NOT negated: EmulationStation, RetroArch and the cores
# are built and installed, they are just not what the machine boots into.
# Nothing starts them here - the frontend is launched from the sway
# session's config, and this image has no sway - so ES is an application
# among others, started from the desktop (see the .desktop entry in the
# common overlay) when the user wants it.
# BR2_PACKAGE_SWAYWM is not set
# BR2_PACKAGE_SWAYWM_SWAYBAR is not set
# BR2_PACKAGE_FOOT is not set
# wlroots' Xwayland integration is for rootless X windows managed by the
# compositor; cage's client is a rootful Xwayland (an ordinary Wayland
# client), which needs none of it.
# BR2_PACKAGE_WLROOTS_XWAYLAND is not set

# The compositor hosting the rootful XWayland. xterm stays as the fallback
# X terminal (the client-side X libraries come from applibs; the symbol is
# BR2_PACKAGE_XTERM - Buildroot's xterm lives outside the xapp_* namespace).
BR2_PACKAGE_CAGE=y
BR2_PACKAGE_XWAYLAND=y
BR2_PACKAGE_XTERM=y

# GTK 3 with the X11 backend, and the desktop data packages GTK apps
# expect (icon fallbacks, MIME database, SVG icon rendering).
BR2_PACKAGE_LIBGTK3=y
BR2_PACKAGE_LIBGTK3_X11=y
BR2_PACKAGE_LIBRSVG=y
BR2_PACKAGE_ADWAITA_ICON_THEME=y
BR2_PACKAGE_HICOLOR_ICON_THEME=y
BR2_PACKAGE_SHARED_MIME_INFO=y

# XFCE itself (this repo's external/), and the theme. chicago95 also
# installs the /etc/xdg xfconf defaults that make it the active theme.
BR2_PACKAGE_XFWM4=y
BR2_PACKAGE_XFCE4_PANEL=y
BR2_PACKAGE_XFCE4_SESSION=y
BR2_PACKAGE_XFCE4_SETTINGS=y
BR2_PACKAGE_XFDESKTOP=y
BR2_PACKAGE_THUNAR=y
BR2_PACKAGE_CHICAGO95=y

# Application managers: Flatpak + GNOME Software, Lutris, Heroic (see the
# fragment for what runs where). Desktop images are where an app store
# makes sense; the game-frontend images get content via ES/PortMaster.
include sdk/defconfig/appmanager.config
