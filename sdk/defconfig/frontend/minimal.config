# Frontend: a bare sway session with foot, and nothing else - the minimal
# frontend used to verify that a board boots and to keep the build short
# enough to iterate on.
#
# What it is for: proving the chain from firmware through the compositor to
# an interactive shell on the display. Everything above that layer - the
# game frontend, the emulators, the compatibility layers - is unwound,
# because each one is a long compile that cannot fail in a way this image
# is meant to catch. When sway comes up and foot has a prompt, the board is
# good and the heavier frontends are worth building.
#
# sway's config starts EmulationStation when it is installed and falls back
# to foot when it is not (see the common overlay's /etc/sway/config), so
# removing the frontend is all this fragment has to do to get a terminal.
#
# Include this AFTER the image profile (i.e. from a board.config): the
# negations below unwind what earlier fragments enabled, which works
# because board fragments are emitted last and later assignments win.
#
# GL is still required - wlroots needs EGL, GLES and GBM - so the board's
# GPU capability stays. XWayland also stays: its X client libraries come
# from applibs, and negating the X.org stack here would silently drop a
# dozen library packages that other things in the image link against.

# The session itself: compositor, bar and terminal, with the fonts foot
# needs to render anything at all.
BR2_PACKAGE_SWAYWM=y
BR2_PACKAGE_SWAYWM_SWAYBAR=y
BR2_PACKAGE_FOOT=y
BR2_PACKAGE_DEJAVU=y

# The game frontend and everything it launches. This is the bulk of the
# build: the frontend itself, RetroArch and a core per system, the
# standalone engines, and the Flash and PortMaster runtimes.
# BR2_PACKAGE_EMULATIONSTATION is not set
# BR2_PACKAGE_RETROARCH is not set
# BR2_PACKAGE_LIBRETRO_FCEUMM is not set
# BR2_PACKAGE_LIBRETRO_SNES9X is not set
# BR2_PACKAGE_LIBRETRO_GAMBATTE is not set
# BR2_PACKAGE_LIBRETRO_MGBA is not set
# BR2_PACKAGE_LIBRETRO_PCSX_REARMED is not set
# BR2_PACKAGE_LIBRETRO_DOSBOX_PURE is not set
# BR2_PACKAGE_LIBRETRO_MINIVMAC is not set
# BR2_PACKAGE_LIBRETRO_MU is not set
# BR2_PACKAGE_LIBRETRO_EASYRPG is not set
# BR2_PACKAGE_LIBRETRO_SCUMMVM is not set
# BR2_PACKAGE_LIBRETRO_LUTRO is not set
# BR2_PACKAGE_SOLARUS_ENGINE is not set
# BR2_PACKAGE_LOVE is not set
# BR2_PACKAGE_RUFFLE is not set
# BR2_PACKAGE_PORTMASTER is not set
# BR2_PACKAGE_PYTHON_PYGAME2 is not set

# Binary translation and the Windows layer (sdk/defconfig/emulation.config,
# a profile-level fragment). They exist to run the games this frontend does
# not ship, and they are expensive: Wine drags in mono, QEMU builds four
# target architectures. A board that wants them back uses a different
# frontend.
# BR2_PACKAGE_BOX64 is not set
# BR2_PACKAGE_BOX86 is not set
# BR2_PACKAGE_WINE is not set
# BR2_PACKAGE_QEMU is not set
# BR2_PACKAGE_QEMU_LINUX_USER is not set
# BR2_PACKAGE_QEMU_SYSTEM is not set
# BR2_PACKAGE_QEMU_SYSTEM_KVM is not set
# BR2_PACKAGE_QEMU_SYSTEM_TCG is not set
# BR2_PACKAGE_QEMU_SLIRP is not set
# BR2_PACKAGE_QEMU_TARGET_I386 is not set
# BR2_PACKAGE_QEMU_TARGET_X86_64 is not set
# BR2_PACKAGE_QEMU_TARGET_ARM is not set
# BR2_PACKAGE_QEMU_TARGET_AARCH64 is not set
# BR2_PACKAGE_WINE_PREBUILT is not set
