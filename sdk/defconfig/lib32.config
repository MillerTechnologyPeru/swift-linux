# 32-bit companion userland (runtime libraries only)
#
# Buildroot builds one architecture per build - there is no multilib support
# for Linux targets - so a 32-bit userland is produced by a SECOND build,
# whose libraries are then merged into the 64-bit image as /usr/lib32.
# See sdk/board/common/post-build-lib32.sh, and the "lib32" profile in
# generate-config.sh.
#
# This fragment therefore describes a library-only rootfs: no kernel, no
# bootloader, no init, no filesystem image. The 64-bit image supplies all of
# those. Combine it with an arch fragment (i386 for an x86_64 host image).
#
# The lib32 profile mirrors the image's library-bearing fragments (swift,
# network, audio, daemons, applibs), so this fragment adds only what none of
# them provide.

# Shared C library plus ldd/ldconfig, so 32-bit binaries can be inspected and
# the loader cache can be regenerated. (zlib comes from toolchain.config's
# core-library set.)
BR2_PACKAGE_GLIBC_UTILS=y

# No target filesystem image: the merge script consumes target/ directly.
# BR2_TARGET_ROOTFS_TAR is not set


# QEMU comes in through the emulation fragment (emitted before this one in
# the lib32 profile, precisely so this negation can win). The companion
# exists to supply 32-bit LIBRARIES to a 64-bit image; QEMU is a program,
# the 64-bit image builds its own, and the merge script would not copy a
# 32-bit one across anyway - building it here would only cost the CI an
# hour per companion. Wine stays: a 32-bit program is the point of that
# one, and the merge script carries it over explicitly.
# BR2_PACKAGE_QEMU is not set

# The media frameworks are declined here for the same reason. applibs names
# them so the SDK's sysroot offers libav* and gstreamer to a developer
# building against it; a 32-bit companion holds the libraries 32-bit games
# link - SDL, OpenAL, the GL stack - and those games do not link these.
#
# ffmpeg also does not compile 32-bit against the Vulkan video headers that
# applibs brings in. A session parameters handle is 64 bits wide on every
# architecture, so where a pointer is 32 bits the initialiser is a type
# error rather than a warning:
#
#   libavcodec/vulkan_av1.c:183: error: initialization of 'long long
#     unsigned int' from 'void *' makes integer from pointer without a cast
#
# It builds on the 64-bit side, where the two widths agree.
# BR2_PACKAGE_FFMPEG is not set
# BR2_PACKAGE_GSTREAMER1 is not set
# BR2_PACKAGE_GST1_PLUGINS_BASE is not set
# BR2_PACKAGE_LIBV4L is not set
