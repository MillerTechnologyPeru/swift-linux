# 32-bit companion userland (runtime libraries only)
#
# Buildroot builds one architecture per build - there is no multilib support
# for Linux targets - so a 32-bit userland is produced by a SECOND build,
# whose libraries are then merged into the 64-bit image as /usr/lib32.
# See sdk/board/common/post-build-lib32.sh, and the "lib32" profile in
# generate-config.sh.
#
# This fragment therefore describes a library-only rootfs: no kernel, no
# bootloader, no init, no filesystem image. The 64-bit image supplies all of
# those. Combine it with an arch fragment (i386 for an x86_64 host image).
#
# The lib32 profile mirrors the image's library-bearing fragments (swift,
# network, audio, daemons, applibs), so this fragment adds only what none of
# them provide.

# Shared C library plus ldd/ldconfig, so 32-bit binaries can be inspected and
# the loader cache can be regenerated. (zlib comes from toolchain.config's
# core-library set.)
BR2_PACKAGE_GLIBC_UTILS=y

# No target filesystem image: the merge script consumes target/ directly.
# BR2_TARGET_ROOTFS_TAR is not set
