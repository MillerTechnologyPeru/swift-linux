# On-device debugging tools, for board bring-up.
#
# A fragment of its own rather than lines in tools.config, because tools is
# one of the fragments the sdk and lib32 profiles share: anything added there
# lands in the SDK's sysroot and in the 32-bit companion, neither of which
# has any use for a tracer. Only the image profile picks this up (see
# generate-config.sh), so it is on the device where a board is being brought
# up and nowhere else.
#
# What these are for: when a board boots but something does not come up -
# sway exits, a daemon dies, a device node never appears - the question is
# almost always which syscall failed and with what errno. That is a strace
# away and otherwise close to unanswerable on a read-only image with no
# compiler.

# strace: the first tool to reach for. Small, no runtime dependencies, and
# it answers "what did it actually try to open" without rebuilding anything.
BR2_PACKAGE_STRACE=y

# gdbserver, not the full debugger. The device end of a remote debug session
# is a few hundred KB; the debugger itself is tens of megabytes and wants a
# terminal, and the cross gdb that drives it already exists in the SDK's
# toolchain. So: gdbserver here, cross gdb on the workstation.
#
# Switching to the on-device debugger means adding BR2_PACKAGE_GDB_DEBUGGER
# (and BR2_PACKAGE_GDB_TUI for a usable interface), which is worth it only
# when the board cannot be reached over the network.
BR2_PACKAGE_GDB=y
BR2_PACKAGE_GDB_SERVER=y
# BR2_PACKAGE_GDB_DEBUGGER is not set
