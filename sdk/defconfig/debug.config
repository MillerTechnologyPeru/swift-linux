# On-device debugging tools, for board bring-up.
#
# A fragment of its own rather than lines in tools.config, because tools is
# one of the fragments the sdk and lib32 profiles share: anything added there
# lands in the SDK's sysroot and in the 32-bit companion, neither of which
# has any use for a tracer. Only the image profile picks this up (see
# generate-config.sh), so it is on the device where a board is being brought
# up and nowhere else.
#
# What these are for: when a board boots but something does not come up -
# sway exits, a daemon dies, a device node never appears - the question is
# almost always which syscall failed and with what errno. That is a strace
# away and otherwise close to unanswerable on a read-only image with no
# compiler.

# strace: the first tool to reach for. Small, no runtime dependencies, and
# it answers "what did it actually try to open" without rebuilding anything.
BR2_PACKAGE_STRACE=y

# gdbserver, not the full debugger. The device end of a remote debug session
# is a few hundred KB; the debugger itself is tens of megabytes and wants a
# terminal, and the cross gdb that drives it already exists in the SDK's
# toolchain. So: gdbserver here, cross gdb on the workstation.
#
# Switching to the on-device debugger means adding BR2_PACKAGE_GDB_DEBUGGER
# (and BR2_PACKAGE_GDB_TUI for a usable interface), which is worth it only
# when the board cannot be reached over the network.
BR2_PACKAGE_GDB=y
BR2_PACKAGE_GDB_SERVER=y
# BR2_PACKAGE_GDB_DEBUGGER is not set
# The cross debugger for the build host, which is not wanted for its own sake
# (the SDK toolchain already ships one) but is what makes the target gdbserver
# above buildable at all.
#
# package/gdb/Config.in.host puts the "GDB debugger Version" choice inside
# "if BR2_PACKAGE_HOST_GDB", while BR2_GDB_VERSION - the string gdb.mk builds
# its tarball name from - has only conditional defaults keyed off that choice.
# So selecting the target package alone leaves the version empty and the
# download resolves to a file that cannot exist:
#
#   ERROR: No hash found for gdb-.tar.xz
#   make: *** [.stamp_downloaded] Error 1
#
# Buildroot spells out the same fallback for BR2_arc and no other architecture,
# so this is not something the configuration can express - the host package has
# to be on for the choice to take its default (16.x). It costs host build time
# and adds nothing to the image, host packages not being installed to target.
BR2_PACKAGE_HOST_GDB=y

# tcpdump: on-device capture. The network problems that actually happen on
# these boards - wifi that associates but carries nothing, mDNS that does
# not resolve, a captive portal, DHCP that never completes - all look
# identical from userspace ("it did not work") and are unambiguous on the
# wire. Capturing on the device beats capturing on a router because half of
# it is the board's own traffic.
#
# libpcap arrives with it: tcpdump's Config.in selects it, which is exactly
# the "only with tcpdump" rule - no separate declaration needed, and the
# library stays out of any profile this fragment is not in.
#
# Here rather than tools.config because that fragment is shared with the sdk
# and lib32 profiles, and a capture tool in a cross-compilation sysroot is
# dead weight - the same reasoning that put strace here.
BR2_PACKAGE_TCPDUMP=y
