# GNU C Toolchain
BR2_KERNEL_HEADERS_5_10=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y

# Device Management
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y

# Vendor
BR2_TOOLCHAIN_BUILDROOT_VENDOR="swift"
BR2_TARGET_GENERIC_HOSTNAME="swift-linux"
BR2_TARGET_GENERIC_ISSUE="Welcome to Swift Linux"

# Core libraries, installed on every profile and architecture.
# zlib: near-universal dependency of both built packages and prebuilt
# binaries; enable it explicitly rather than relying on transitive selection.
BR2_PACKAGE_ZLIB=y