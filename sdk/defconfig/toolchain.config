# GNU C Toolchain
#
# Kernel headers at 6.12: the boards run 6.15.6, 7.1.2 and 7.1.6, and headers
# have to stay at or below the oldest kernel they will run on, so 6.12 is the
# highest choice Buildroot offers that clears 6.15.6. 5.10 was too old for
# what the userspace now expects - elogind 257 includes linux/cfm_bridge.h,
# added in 5.14, and stops dead without it:
#
#   netlink-types-rtnl.c:13: fatal error: linux/cfm_bridge.h: No such file
#
# sdk/board/allwinner-suniv builds a MiyooCFW kernel far older than any of
# this; it was already below 5.10 and is no more correct at 6.12.
BR2_KERNEL_HEADERS_6_12=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
# Ship glibc's iconv converter modules: emulators and GTK apps convert
# non-UTF8 content (ROM metadata, archives, subtitles) through gconv, and
# without the copy every such conversion silently fails on the target.
BR2_TOOLCHAIN_GLIBC_GCONV_LIBS_COPY=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y

# Device Management
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y

# Vendor
BR2_TOOLCHAIN_BUILDROOT_VENDOR="swift"
BR2_TARGET_GENERIC_HOSTNAME="swift-linux"
BR2_TARGET_GENERIC_ISSUE="Welcome to Swift Linux"