# Language runtimes.
#
# Interpreters and virtual machines, kept apart from applibs (which is
# graphics/audio/input libraries) because they answer a different question:
# what a game or tool written in a scripting language needs in order to run
# at all. Two consumers:
#
#   - the image, where ports and tools execute; PortMaster in particular
#     asks the system for a runtime before it downloads its own copy.
#   - the app-sdk, where these appear as libpython/libluajit/... plus
#     headers, so an application can embed an interpreter or cross-compile
#     a native extension.
#
# The lib32 companion deliberately does NOT include this fragment: it
# exists so 32-bit games find the graphics and audio libraries their
# 64-bit counterparts have, and a 32-bit interpreter is not part of that
# contract (a 32-bit x86 game running under box86 brings its own). Adding
# "runtimes" to the lib32 fragment list in generate-config.sh is all it
# would take if that changes.
#
# Mapping to the runtimes PortMaster downloads for ports that lack one:
#
#   mono               -> BR2_PACKAGE_MONO below
#   zulu JRE/JDK       -> BR2_PACKAGE_OPENJDK below
#   pyxel (python)     -> BR2_PACKAGE_PYTHON3 below
#   love               -> the love package (frontend fragment: it has an
#                         EmulationStation system of its own)
#   solarus            -> likewise solarus-engine
#   frt (Godot), rlvm  -> no Buildroot package; ports needing these still
#                         get PortMaster's downloaded runtime, which is
#                         self-contained
#
# A port that finds no system runtime falls back to PortMaster's own, so
# nothing here is load-bearing for PortMaster - it saves the download and
# the disk it would occupy on the data partition.

# Python 3. The frontend's pygame builds against it, PortMaster's GUI
# (pugwash) runs on it, and the app-sdk needs libpython + headers to embed
# CPython or build C extensions for the device.
BR2_PACKAGE_PYTHON3=y

# LuaJIT, as an embeddable library: love, solarus-engine and the lutro
# core need the Lua 5.1 API, while WirePlumber needs the Lua 5.4 ABI.
#
# Both are required, and Buildroot's own luajit package cannot deliver
# that: it claims the "luainterpreter" virtual package, and a build with
# two claimants stops outright ("Only one provider can be selected at a
# time"). This repo's luajit-embed builds the same sources without the
# claim, so lua stays the system interpreter and the engines link
# libluajit directly. Lua 5.4 itself is declared in audio.config, next to
# the WirePlumber that needs it.
BR2_PACKAGE_LUAJIT_EMBED=y

# Ruby.
BR2_PACKAGE_RUBY=y

# Java. The JRE, not the full JDK (BR2_PACKAGE_OPENJDK_FULL_JDK stays off):
# the image runs Java ports, it does not compile them, and the compiler
# and tooling are most of the JDK's size. Note this needs a host JDK to
# bootstrap - Buildroot downloads a prebuilt one as host-openjdk-bin, a
# build-time host tool that is never installed on the target.
BR2_PACKAGE_OPENJDK=y
# AWT head support. Off by default, which gives a headless JRE - fine for
# a server, useless for a game: Java ports open their window through AWT
# (LWJGL and friends do this too). The X11 it needs is XWayland, which the
# frontend already runs.
BR2_PACKAGE_OPENJDK_X11=y

# .NET, via Mono - the runtime Unity and XNA/FNA ports need. Buildroot's
# mono is the same 6.12 line the ports ecosystem targets.
BR2_PACKAGE_MONO=y
