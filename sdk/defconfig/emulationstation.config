# EmulationStation, the controller-driven game launcher (this repo's
# external/package/emulationstation, the ROCKNIX emulationstation-next fork).
#
# The sway session starts it when the image ships it (see the common overlay's
# /etc/sway/config), so including this fragment is all a board or profile has
# to do to boot into the frontend. It runs as a Wayland client through SDL2's
# wayland driver (applibs.config), and reads game controllers directly from
# /dev/input - which is why the default user is in the "input" group
# (sdk/board/common/users.txt).
#
# The package selects its own libraries (freeimage, vlc for video snaps,
# sdl2_mixer for menu sounds); GL vs GLES is chosen by the package from the
# board's GPU capability.
BR2_PACKAGE_EMULATIONSTATION=y

# The emulator the frontend launches: RetroArch loads per-system libretro
# cores from /usr/lib/libretro. The frontend alone runs nothing, so the
# fragment ships the frontend, the player, and a first core together.
BR2_PACKAGE_RETROARCH=y
BR2_PACKAGE_LIBRETRO_FCEUMM=y
