# EmulationStation, the controller-driven game launcher (this repo's
# external/package/emulationstation, the ROCKNIX emulationstation-next fork).
#
# The sway session starts it when the image ships it (see the common overlay's
# /etc/sway/config), so including this fragment is all a board or profile has
# to do to boot into the frontend. It runs as a Wayland client through SDL2's
# wayland driver (applibs.config), and reads game controllers directly from
# /dev/input - which is why the default user is in the "input" group
# (sdk/board/common/users.txt).
#
# The package selects its own libraries (freeimage, vlc for video snaps,
# sdl2_mixer for menu sounds); GL vs GLES is chosen by the package from the
# board's GPU capability.
BR2_PACKAGE_EMULATIONSTATION=y

# The emulator the frontend launches: RetroArch loads per-system libretro
# cores from /usr/lib/libretro. The frontend alone runs nothing, so the
# fragment ships the frontend, the player, and the cores together.
BR2_PACKAGE_RETROARCH=y
# One core per console system (see es_systems.cfg for the mapping):
# NES, SNES, GB/GBC, GBA, PlayStation, DOS, early Macintosh, Palm OS.
BR2_PACKAGE_LIBRETRO_FCEUMM=y
BR2_PACKAGE_LIBRETRO_SNES9X=y
BR2_PACKAGE_LIBRETRO_GAMBATTE=y
BR2_PACKAGE_LIBRETRO_MGBA=y
BR2_PACKAGE_LIBRETRO_PCSX_REARMED=y
BR2_PACKAGE_LIBRETRO_DOSBOX_PURE=y
BR2_PACKAGE_LIBRETRO_MINIVMAC=y
BR2_PACKAGE_LIBRETRO_MU=y
# Game-engine cores: RPG Maker 2000/2003 (easyrpg), ScummVM adventure
# engines, and the Lutro Lua framework.
BR2_PACKAGE_LIBRETRO_EASYRPG=y
BR2_PACKAGE_LIBRETRO_SCUMMVM=y
BR2_PACKAGE_LIBRETRO_LUTRO=y

# Standalone game engines launched directly by the frontend (not through
# RetroArch): the Solarus ARPG engine (this repo's solarus-engine: linked
# against luajit, since WirePlumber owns the system Lua at 5.4 and
# Buildroot's solarus insists the system provider be 5.1), the LOVE Lua
# framework, and python + pygame for plain-Python games.
BR2_PACKAGE_SOLARUS_ENGINE=y
BR2_PACKAGE_LOVE=y
# Ruffle, the Flash Player emulator, for the .swf games and movies system
# (upstream prebuilt binary; see this repo's ruffle package).
BR2_PACKAGE_RUFFLE=y

# PortMaster: the downloader/launcher for the community's native game
# ports. Its Config.in depends on ARM (the ports and PortMaster's own
# helper binaries are armhf/aarch64 only), so this line is simply
# ignored on x86_64 images - no negation needed per board.
BR2_PACKAGE_PORTMASTER=y
# python3 itself comes from applibs (the app-sdk needs libpython); the
# fragment adds only the pygame runtime on top.
BR2_PACKAGE_PYTHON_PYGAME2=y
