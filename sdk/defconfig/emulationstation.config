# EmulationStation, the controller-driven game launcher (this repo's
# ports/package/games/emulationstation, the ROCKNIX emulationstation-next fork).
#
# The sway session starts it when the image ships it (see the common overlay's
# /etc/sway/config), so including this fragment is all a board or profile has
# to do to boot into the frontend. It runs as a Wayland client through SDL2's
# wayland driver (applibs.config), and reads game controllers directly from
# /dev/input - which is why the default user is in the "input" group
# (sdk/board/common/users.txt).
#
# The package selects its own libraries (freeimage, vlc for video snaps,
# sdl2_mixer for menu sounds); GL vs GLES is chosen by the package from the
# board's GPU capability.
BR2_PACKAGE_EMULATIONSTATION=y
# Its theme: Art Book Next, the one upstream ships by default (system
# artwork and logos, layouts for the handheld panels' 4:3 and 1:1 ratios).
BR2_PACKAGE_ES_THEME_ART_BOOK_NEXT=y
# Freely licensed homebrew games, copied into the ROM folders on first
# boot so a fresh image has something to play.
BR2_PACKAGE_ROMS_HOMEBREW=y

# The emulator the frontend launches: RetroArch loads per-system libretro
# cores from /usr/lib/libretro. The frontend alone runs nothing, so the
# fragment ships the frontend, the player, and the cores together.
BR2_PACKAGE_RETROARCH=y
# Controller profiles, so a game is playable with the built-in pad (or a
# known USB/Bluetooth one) without mapping it first. The handheld profiles
# carry the Select hotkeys: Select+Start quits back to the frontend,
# Select+X opens the RetroArch menu.
BR2_PACKAGE_RETROARCH_JOYPADS=y
# One core per console system (see es_systems.cfg for the mapping):
# NES, SNES, Mega Drive, PC Engine, GB/GBC, GBA, PlayStation, DOS, early
# Macintosh, Palm OS.
BR2_PACKAGE_LIBRETRO_FCEUMM=y
BR2_PACKAGE_LIBRETRO_SNES9X=y
BR2_PACKAGE_LIBRETRO_GENESIS_PLUS_GX=y
BR2_PACKAGE_LIBRETRO_BEETLE_PCE_FAST=y
BR2_PACKAGE_LIBRETRO_GAMBATTE=y
BR2_PACKAGE_LIBRETRO_MGBA=y
BR2_PACKAGE_LIBRETRO_PCSX_REARMED=y
BR2_PACKAGE_LIBRETRO_DOSBOX_PURE=y
BR2_PACKAGE_LIBRETRO_MINIVMAC=y
BR2_PACKAGE_LIBRETRO_MU=y
# Game-engine cores: RPG Maker 2000/2003 (easyrpg), ScummVM adventure
# engines, and the Lutro Lua framework.
BR2_PACKAGE_LIBRETRO_EASYRPG=y
BR2_PACKAGE_LIBRETRO_SCUMMVM=y
BR2_PACKAGE_LIBRETRO_LUTRO=y

# Standalone game engines launched directly by the frontend (not through
# RetroArch): the Solarus ARPG engine (this repo's solarus-engine: linked
# against luajit, since WirePlumber owns the system Lua at 5.4 and
# Buildroot's solarus insists the system provider be 5.1), the LOVE Lua
# framework, and python + pygame for plain-Python games.
BR2_PACKAGE_SOLARUS_ENGINE=y
BR2_PACKAGE_LOVE=y
# Ruffle, the Flash Player emulator, for the .swf games and movies system
# (this repo's ruffle package, built from source with cargo). It pulls in a
# Rust host toolchain, which the frontend needs for nothing else.
BR2_PACKAGE_RUFFLE=y

# PortMaster: the downloader/launcher for the community's native game
# ports. Its Config.in depends on ARM (the ports and PortMaster's own
# helper binaries are armhf/aarch64 only), so this line is simply
# ignored on x86_64 images - no negation needed per board.
BR2_PACKAGE_PORTMASTER=y
# python3 itself comes from applibs (the app-sdk needs libpython); the
# fragment adds only the pygame runtime on top.
BR2_PACKAGE_PYTHON_PYGAME2=y

# Flatpak, with Flathub preconfigured (the flatpak port ships the remote),
# and GNOME Software as its storefront - the "App Store" entry S15data
# seeds into Apps. Installed applications appear in Apps as well, through
# es-flatpak-sync. The installation lives on the data partition (see
# S15data and appmanager.config, which the desktops include instead).
# GNOME Software needs a pointer; on a handheld that is a USB mouse, or
# install over SSH with "flatpak install flathub <app>".
BR2_PACKAGE_FLATPAK=y
BR2_PACKAGE_LIBGTK4=y
BR2_PACKAGE_LIBGTK4_WAYLAND=y
# The image carries CUPS, so GTK4 builds its CUPS print backend, which
# includes cairo's PDF and PostScript surface headers - and Buildroot's
# libgtk4 does not select them:
#
#   gtkprintbackendcups.c:39:10: fatal error: cairo-pdf.h: No such file
#
# Those surfaces come with cairo's zlib option ("script, ps, pdf, and xml
# surfaces"); the separate CAIRO_PDF/CAIRO_PS options are legacy, and
# setting them stops the build at Makefile.legacy.
BR2_PACKAGE_CAIRO_ZLIB=y
BR2_PACKAGE_GNOME_SOFTWARE=y

# USB gadget mode, from the frontend's Network Settings (USB GADGET
# FUNCTION, driven by /usr/bin/usbgadget): the OTG port becomes a USB
# network adapter for the computer it is plugged into, handing it an
# address with busybox's udhcpd, or an MTP device exposing the ROM
# folders through umtprd.
BR2_PACKAGE_UMTPRD=y
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="@SWIFT_LINUX@/sdk/board/common/busybox-udhcpd.fragment"
