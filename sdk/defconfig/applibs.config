
# Packages

# Wayland
BR2_PACKAGE_WAYLAND=y
BR2_PACKAGE_WAYLAND_PROTOCOLS=y
BR2_PACKAGE_WLROOTS=y
BR2_PACKAGE_LIBINPUT=y
# Client-side window decorations for Wayland applications (and what gives the
# mesa demos their Wayland backend).
BR2_PACKAGE_LIBDECOR=y

# X11 client libraries for 32-bit games running under XWayland. Most X11 games
# link the extension libs below (input, randr, cursor, screensaver, etc.), so
# ship the full client stack, not just libX11.
BR2_PACKAGE_XORG7=y
BR2_PACKAGE_LIBXCB=y
BR2_PACKAGE_XLIB_LIBX11=y
BR2_PACKAGE_XLIB_LIBXEXT=y
BR2_PACKAGE_XLIB_LIBXRANDR=y
BR2_PACKAGE_XLIB_LIBXRENDER=y
BR2_PACKAGE_XLIB_LIBXCURSOR=y
BR2_PACKAGE_XLIB_LIBXI=y
BR2_PACKAGE_XLIB_LIBXFIXES=y
BR2_PACKAGE_XLIB_LIBXINERAMA=y
BR2_PACKAGE_XLIB_LIBXSCRNSAVER=y
BR2_PACKAGE_XLIB_LIBXXF86VM=y
BR2_PACKAGE_XLIB_LIBXDAMAGE=y
BR2_PACKAGE_XLIB_LIBXTST=y
BR2_PACKAGE_XLIB_LIBXCOMPOSITE=y

# OpenGL
BR2_PACKAGE_LIBDRM=y
BR2_PACKAGE_MESA3D=y
# Vulkan: the loader and headers are GPU-agnostic, and without them here a
# Vulkan app cannot build against the app-sdk at all - the per-GPU
# fragments (sdk/defconfig/gpu/) ship the loader on the image but the
# app-sdk profile never includes them. Drivers stay per-board.
BR2_PACKAGE_VULKAN_HEADERS=y
BR2_PACKAGE_VULKAN_LOADER=y
BR2_PACKAGE_MESA3D_GBM=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_GLX=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_VIRGL=y

# 3D application libraries, so the app-sdk can build games and 3D tools
# that the image then runs: assimp loads model formats, glm is the
# header-only GL mathematics library.
BR2_PACKAGE_ASSIMP=y
BR2_PACKAGE_GLM=y
# physfs: the archive-mounting VFS layer games use for their asset packs.
BR2_PACKAGE_PHYSFS=y

# HEIF/HEIC images (every iPhone photo) with the H.265 decoder libheif
# needs for them; its gdk-pixbuf loader lets nautilus and GTK apps
# thumbnail and display these.
BR2_PACKAGE_LIBHEIF=y
BR2_PACKAGE_LIBDE265=y

# SDL2 (plus the mixer/image/ttf/... companions used by SDL2 games).
# The Wayland video driver is what lets SDL2 apps (EmulationStation, games)
# run inside the sway session: KMSDRM alone cannot work there, because the
# compositor already holds DRM master.
BR2_PACKAGE_SDL2=y
BR2_PACKAGE_SDL2_WAYLAND=y
BR2_PACKAGE_SDL2_KMSDRM=y
BR2_PACKAGE_SDL2_OPENGL=y
BR2_PACKAGE_SDL2_OPENGLES=y
BR2_PACKAGE_SDL2_GFX=y
BR2_PACKAGE_SDL2_IMAGE=y
BR2_PACKAGE_SDL2_MIXER=y
BR2_PACKAGE_SDL2_NET=y
BR2_PACKAGE_SDL2_TTF=y
# freetype: explicit rather than inherited through SDL2_ttf, so apps that
# link it directly are guaranteed to find it in the sysroot.
BR2_PACKAGE_FREETYPE=y

# SDL3 (from this repo's BR2_EXTERNAL) for modern SDL3 games such as Nanosaur 2.
BR2_PACKAGE_SDL3=y
BR2_PACKAGE_SDL3_WAYLAND=y
BR2_PACKAGE_SDL3_X=y
BR2_PACKAGE_SDL3_KMSDRM=y
BR2_PACKAGE_SDL3_OPENGL=y
BR2_PACKAGE_SDL3_OPENGLES=y
BR2_PACKAGE_SDL3_ALSA=y

# Cairo (the PS/SVG/script/PNG backends are now built automatically from
# their dependencies; the old per-backend options were removed from Buildroot).
BR2_PACKAGE_CAIRO=y
BR2_PACKAGE_PIXMAN=y
BR2_PACKAGE_FONTCONFIG=y
BR2_PACKAGE_HARFBUZZ=y
BR2_PACKAGE_LCMS2=y

# Image
BR2_PACKAGE_LIBPNG=y
BR2_PACKAGE_JPEG=y
# Pin the provider: the choice defaults to jpeg-turbo only on SIMD-capable
# CPUs, so plain i686 (no MMX guarantee) silently fell back to IJG libjpeg
# - whose API lacks jpeg-turbo's JCS_EXT_* colorspaces and size_t/ulong
# signature, breaking grim on the i386 lib32 companion. turbo builds fine
# without SIMD; every arch now gets the same library.
BR2_PACKAGE_JPEG_TURBO=y
# Bitmap format library (from this repo's BR2_EXTERNAL; Buildroot has none).
BR2_PACKAGE_FREEIMAGE=y

# Audio
BR2_PACKAGE_ALSA_LIB=y
BR2_PACKAGE_OPENAL=y
BR2_PACKAGE_LIBVORBIS=y
BR2_PACKAGE_LIBOGG=y
BR2_PACKAGE_LIBTHEORA=y
BR2_PACKAGE_FLAC=y
# Opus completes the codec set above - it is what modern games ship voice
# and music in - and speexdsp is the matching resampler. Both already ride
# into every image as emulator dependencies (easyrpg); declaring them here
# adds them to the app-sdk sysroot.
BR2_PACKAGE_OPUS=y
BR2_PACKAGE_OPUSFILE=y
BR2_PACKAGE_SPEEXDSP=y
# mpg123 and libmodplug: explicit rather than left to chance - SDL2_mixer
# treats them as optional dependencies, so without them it silently
# builds with no mp3 or tracker/mod playback.
BR2_PACKAGE_MPG123=y
BR2_PACKAGE_LIBMODPLUG=y

# Game-development libraries the image already carries as emulator-stack
# dependencies (love/solarus embed luajit, mgba links libzip, easyrpg
# brings fmt and liblcf brings expat); declared here so the app-sdk
# sysroot exposes them too. LuaJIT is the embeddable game-scripting
# interpreter (Lua 5.1 dialect - the system Lua stays 5.4, see audio.config).
BR2_PACKAGE_LUAJIT=y
BR2_PACKAGE_LIBZIP=y
BR2_PACKAGE_FMT=y
BR2_PACKAGE_EXPAT=y

# Misc
BR2_PACKAGE_NCURSES=y
BR2_PACKAGE_LIBEPOXY=y
BR2_PACKAGE_LIBFRIBIDI=y
# PCRE1 was removed from Buildroot; PCRE2 is the replacement (UCP is on by
# default in pcre2).
BR2_PACKAGE_PCRE2=y

# SSH
BR2_PACKAGE_LIBSSH=y
BR2_PACKAGE_LIBSSH_OPENSSL=y
