
# Packages

# Wayland
BR2_PACKAGE_WAYLAND=y
BR2_PACKAGE_WAYLAND_PROTOCOLS=y
BR2_PACKAGE_WLROOTS=y
BR2_PACKAGE_LIBINPUT=y
# Client-side window decorations for Wayland applications (and what gives the
# mesa demos their Wayland backend).
BR2_PACKAGE_LIBDECOR=y

# X11 client libraries for 32-bit games running under XWayland. Most X11 games
# link the extension libs below (input, randr, cursor, screensaver, etc.), so
# ship the full client stack, not just libX11.
BR2_PACKAGE_XORG7=y
BR2_PACKAGE_LIBXCB=y
BR2_PACKAGE_XLIB_LIBX11=y
BR2_PACKAGE_XLIB_LIBXEXT=y
BR2_PACKAGE_XLIB_LIBXRANDR=y
BR2_PACKAGE_XLIB_LIBXRENDER=y
BR2_PACKAGE_XLIB_LIBXCURSOR=y
BR2_PACKAGE_XLIB_LIBXI=y
BR2_PACKAGE_XLIB_LIBXFIXES=y
BR2_PACKAGE_XLIB_LIBXINERAMA=y
BR2_PACKAGE_XLIB_LIBXSCRNSAVER=y
BR2_PACKAGE_XLIB_LIBXXF86VM=y
BR2_PACKAGE_XLIB_LIBXDAMAGE=y
BR2_PACKAGE_XLIB_LIBXTST=y
BR2_PACKAGE_XLIB_LIBXCOMPOSITE=y

# OpenGL
BR2_PACKAGE_LIBDRM=y
BR2_PACKAGE_MESA3D=y
# Vulkan: the loader and headers are GPU-agnostic, and without them here a
# Vulkan app cannot build against the app-sdk at all - the per-GPU
# fragments (sdk/defconfig/gpu/) ship the loader on the image but the
# app-sdk profile never includes them. Drivers stay per-board.
BR2_PACKAGE_VULKAN_HEADERS=y
BR2_PACKAGE_VULKAN_LOADER=y
BR2_PACKAGE_MESA3D_GBM=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_GLX=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_VIRGL=y

# 3D application libraries, so the app-sdk can build games and 3D tools
# that the image then runs: assimp loads model formats, glm is the
# header-only GL mathematics library.
BR2_PACKAGE_ASSIMP=y
BR2_PACKAGE_GLM=y
# physfs: the archive-mounting VFS layer games use for their asset packs.
BR2_PACKAGE_PHYSFS=y

# HEIF/HEIC images (every iPhone photo) with the H.265 decoder libheif
# needs for them; its gdk-pixbuf loader lets nautilus and GTK apps
# thumbnail and display these.
BR2_PACKAGE_LIBHEIF=y
BR2_PACKAGE_LIBDE265=y

# SDL2 (plus the mixer/image/ttf/... companions used by SDL2 games).
# The Wayland video driver is what lets SDL2 apps (EmulationStation, games)
# run inside the sway session: KMSDRM alone cannot work there, because the
# compositor already holds DRM master.
BR2_PACKAGE_SDL2=y
BR2_PACKAGE_SDL2_WAYLAND=y
BR2_PACKAGE_SDL2_KMSDRM=y
BR2_PACKAGE_SDL2_OPENGL=y
BR2_PACKAGE_SDL2_OPENGLES=y
BR2_PACKAGE_SDL2_GFX=y
BR2_PACKAGE_SDL2_IMAGE=y
BR2_PACKAGE_SDL2_MIXER=y
BR2_PACKAGE_SDL2_NET=y
BR2_PACKAGE_SDL2_TTF=y
# freetype: explicit rather than inherited through SDL2_ttf, so apps that
# link it directly are guaranteed to find it in the sysroot.
BR2_PACKAGE_FREETYPE=y

# SDL3 (plus the same set of companions as SDL2 above) for modern SDL3 games
# such as Nanosaur 2. The packages live in the buildroot fork.
#
# The X11 option is BR2_PACKAGE_SDL3_X11. It was written here as _X, a
# symbol nothing defines; a defconfig ignores those without a word, and
# X11 was only on because something else selected it.
BR2_PACKAGE_SDL3=y
BR2_PACKAGE_SDL3_WAYLAND=y
BR2_PACKAGE_SDL3_X11=y
BR2_PACKAGE_SDL3_KMSDRM=y
BR2_PACKAGE_SDL3_OPENGL=y
BR2_PACKAGE_SDL3_OPENGLES=y
BR2_PACKAGE_SDL3_ALSA=y
# Each companion picks up the decoders and formats this fragment and the
# media ones already enable - flac, mpg123, opusfile and vorbis for the
# mixer; jpeg, png, tiff and webp for image; harfbuzz for ttf - and builds
# without the ones they do not, because every one is gated on its own
# BR2_PACKAGE_ symbol. plutosvg gives SDL3_ttf colour emoji (OpenType-SVG
# glyphs); it is a new library, selected here rather than left to chance.
BR2_PACKAGE_SDL3_GFX=y
BR2_PACKAGE_SDL3_IMAGE=y
BR2_PACKAGE_SDL3_MIXER=y
BR2_PACKAGE_SDL3_NET=y
BR2_PACKAGE_SDL3_TTF=y
BR2_PACKAGE_PLUTOSVG=y

# Cairo (the PS/SVG/script/PNG backends are now built automatically from
# their dependencies; the old per-backend options were removed from Buildroot).
BR2_PACKAGE_CAIRO=y
BR2_PACKAGE_PIXMAN=y
BR2_PACKAGE_FONTCONFIG=y
BR2_PACKAGE_HARFBUZZ=y
BR2_PACKAGE_LCMS2=y

# Pango completes that stack - cairo draws, harfbuzz shapes, pango lays the
# text out - and it was the only one of the five not named anywhere. It has
# always been in the sysroot regardless, because GTK selects it, which is
# exactly the arrangement the compression libraries in libs.config are
# declared to avoid: it would leave with the last package that selects it,
# and anything that had linked it would start failing to configure with no
# obvious connection to the change that caused it.
BR2_PACKAGE_PANGO=y

# The rest of what GTK was quietly providing, and that is useful without it.
# tiff is the clearest case: sdl3_image builds its TIFF decoder when
# BR2_PACKAGE_TIFF is set, and that was set only because GTK's chain reached
# libtiff - so dropping GTK would have taken TIFF support out of an unrelated
# library with no error anywhere. gdk-pixbuf loads and scales images headless,
# graphene is SIMD vector and matrix maths, libxkbcommon is what every Wayland
# client uses for keymaps rather than something GTK-specific, and
# libdisplay-info parses EDID.
BR2_PACKAGE_TIFF=y
BR2_PACKAGE_GDK_PIXBUF=y
BR2_PACKAGE_GRAPHENE=y
BR2_PACKAGE_LIBXKBCOMMON=y
BR2_PACKAGE_LIBDISPLAY_INFO=y

# Image
BR2_PACKAGE_LIBPNG=y
BR2_PACKAGE_JPEG=y
# Pin the provider: the choice defaults to jpeg-turbo only on SIMD-capable
# CPUs, so plain i686 (no MMX guarantee) silently fell back to IJG libjpeg
# - whose API lacks jpeg-turbo's JCS_EXT_* colorspaces and size_t/ulong
# signature, breaking grim on the i386 lib32 companion. turbo builds fine
# without SIMD; every arch now gets the same library.
BR2_PACKAGE_JPEG_TURBO=y
# Bitmap format library (from this repo's BR2_EXTERNAL; Buildroot has none).
BR2_PACKAGE_FREEIMAGE=y

# Audio
BR2_PACKAGE_ALSA_LIB=y
BR2_PACKAGE_OPENAL=y
BR2_PACKAGE_LIBVORBIS=y
BR2_PACKAGE_LIBOGG=y
BR2_PACKAGE_LIBTHEORA=y
BR2_PACKAGE_FLAC=y
# Opus completes the codec set above - it is what modern games ship voice
# and music in - and speexdsp is the matching resampler. Both already ride
# into every image as emulator dependencies (easyrpg); declaring them here
# adds them to the app-sdk sysroot.
BR2_PACKAGE_OPUS=y
BR2_PACKAGE_OPUSFILE=y
BR2_PACKAGE_SPEEXDSP=y
# mpg123 and libmodplug: explicit rather than left to chance - SDL2_mixer
# treats them as optional dependencies, so without them it silently
# builds with no mp3 or tracker/mod playback.
BR2_PACKAGE_MPG123=y
BR2_PACKAGE_LIBMODPLUG=y

# Game-development libraries the image already carries as emulator-stack
# dependencies (mgba links libzip, easyrpg brings fmt, liblcf brings
# expat); declared here so the app-sdk sysroot exposes them too.
BR2_PACKAGE_LIBZIP=y
BR2_PACKAGE_FMT=y
BR2_PACKAGE_EXPAT=y

# The language runtimes an app links against (libpython, libluajit and the
# rest) live in their own fragment now: sdk/defconfig/runtimes.config,
# which the image and app-sdk profiles both include.

# Misc
BR2_PACKAGE_NCURSES=y
BR2_PACKAGE_LIBEPOXY=y
BR2_PACKAGE_LIBFRIBIDI=y
# PCRE1 was removed from Buildroot; PCRE2 is the replacement (UCP is on by
# default in pcre2).
BR2_PACKAGE_PCRE2=y

# SSH
BR2_PACKAGE_LIBSSH=y
BR2_PACKAGE_LIBSSH_OPENSSL=y

# Image formats: webp was set nowhere, so SDL2_image and SDL3_image built
# without it on every image but GNOME, where WebKit selects it. demux and
# mux are the parts SDL_image's webp support links.
BR2_PACKAGE_WEBP=y
BR2_PACKAGE_WEBP_DEMUX=y
BR2_PACKAGE_WEBP_MUX=y

# Libraries every image already carries through the audio and media
# fragments, which the sdk profiles never include - so an app could run
# against them but not be built against them. Declared here for the
# sysroot; the image fragments keep their plugin and tool sub-options, and
# print an "override" warning for each package both name.
#
#   libgudev         GLib-side udev: hotplug for gamepads and devices; six
#                    ports packages link it
#   libsndfile       audio file I/O
#   pipewire         libpipewire, the audio and screencast client API here
#   ffmpeg           libav* for media apps and emulators
#   gstreamer1       the media framework, with its base plugin library
#   libv4l           camera capture
#   fdk-aac          AAC
#   lua              embeddable Lua, 5.4 as audio.config builds it
#   libnl            netlink: interfaces, link state, nl80211 scans
BR2_PACKAGE_LIBGUDEV=y
BR2_PACKAGE_LIBSNDFILE=y
BR2_PACKAGE_PIPEWIRE=y
BR2_PACKAGE_FFMPEG=y
BR2_PACKAGE_GSTREAMER1=y
BR2_PACKAGE_GST1_PLUGINS_BASE=y
BR2_PACKAGE_LIBV4L=y
BR2_PACKAGE_FDK_AAC=y
BR2_PACKAGE_LUA=y
BR2_PACKAGE_LUA_5_4=y
BR2_PACKAGE_LIBNL=y

# GL helpers games and ports expect. glfw is the usual window-and-context
# layer for GL apps and for Swift GL bindings; glew the extension loader
# older ports link, where libepoxy above serves new code; glu the legacy
# utility library. libass renders subtitles for media apps.
BR2_PACKAGE_LIBGLFW=y
BR2_PACKAGE_LIBGLEW=y
BR2_PACKAGE_LIBGLU=y
BR2_PACKAGE_LIBASS=y

# Formats the SDL companions above already know how to use, and compile
# support for only when the library is present - every one is gated on its
# own BR2_PACKAGE_ symbol, so until now the mixer was built without module
# and chiptune playback and SDL_image without JPEG XL or AVIF.
#
#   libxmp           MOD, S3M, XM, IT - tracker music, which is what a
#                    large part of the retro catalogue uses
#   game-music-emu   NSF, SPC, GBS, VGM - console sound-chip formats
#   libjxl, libavif  JPEG XL and AVIF
BR2_PACKAGE_LIBXMP=y
BR2_PACKAGE_GAME_MUSIC_EMU=y
BR2_PACKAGE_LIBJXL=y
BR2_PACKAGE_LIBAVIF=y

# libvpx: VP8/VP9, for encoding as well as the decode ffmpeg already does.
# libsecret: the Secret Service client - stored passwords and tokens, which
# an app reaches through the same D-Bus API whether gnome-keyring or another
# implementation answers.
BR2_PACKAGE_LIBVPX=y
BR2_PACKAGE_LIBSECRET=y
