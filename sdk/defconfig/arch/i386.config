# i386 (32-bit x86)
BR2_i386=y
BR2_x86_i686=y

# OpenJDK's Zero VM, in place of the "server" HotSpot the other arches get.
# OpenJDK 24 removed the 32-bit x86 JIT ports, and 25's configure refuses the
# combination outright - make/autoconf/basic.m4 stops the build with
#
#   checking openjdk-target os-cpu... linux-x86
#   configure: error: 32-bit x86 builds are not supported
#
# unless the JVM variant is zero, which is the one 32-bit x86 configuration
# upstream still supports. Zero is the assembler-free interpreter: it runs the
# same class files with no JIT, so Java is slower here than on the 64-bit
# arches, but it builds and it runs. Buildroot's openjdk selects libffi for it.
#
# This lives in the arch fragment rather than runtimes.config because it is a
# property of the architecture, not of the runtime set - and the fragments are
# concatenated arch-first, so an arch fragment can pick a choice value that a
# later fragment's BR2_PACKAGE_OPENJDK=y then makes effective (kconfig resolves
# dependencies after reading the whole file), but it cannot override a plain
# symbol that a later fragment sets.
BR2_PACKAGE_OPENJDK_JVM_VARIANT_ZERO=y
