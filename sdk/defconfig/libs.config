# Core libraries
BR2_PACKAGE_ZLIB=y
BR2_PACKAGE_BZIP2=y
BR2_PACKAGE_DBUS=y
BR2_PACKAGE_SQLITE=y
BR2_PACKAGE_LIBEDIT=y
BR2_PACKAGE_LIBARCHIVE=y

# Compression libraries, declared rather than inherited. lz4 arrives on its
# own because EROFS needs it, and zstd because several packages select it -
# but "something else selects it" is not a guarantee, and both are part of
# what the SDK's sysroot should offer. Naming them here fixes that: liblzma
# is what xar's lzma mode wants and what libarchive uses for .xz members,
# and libzstd the same for .zst.
#
# These bring their command-line tools with them, which is worth being clear
# about because it reads like a library-only list and is not one. Buildroot's
# xz package is xz-utils, configured --enable-xz --enable-xzdec --enable-scripts,
# and zstd installs its CLI the same way, so /usr/bin gets xz, xzdec, lzmadec,
# lzmainfo, xzgrep, xzdiff, xzless, zstd, zstdgrep, zstdmt and the lzma-name
# symlinks alongside liblzma and libzstd. They shadow busybox, and that is the
# useful direction: busybox is built with unxz/xzcat/xz but no xz compressor at
# all, so without these the system could read a .xz and never write one. Only
# lz4 is genuinely library-only here - it arrives through EROFS with no binary.
#
# lzfse is here for a different reason than the other two: nothing selects it,
# so it is in the sysroot only because this line asks for it. It is the format
# Apple platforms compress with - Apple Archive, libcompression - and it also
# decodes LZVN, which is how an encrypted kernelcache is packed. On a distro
# whose reason for existing is Swift, being able to read Apple's compression
# without vendoring a copy of the encoder is worth the 80K.
#
# brotli and lz4 close the set. Both were already in every image and neither
# was named: brotli comes down through GTK's chain, lz4 through EROFS. That
# is the same "something else selects it" that the paragraph above rejects,
# so they are stated here too.
BR2_PACKAGE_XZ=y
BR2_PACKAGE_ZSTD=y
BR2_PACKAGE_LZFSE=y
BR2_PACKAGE_BROTLI=y
BR2_PACKAGE_LZ4=y

# libevent, for the same reason. It is already in every image, but only
# because ntp and tmux each select it - so it is one defconfig edit away
# from disappearing out of the sysroot, and anything that had linked it
# would start failing to configure with no obvious connection to the change
# that caused it. Naming it makes it part of what this distro offers rather
# than a side effect of two unrelated packages.
BR2_PACKAGE_LIBEVENT=y

# Libraries that reached the sysroot only because GTK's dependency chain
# pulled them in. Each is useful with no GUI in sight - glib is the base half
# the system is written against, the gnutls stack is a second TLS
# implementation alongside OpenSSL, libffi is what anything doing dynamic
# calls needs, and the rest are general-purpose - so they should not depend on
# a desktop staying in the configuration. Same argument as libevent above,
# with a larger blast radius: nothing here is named by the packages that use
# it, so the failure would appear as a configure error in an unrelated build.
BR2_PACKAGE_LIBGLIB2=y
BR2_PACKAGE_GNUTLS=y
BR2_PACKAGE_NETTLE=y
BR2_PACKAGE_LIBTASN1=y
BR2_PACKAGE_P11_KIT=y
BR2_PACKAGE_LIBFFI=y
BR2_PACKAGE_GMP=y
BR2_PACKAGE_LIBUNISTRING=y
BR2_PACKAGE_LIBUSB=y
BR2_PACKAGE_ELFUTILS=y
BR2_PACKAGE_LIBXCRYPT=y

# Swift Dependencies
BR2_PACKAGE_ICU=y
BR2_PACKAGE_LIBBSD=y
BR2_PACKAGE_LIBMD=y
BR2_PACKAGE_LIBXML2=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_LIBOPENSSL_ENGINES=y

# Network transport features the SDK's own users hit first. Swift's
# URLSession is libcurl - swift-foundation links it - and libcurl speaks
# HTTP/2 only with nghttp2 and WebSockets only when asked. Without these an
# app talks HTTP/1.1 everywhere except GNOME images, where libsoup drags
# nghttp2 in and the same app quietly behaves differently; and every
# URLSessionWebSocketTask fails to connect, since the default is
# --disable-websockets.
BR2_PACKAGE_NGHTTP2=y
BR2_PACKAGE_LIBCURL_WEBSOCKETS_SUPPORT=y

# What Debian's and Apple's libsqlite3 ship, and what SQLite.swift and GRDB
# assume. FTS5 was on GNOME images only, because nautilus -> tinysparql
# selects it: "USING fts5" worked there and was "no such module" on a
# handheld.
BR2_PACKAGE_SQLITE_ENABLE_FTS5=y
BR2_PACKAGE_SQLITE_ENABLE_RTREE=y
BR2_PACKAGE_SQLITE_ENABLE_COLUMN_METADATA=y

# Privilege narrowing for services: bind :443 as the session user and drop
# capabilities, or fence a helper with seccomp. Both were on every image
# already (ntpd, flatpak); the SDK could not see them.
BR2_PACKAGE_LIBCAP=y
BR2_PACKAGE_LIBSECCOMP=y

# System integration libraries the images run but the SDK did not offer.
# Declared here rather than inherited from network.config and
# daemons.config, which the sdk profiles never include; those fragments
# keep their tool and plugin sub-options. Image profiles, where both name
# the package, print an "override" warning for each - harmless, and the
# pattern audio.config already sets with lua.
#
#   bluez5_utils     libbluetooth and the HCI/L2CAP/RFCOMM headers, for code
#                    below the org.bluez D-Bus API
#   avahi            mDNS client, plus libdns_sd - the Bonjour API, since
#                    corelibs-foundation has no NetService on Linux. The
#                    compatibility library requires the daemon option.
#   network-manager  libnm, the typed client for the NetworkManager every
#                    image runs
#   libpcap          packet capture
#   enet             reliable UDP, the networking layer of many games
BR2_PACKAGE_BLUEZ5_UTILS=y
BR2_PACKAGE_AVAHI=y
BR2_PACKAGE_AVAHI_DAEMON=y
BR2_PACKAGE_AVAHI_LIBDNSSD_COMPATIBILITY=y
BR2_PACKAGE_NETWORK_MANAGER=y
BR2_PACKAGE_LIBPCAP=y
BR2_PACKAGE_ENET=y

# Parsers and signing, on every image already and named here so the sysroot
# offers them. json-c is the C JSON library everything here reaches for -
# bluez5_utils, cryptsetup and sway among them - and libyaml the YAML one,
# under libblockdev and appstream. Swift packages tend to vendor both, C and
# C++ consumers do not. libgpgme is the GPG API flatpak and libostree use,
# for code that verifies a signature rather than shelling out to gpg.
BR2_PACKAGE_JSON_C=y
BR2_PACKAGE_LIBYAML=y
BR2_PACKAGE_LIBGPGME=y

# NFC. libnfc drives the reader from userspace rather than through the
# kernel's NFC stack, and compiles in only the drivers it is told to - all of
# them here, so an image works with whatever reader is attached rather than
# with the one the build guessed:
#
#   pn53x_usb, acr122_usb   USB dongles, the ACR122U among them
#   acr122_pcsc             the same reader through a PC/SC daemon
#   pn532_uart/i2c/spi      a PN532 breakout wired to a header
#   arygon, acr122s         serial readers
#
# The USB drivers use libusb (already above) through libusb-compat; the PC/SC
# one pulls in the pcsc-lite daemon, which is what makes a smartcard reader
# usable as well. See sdk/board/common/linux-nfc.fragment for the kernel side
# and why its drivers are modules: a bound kernel driver takes the reader
# away from libnfc.
#
# libfreefare is the tag layer on top - MIFARE Classic, Ultralight and
# DESFire - which is what talking to a card actually means.
BR2_PACKAGE_LIBNFC=y
BR2_PACKAGE_LIBNFC_ACR122_PCSC=y
BR2_PACKAGE_LIBNFC_ACR122_USB=y
BR2_PACKAGE_LIBNFC_ACR122S=y
BR2_PACKAGE_LIBNFC_ARYGON=y
BR2_PACKAGE_LIBNFC_PN532_I2C=y
BR2_PACKAGE_LIBNFC_PN532_SPI=y
BR2_PACKAGE_LIBNFC_PN532_UART=y
BR2_PACKAGE_LIBNFC_PN53X_USB=y
BR2_PACKAGE_LIBFREEFARE=y

# Package patches this repo carries against upstream Buildroot packages
# (external/patches/packages/<pkg>/*.patch). Boards with patch
# directories of their own re-assign this symbol and prepend the same
# path - later fragments win, so a board assignment replaces this one.
BR2_GLOBAL_PATCH_DIR="@SWIFT_LINUX@/external/patches/packages"
