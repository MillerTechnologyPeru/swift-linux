# Core libraries
BR2_PACKAGE_ZLIB=y
BR2_PACKAGE_BZIP2=y
BR2_PACKAGE_DBUS=y
BR2_PACKAGE_SQLITE=y
BR2_PACKAGE_LIBEDIT=y
BR2_PACKAGE_LIBARCHIVE=y

# Swift Dependencies
BR2_PACKAGE_ICU=y
BR2_PACKAGE_LIBBSD=y
BR2_PACKAGE_LIBMD=y
BR2_PACKAGE_LIBXML2=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_LIBOPENSSL_ENGINES=y

# Package patches this repo carries against upstream Buildroot packages
# (external/patches/packages/<pkg>/*.patch). Boards with patch
# directories of their own re-assign this symbol and prepend the same
# path - later fragments win, so a board assignment replaces this one.
BR2_GLOBAL_PATCH_DIR="@SWIFT_LINUX@/external/patches/packages"
