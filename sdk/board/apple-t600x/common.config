# Shared board options for Apple Silicon M1 Pro/Max MacBook Pros (t6000/t6001).
#
# DEFINITION ONLY - not built or verified on hardware. A device board.config
# includes this and sets its device tree name.
#
# Boot chain: iBoot loads m1n1 (machine-resident stage 1, installed once by
# the platform installer) -> m1n1 stage 2 + device trees + U-Boot from the
# ESP -> standard UEFI -> GRUB arm64-efi. The GRUB A/B payload is the same
# bootaa64.efi used by the QEMU arm64 board; m1n1 and the U-Boot fork are
# shipped to the ESP by the installer/update scripts, not built here.

BR2_aarch64=y
# Apple Firestorm/Icestorm cores: no specific tune in Buildroot; generic armv8.

# The mainline kernel cannot drive this hardware usefully (no keyboard, no
# display controller); the downstream Apple Silicon tree is required. Pin its
# release tag; bump deliberately (it rebases quickly).
BR2_LINUX_KERNEL_CUSTOM_GIT=y
BR2_LINUX_KERNEL_CUSTOM_REPO_URL="https://github.com/AsahiLinux/linux.git"
BR2_LINUX_KERNEL_CUSTOM_REPO_VERSION="asahi-7.1.5-2"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="@SWIFT_LINUX@/sdk/board/apple-t600x/linux.fragment"
BR2_GLOBAL_PATCH_DIR="@SWIFT_LINUX@/sdk/board/apple-t600x/patches @BOARD@/patches"

# GPU acceleration deferred: the GPU kernel driver is written in Rust and this
# tree does not enable Rust kernel builds yet. The DCP display driver is C, so
# the compositor runs on the pixman software renderer meanwhile. Mesa >= 25.1
# carries the GL/Vulkan userspace upstream when the time comes.

# No 32-bit anything on Apple cores: AArch64-only silicon (no armv7 userland,
# and box86 - itself an armv7 binary - cannot run). 16K pages additionally
# break 4K-assuming x86 translation, so Steam/box64 are disabled here.
# BR2_PACKAGE_STEAM is not set
# BR2_PACKAGE_BOX64 is not set

# GRUB EFI payload for the ESP (same A/B design as the QEMU arm64 board).
BR2_TARGET_GRUB2_ARM64_EFI=y

# The loader chain ends in UEFI, so the GRUB A/B payload applies unchanged.
include sdk/defconfig/boot/uefi-ab.config
BR2_TARGET_GRUB2_ARM64_EFI=y
BR2_ROOTFS_POST_IMAGE_SCRIPT="@SWIFT_LINUX@/sdk/board/apple-t600x/post-image.sh"
BR2_TARGET_GENERIC_GETTY_PORT="tty1"
