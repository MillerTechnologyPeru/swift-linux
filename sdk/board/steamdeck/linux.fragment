# Valve Steam Deck kernel options.
#
# Mainline covers the Deck reasonably well; the vendor tree carries extra
# tuning. Anything not yet upstream belongs in this board's patches/ dir.

# AMD Van Gogh / Sephiroth APU
CONFIG_DRM=y
CONFIG_DRM_AMDGPU=y
CONFIG_DRM_AMDGPU_SI=y
CONFIG_DRM_AMDGPU_CIK=y
CONFIG_DRM_AMD_DC=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_AMD_PMC=y
CONFIG_AMD_PMF=y
CONFIG_X86_AMD_PSTATE=y

# Built-in controller, IMU and haptics (hid-steam covers the gamepad).
CONFIG_HID_STEAM=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_JOYSTICK=y
CONFIG_INPUT_FF_MEMLESS=y
CONFIG_JOYSTICK_XPAD=y
CONFIG_IIO=y
CONFIG_BMI160=y

# Audio: the Deck routes through SOF on the APU's ACP (Van Gogh), with the
# NAU8821 codec and Cirrus amplifiers. The SOF path additionally needs the
# amd/sof firmware and topology blobs, which Buildroot's linux-firmware does
# not package - see README.md.
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_SOF_TOPLEVEL=y
CONFIG_SND_SOC_SOF_AMD_TOPLEVEL=y
CONFIG_SND_SOC_SOF_AMD_VANGOGH=m
CONFIG_SND_SOC_AMD_ACP=y
CONFIG_SND_SOC_AMD_ACP5x=y
CONFIG_SND_SOC_CS35L41_SPI=y
CONFIG_SND_SOC_NAU8821=y
CONFIG_SND_HDA_INTEL=y

# Wi-Fi / Bluetooth (QCA6390 class)
CONFIG_ATH11K=m
CONFIG_ATH11K_PCI=m
CONFIG_BT_HCIBTUSB=m

# Storage: NVMe plus the microSD reader
CONFIG_BLK_DEV_NVME=y
CONFIG_MMC=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_EXT4_FS=y

# Power / thermal
CONFIG_ACPI=y
CONFIG_THERMAL=y
CONFIG_POWER_SUPPLY=y
