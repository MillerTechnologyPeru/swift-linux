# Valve Steam Deck (LCD "Jupiter" / OLED "Galileo").
#
# DEFINITION ONLY - not built or verified on hardware (see README.md).
#
# The Deck is an x86_64 PC that boots UEFI, so it reuses this tree's image
# profile, x86_64 architecture and GRUB EFI path unchanged. What it cannot
# share is the GPU stack: the QEMU boards use virgl specifically to avoid
# LLVM, while the Deck's Radeon APU needs radeonsi + RADV, which require it.
# That, plus a completely different set of kernel drivers, is why this is a
# board of its own rather than an option on the generic x86_64 image.
#
# This board.config is self-contained (it selects the architecture), so
# generate-config.sh --device steamdeck uses it in place of an arch fragment
# and the generic x86_64 board.

BR2_x86_64=y
# Zen 2 (Van Gogh) and Zen 2-derived (Sephiroth); x86-64-v3 covers both
# without pinning a microarchitecture Buildroot does not model.
BR2_x86_x86_64_v3=y

BR2_LINUX_KERNEL_USE_DEFCONFIG=y
BR2_LINUX_KERNEL_DEFCONFIG="x86_64"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="@SWIFT_LINUX@/sdk/board/common/linux-nfc.fragment @SWIFT_LINUX@/sdk/board/steamdeck/linux.fragment"
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_GLOBAL_PATCH_DIR="@SWIFT_LINUX@/external/patches/packages @SWIFT_LINUX@/sdk/board/steamdeck/patches"

# Radeon APU: radeonsi GL + RADV Vulkan (pulls in LLVM).
include sdk/defconfig/gpu/radeonsi.config

# UEFI, same A/B GRUB payload as the QEMU x86_64 board.
include sdk/defconfig/boot/uefi-ab.config
BR2_TARGET_GRUB2_X86_64_EFI=y

# Board overlay: hid_steam lizard_mode=0, so the controller presents a gamepad
# rather than emulating a keyboard and mouse.
BR2_ROOTFS_OVERLAY="@SWIFT_LINUX@/sdk/board/common/rootfs-overlay @SWIFT_LINUX@/sdk/board/steamdeck/rootfs-overlay"

# Console on the built-in panel.
BR2_TARGET_GENERIC_GETTY_PORT="tty1"
