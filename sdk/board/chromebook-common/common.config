# Shared board options for arm64 Chromebooks (Depthcharge verified boot).
#
# A Chromebook family fragment includes this and adds its CPU tune, GPU
# capability and kernel fragment; a device board.config includes the family
# and sets its device tree name.
#
# DEFINITION ONLY - not built or verified on hardware. Boot chain: the
# firmware's Depthcharge payload reads a ChromeOS *kernel partition* (cgpt
# GUID) containing a FIT image (kernel + device trees, matched by compatible
# string) signed with the public vboot devkeys - usable in developer mode.
# Slot A/B selection and fallback are native cgpt attributes (priority/tries/
# successful), so no GRUB and no U-Boot are involved.

BR2_aarch64=y
BR2_LINUX_KERNEL_DTS_SUPPORT=y

# Kernel configuration: the arm64 defconfig, which the family fragments and
# linux-cros.fragment then extend. image.config selects the kernel but no
# configuration source, and without one here the kernel has nothing to
# configure from - every Chromebook build stops at the first kernel step.
BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG=y

# A/B updates. Depthcharge already chooses between the two kernel partitions
# by their cgpt attributes; RAUC drives those attributes through the custom
# backend in the overlay (there is no ChromeOS backend upstream) and writes the
# inactive slot. cgpt is needed on the target, not just on the host, for that.
BR2_PACKAGE_RAUC=y
BR2_PACKAGE_LIBOPENSSL_ENGINES=y
BR2_PACKAGE_GPTFDISK=y
BR2_PACKAGE_GPTFDISK_SGDISK=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y

# Host tools for the kernel-partition image: mkimage (FIT), fdtget (per-DTB
# compatible strings), futility/cgpt + devkeys (signing and GPT attributes),
# sgdisk (GPT creation).
BR2_PACKAGE_HOST_UBOOT_TOOLS=y
BR2_PACKAGE_HOST_DTC=y
BR2_PACKAGE_HOST_VBOOT_UTILS=y
BR2_PACKAGE_HOST_GPTFDISK=y

# The Depthcharge image replaces the UEFI A/B disk of the QEMU boards.
BR2_ROOTFS_POST_IMAGE_SCRIPT="@SWIFT_LINUX@/sdk/board/chromebook-common/post-image.sh"

# Board overlay: RAUC's system.conf and the cgpt bootloader backend.
BR2_ROOTFS_OVERLAY="@SWIFT_LINUX@/sdk/board/common/rootfs-overlay @SWIFT_LINUX@/sdk/board/chromebook-common/rootfs-overlay"

# ChromeOS embedded controller: keyboard, battery, sensors - without these a
# Chromebook has no input. Shared across every family via a second kernel
# fragment (families append their own).
BR2_TARGET_GENERIC_GETTY_PORT="tty1"

# Audio routing: the community Chromebook UCM profiles (without them the
# speakers/mics do not route outside ChromeOS), and the SOF firmware for
# the DSP-routed boards (the MT8183 ADSP among them).
BR2_PACKAGE_CHROMEBOOK_UCM_CONF=y
BR2_PACKAGE_SOUND_OPEN_FIRMWARE=y

# Bluetooth firmware for the BCM combo radios most ARM Chromebooks carry.
BR2_PACKAGE_BROADCOM_BT_FIRMWARE=y
