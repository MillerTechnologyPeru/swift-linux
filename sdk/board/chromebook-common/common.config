# Shared board options for arm64 Chromebooks (Depthcharge verified boot).
#
# A Chromebook family fragment includes this and adds its CPU tune, GPU
# capability and kernel fragment; a device board.config includes the family
# and sets its device tree name.
#
# DEFINITION ONLY - not built or verified on hardware. Boot chain: the
# firmware's Depthcharge payload reads a ChromeOS *kernel partition* (cgpt
# GUID) containing a FIT image (kernel + device trees, matched by compatible
# string) signed with the public vboot devkeys - usable in developer mode.
# Slot A/B selection and fallback are native cgpt attributes (priority/tries/
# successful), so no GRUB and no U-Boot are involved.

BR2_aarch64=y
BR2_LINUX_KERNEL_DTS_SUPPORT=y

# Host tools for the kernel-partition image: mkimage (FIT), fdtget (per-DTB
# compatible strings), futility/cgpt + devkeys (signing and GPT attributes),
# sgdisk (GPT creation).
BR2_PACKAGE_HOST_UBOOT_TOOLS=y
BR2_PACKAGE_HOST_DTC=y
BR2_PACKAGE_HOST_VBOOT_UTILS=y
BR2_PACKAGE_HOST_GPTFDISK=y

# The Depthcharge image replaces the UEFI A/B disk of the QEMU boards.
BR2_ROOTFS_POST_IMAGE_SCRIPT="@SWIFT_LINUX@/sdk/board/chromebook-common/post-image.sh"

# ChromeOS embedded controller: keyboard, battery, sensors - without these a
# Chromebook has no input. Shared across every family via a second kernel
# fragment (families append their own).
BR2_TARGET_GENERIC_GETTY_PORT="tty1"
