#!/bin/sh
# Install the running system onto the Chromebook's internal storage.
#
#   chromebook-install [--yes]
#
# Boot this image from USB or SD, run this, reboot without the medium.
# There is no download and no second image: the rootfs that gets written
# is the one currently running, copied partition-for-partition, so what
# you tested from the removable medium is exactly what lands internally.
#
# The shape of the install - Depthcharge detection, the battery refusal,
# finding the eMMC by its boot0 sibling, and the ChromeOS kernel
# partition layout - follows the approach the Cadmium installer uses for
# Chromebooks (https://github.com/Maccraft123/Cadmium).
#
# Slot attributes are driven with sgdisk rather than cgpt: Buildroot
# builds cgpt for the host only, and the RAUC backend on this image
# already manipulates the same bits that way (see /usr/lib/rauc/cgpt-backend).
#
# DESTRUCTIVE: everything on the internal disk is erased, ChromeOS
# included.

set -e

CROS_KERNEL_TYPE=FE3A2A5D-4F32-41A7-B725-ACCC3285A309
LINUX_DATA_TYPE=0FC63DAF-8483-4772-8E79-3D69D8477DE4
DATA_PARTUUID=0d0d0d0d-0000-4000-8000-00000000000d

# The image's layout, which the installer reproduces so the signed
# kernels keep working: the cmdline says root=PARTUUID=%U/PARTNROFF=2,
# i.e. "two partitions after the kernel I booted from" - addressing is
# relative, so partition ORDER is what matters, not any fixed UUID.
KERN_A_START=8192
KERN_SECTORS=65536
KERN_B_START=73728
ROOT_START=139264

say() { printf '%s\n' "$*"; }
die() { printf 'chromebook-install: %s\n' "$*" >&2; exit 1; }

[ "$(id -u)" = 0 ] || die "must run as root"

for t in sgdisk blkid findmnt lsblk mkfs.ext4; do
	command -v "$t" >/dev/null 2>&1 || die "missing required tool: $t"
done

# 1. Firmware. Depthcharge puts cros_secure on the kernel command line;
#    without it this is not a Chromebook boot path and the kernel
#    partition layout below would mean nothing.
grep -qs cros_secure /proc/cmdline || \
	die "no cros_secure on the command line - this is not a Depthcharge boot"

# 2. Battery. A machine that dies midway through leaves neither system
#    bootable, so refuse below 30% unless it is on AC.
bat=""
for p in /sys/class/power_supply/*; do
	[ -r "$p/capacity" ] || continue
	case "$(cat "$p/type" 2>/dev/null)" in Battery) bat="$p"; break ;; esac
done
ac=0
for p in /sys/class/power_supply/*; do
	[ -r "$p/online" ] || continue
	case "$(cat "$p/type" 2>/dev/null)" in
		Mains|USB) [ "$(cat "$p/online")" = 1 ] && ac=1 ;;
	esac
done
if [ -n "$bat" ]; then
	cap=$(cat "$bat/capacity")
	if [ "$cap" -le 30 ] && [ "$ac" = 0 ]; then
		die "battery at ${cap}% and not charging - plug in first"
	fi
	say "Battery: ${cap}%$( [ "$ac" = 1 ] && echo ', charging')"
else
	say "Battery: not detected (continuing)"
fi

# 3. Where we are running from, and where we are installing to.
root_src=$(findmnt -no SOURCE / 2>/dev/null) || die "cannot find the root device"
case "$root_src" in
	/dev/*) ;;
	*) root_src=$(blkid -l -o device -t "$root_src" 2>/dev/null) || \
		die "cannot resolve the root device" ;;
esac
src_disk="/dev/$(lsblk -no pkname "$root_src" | head -1)"
[ -b "$src_disk" ] || die "cannot determine the disk we booted from"

# The eMMC is the mmcblk device that has a boot0 sibling; SD cards and
# USB sticks do not.
int_disk=""
for b in /dev/mmcblk*boot0; do
	[ -e "$b" ] || continue
	int_disk="${b%boot0}"
	break
done
[ -n "$int_disk" ] || {
	for n in /dev/nvme0n1; do [ -b "$n" ] && int_disk="$n"; done
}
[ -b "$int_disk" ] || die "no internal eMMC or NVMe found"

if [ "$int_disk" = "$src_disk" ]; then
	die "already running from the internal disk ($int_disk) - nothing to do"
fi

part() { # <disk> <n>  - mmcblk/nvme need the p separator
	case "$1" in
		*[0-9]) echo "$1p$2" ;;
		*) echo "$1$2" ;;
	esac
}

src_root_sectors=$(blockdev --getsz "$root_src")
int_sectors=$(blockdev --getsz "$int_disk")
need=$(( ROOT_START + 2 * src_root_sectors + 2048 ))
[ "$int_sectors" -gt "$need" ] || \
	die "internal disk is too small (needs $need sectors, has $int_sectors)"

src_kern=$(part "$src_disk" 1)
[ -b "$src_kern" ] || die "no kernel partition on $src_disk"

say ""
say "Source (running):   $src_disk  root $root_src"
say "Destination:        $int_disk  ($(( int_sectors / 2 / 1024 )) MiB)"
say ""
say "This ERASES the internal disk completely, ChromeOS included."
if [ "${1:-}" != "--yes" ]; then
	printf 'Type INSTALL to continue: '
	read -r reply
	[ "$reply" = INSTALL ] || die "aborted"
fi

# 4. Partition. Same order as the image: KERN-A, KERN-B, ROOT-A, ROOT-B,
#    then a data partition over the rest of the disk - which the image
#    itself has no room for, and which is where /data lives.
say "Partitioning $int_disk ..."
root_b_start=$(( ROOT_START + src_root_sectors ))
data_start=$(( root_b_start + src_root_sectors ))

sgdisk --zap-all "$int_disk" >/dev/null 2>&1 || true
sgdisk \
	-n 1:${KERN_A_START}:+${KERN_SECTORS} -t 1:${CROS_KERNEL_TYPE} -c 1:KERN-A \
	-n 2:${KERN_B_START}:+${KERN_SECTORS} -t 2:${CROS_KERNEL_TYPE} -c 2:KERN-B \
	-n 3:${ROOT_START}:+${src_root_sectors} -t 3:${LINUX_DATA_TYPE} -c 3:ROOT-A \
	-n 4:${root_b_start}:+${src_root_sectors} -t 4:${LINUX_DATA_TYPE} -c 4:ROOT-B \
	-n 5:${data_start}:0 -t 5:${LINUX_DATA_TYPE} -c 5:data -u 5:${DATA_PARTUUID} \
	"$int_disk" >/dev/null

partx -u "$int_disk" >/dev/null 2>&1 || partprobe "$int_disk" >/dev/null 2>&1 || true
sleep 1

# 5. Copy. The kernel partition goes to both slots so either can boot,
#    and the running rootfs is copied byte-for-byte into slot A - it is
#    mounted read-only, so it is quiescent and the copy is exact. Slot B
#    is left empty for RAUC to fill on the first update, as in the image.
say "Writing kernel to both slots ..."
dd if="$src_kern" of="$(part "$int_disk" 1)" bs=1M conv=fsync status=none
dd if="$src_kern" of="$(part "$int_disk" 2)" bs=1M conv=fsync status=none

say "Copying the running rootfs to slot A (this takes a while) ..."
dd if="$root_src" of="$(part "$int_disk" 3)" bs=4M conv=fsync status=none

say "Creating the data partition ..."
mkfs.ext4 -q -F -L data "$(part "$int_disk" 5)" </dev/null

# 6. Slot attributes, the bits Depthcharge chooses on: priority 48-51,
#    tries 52-55, successful 56. A wins and is already proven; B is a
#    lower-priority fallback until RAUC installs something there.
set_attr() { # <partnum> <priority> <tries> <successful>
	v=$(( ($2 << 48) | ($3 << 52) | ($4 << 56) ))
	sgdisk --attributes="$1":=:$(printf '%016X' "$v") "$int_disk" >/dev/null
}
set_attr 1 10 2 1
set_attr 2 5 2 0

sync
say ""
say "Done. Remove the boot medium and reboot."
say "The internal system carries its own A/B slots; RAUC updates slot B"
say "and raises its priority from there."
