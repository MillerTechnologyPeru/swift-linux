# Powkiddy X55 (Rockchip RK3566 / quad Cortex-A55, 5.5" 1280x720 panel).
#
# Everything shared - kernel, patch sets, U-Boot, the card layout - lives in
# the family fragment; this board adds its device tree, which mainline
# carries (upstream only patches it). U-Boot is the family's: upstream boots
# the X55 with the Quartz64-A configuration rather than the RGxx3 board code.

include sdk/board/rockchip-rk3566/common.config

BR2_LINUX_KERNEL_INTREE_DTS_NAME="rockchip/rk3566-powkiddy-x55"
