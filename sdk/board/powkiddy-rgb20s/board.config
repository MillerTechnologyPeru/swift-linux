# Powkiddy RGB20S (Rockchip RK3326 / quad Cortex-A35).
#
# DEFINITION ONLY - not built or verified (see README.md). Shared Rockchip RK3326 / quad Cortex-A35 options
# live in the family fragment; this board adds its device tree name.

include sdk/board/rockchip-rk3326/common.config

BR2_LINUX_KERNEL_INTREE_DTS_NAME="rk3326-powkiddy-rgb20s"

# U-Boot board defconfig (verify against the U-Boot version in use).
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="rk3326-handheld"
