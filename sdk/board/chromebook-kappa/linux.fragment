# HP Chromebook 11a (kappa), and the jacuzzi sub-baseboard generally.
#
# The kukui tablets drive a DSI panel directly (DRM_PANEL_BOE_TV101WUM_NL6 in
# the family fragment); jacuzzi puts an Analogix ANX7625 DSI-to-eDP bridge in
# front of a generic eDP panel instead, so without these the display never
# lights up. Compatible strings are in mainline's mt8183-kukui-jacuzzi.dtsi.
# TYPEC is here because anx7625 depends on it, and a modular TYPEC caps the
# bridge at a module however plainly this asks for it to be built in - which
# is what happened, and left the panel dark until userspace loaded it.
CONFIG_TYPEC=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_DRM_ANALOGIX_ANX7625=y
CONFIG_DRM_PANEL_EDP=y

# Elan touchscreen (elan,ekth3500) and I2C trackpad (elan,ekth3000).
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_ELAN=y
CONFIG_MOUSE_ELAN_I2C=y
CONFIG_MOUSE_ELAN_I2C_I2C=y

# Backlight: the jacuzzi boards drive it from the embedded controller
# (google,cros-ec-pwm in the device tree), not from the SoC's display PWM,
# so this is what makes the brightness keys do anything.
CONFIG_PWM_CROS_EC=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
