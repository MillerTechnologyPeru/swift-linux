# HP Chromebook 11a (kappa)
#
# MediaTek MT8183 kukui, jacuzzi sub-baseboard. See
# sdk/board/chromebook-common/README.md for the Depthcharge boot chain.

include sdk/board/chromebook-mt8183/common.config

BR2_LINUX_KERNEL_INTREE_DTS_NAME="mediatek/mt8183-kukui-jacuzzi-kappa"

# The jacuzzi boards reach their panel through an Analogix bridge rather than
# driving a DSI panel directly like the kukui tablets, and they have a
# trackpad; the board fragment adds that hardware on top of the family's.
# Reassigned rather than appended because a defconfig has no += - the family's
# two fragments are repeated here deliberately (later assignment wins).
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="@SWIFT_LINUX@/sdk/board/common/linux-nfc.fragment @SWIFT_LINUX@/sdk/board/chromebook-common/linux-cros.fragment @SWIFT_LINUX@/sdk/board/chromebook-mt8183/linux.fragment @BOARD@/linux.fragment"
