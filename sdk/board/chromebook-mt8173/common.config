# Shared board options for MediaTek MT8173 (2x A72 + 2x A53) Chromebooks.
#
# DEFINITION ONLY - see sdk/board/chromebook-common/README.md for the
# Depthcharge boot chain. A device board.config includes this and sets its
# device tree name.

include sdk/board/chromebook-common/common.config

BR2_cortex_a72_a53=y

BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="@SWIFT_LINUX@/sdk/board/chromebook-common/linux-cros.fragment @SWIFT_LINUX@/sdk/board/chromebook-mt8173/linux.fragment"
# No BR2_LINUX_KERNEL_CUSTOM_DTS_DIR: every board in this family names a
# mainline in-tree device tree (BR2_LINUX_KERNEL_INTREE_DTS_NAME), and
# pointing the option at a directory that does not exist fails the build.
BR2_GLOBAL_PATCH_DIR="@SWIFT_LINUX@/external/patches/packages @SWIFT_LINUX@/sdk/board/chromebook-mt8173/patches @BOARD@/patches"

# PowerVR GX6250: no mainline GPU driver - display is
# unaccelerated (DRM scanout only). No GPU capability fragment.
