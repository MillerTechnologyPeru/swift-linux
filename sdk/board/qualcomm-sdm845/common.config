# Shared board options for Qualcomm SDM845 / Snapdragon 845 phones.
#
# The best-mainlined Android SoC: the device trees below are in the mainline
# kernel and the Adreno 630 works with freedreno/turnip. A device board.config
# includes this and sets its device tree name.
#
# DEFINITION ONLY - not built or verified on hardware. Boot: the Android
# bootloader (ABL) loads a boot.img (gzipped kernel + appended DTB) flashed
# with fastboot; these phones use Android A/B slots (boot_a/boot_b), so slot
# fallback is firmware-level. The rootfs lives on the userdata partition.
# post-image.sh assembles boot.img with the host abootimg tool.

BR2_aarch64=y
# Kryo 385: 4x A75-class + 4x A55-class.
BR2_cortex_a75_a55=y

BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="@SWIFT_LINUX@/sdk/board/qualcomm-sdm845/linux.fragment"
BR2_LINUX_KERNEL_CUSTOM_DTS_DIR="@SWIFT_LINUX@/sdk/board/qualcomm-sdm845/dts"
BR2_GLOBAL_PATCH_DIR="@SWIFT_LINUX@/external/patches/packages @SWIFT_LINUX@/sdk/board/qualcomm-sdm845/patches @BOARD@/patches"

# Adreno 630: freedreno GL/GLES + turnip Vulkan.
include sdk/defconfig/gpu/freedreno.config

# boot.img assembly + fastboot flashing from the host.
BR2_PACKAGE_HOST_ABOOTIMG=y
BR2_PACKAGE_HOST_ANDROID_TOOLS=y
BR2_PACKAGE_HOST_ANDROID_TOOLS_FASTBOOT=y
BR2_ROOTFS_POST_IMAGE_SCRIPT="@SWIFT_LINUX@/sdk/board/qualcomm-sdm845/post-image.sh"

# Panel console.
BR2_TARGET_GENERIC_GETTY_PORT="tty0"

# Soldered Qualcomm radio: wifi from the ath firmware groups plus its
# qca Bluetooth half (see external/package/firmware-extra).
BR2_PACKAGE_FIRMWARE_EXTRA=y
BR2_PACKAGE_FIRMWARE_EXTRA_ATH_SOC=y
BR2_PACKAGE_FIRMWARE_EXTRA_QCA_BT=y

# Cellular. These are phones, and the modem is the one piece of them that
# nothing else in the image knows how to drive. Here rather than in
# daemons.config because every other board this repo builds is a handheld
# or a laptop with no modem at all, and this pulls in libqmi, libqrtr-glib
# and their D-Bus services.
#
# QRTR, not MBIM: on SDM845 the modem is not a USB device but a remote
# processor on the SoC, reached over Qualcomm's IPC Router (QRTR) rather
# than a CDC interface. QMI is the protocol spoken over it - selecting
# QRTR support pulls libqrtr-glib and turns QMI on with it. MBIM is for
# the standards-compliant USB dongles these are not.
#
# NetworkManager (network.config) drives ModemManager over D-Bus, so the
# connection side needs nothing further here.
BR2_PACKAGE_MODEM_MANAGER=y
BR2_PACKAGE_MODEM_MANAGER_LIBQRTR=y

# pppd for the fallback path. A QMI modem normally hands over a raw IP
# interface that NetworkManager configures directly, with no PPP anywhere -
# but a modem that only offers a serial AT interface still needs a PPP
# session, and ModemManager expects to find pppd when it takes that route.
BR2_PACKAGE_PPPD=y
