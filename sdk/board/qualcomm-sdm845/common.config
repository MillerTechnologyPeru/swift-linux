# Shared board options for Qualcomm SDM845 / Snapdragon 845 phones.
#
# The best-mainlined Android SoC: the device trees below are in the mainline
# kernel and the Adreno 630 works with freedreno/turnip. A device board.config
# includes this and sets its device tree name.
#
# DEFINITION ONLY - not built or verified on hardware. Boot: the Android
# bootloader (ABL) loads a boot.img (gzipped kernel + appended DTB) flashed
# with fastboot; these phones use Android A/B slots (boot_a/boot_b), so slot
# fallback is firmware-level. The rootfs lives on the userdata partition.
# post-image.sh assembles boot.img with the host abootimg tool.

BR2_aarch64=y
# Kryo 385: 4x A75-class + 4x A55-class.
BR2_cortex_a75_a55=y

BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="@SWIFT_LINUX@/sdk/board/qualcomm-sdm845/linux.fragment"
BR2_LINUX_KERNEL_CUSTOM_DTS_PATH="@SWIFT_LINUX@/sdk/board/qualcomm-sdm845/dts"
BR2_GLOBAL_PATCH_DIR="@SWIFT_LINUX@/sdk/board/qualcomm-sdm845/patches @BOARD@/patches"

# Adreno 630: freedreno GL/GLES + turnip Vulkan.
include sdk/defconfig/gpu/freedreno.config

# boot.img assembly + fastboot flashing from the host.
BR2_PACKAGE_HOST_ABOOTIMG=y
BR2_PACKAGE_HOST_ANDROID_TOOLS=y
BR2_PACKAGE_HOST_ANDROID_TOOLS_FASTBOOT=y
BR2_ROOTFS_POST_IMAGE_SCRIPT="@SWIFT_LINUX@/sdk/board/qualcomm-sdm845/post-image.sh"

# Panel console.
BR2_TARGET_GENERIC_GETTY_PORT="tty0"
