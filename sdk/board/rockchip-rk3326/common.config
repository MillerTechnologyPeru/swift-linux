# Shared board options for Rockchip RK3326 (quad Cortex-A35, Mali-G31) handhelds.
#
# A device board.config includes this and adds its device tree name:
#
#     include sdk/board/rockchip-rk3326/common.config
#     BR2_LINUX_KERNEL_INTREE_DTS_NAME="..."
#
# The kernel (version, config, patches, device trees, joypad driver) and the
# bootloader (U-Boot, rkbin loader, SD-card layout) follow upstream - see
# patches/README.md. Booted on an R35S (gameconsole-r36s); the other boards
# are checked to build only.

BR2_aarch64=y
BR2_cortex_a35=y

BR2_LINUX_KERNEL_DTS_SUPPORT=y

# The RK3326 kernel config, imported whole from ROCKNIX rather than expressed
# as a fragment on top of arm64 "defconfig", as for qualcomm-sm8250: the patch
# set below was developed against exactly this config, and it selects the
# panel, joypad, charger and PX30S drivers those patches add. It is kept
# byte-identical to its source; linux.fragment only fills in the two
# placeholders ROCKNIX's build substitutes.
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="@SWIFT_LINUX@/sdk/board/rockchip-rk3326/linux.aarch64.conf"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="@SWIFT_LINUX@/sdk/board/common/linux-nfc.fragment @SWIFT_LINUX@/sdk/board/rockchip-rk3326/linux.fragment"
BR2_LINUX_KERNEL_CUSTOM_DTS_DIR="@SWIFT_LINUX@/sdk/board/rockchip-rk3326/dts"
# Kernel patches in the order ROCKNIX applies them to this device: its
# mainline set, the RK3326 device set, the Rockchip rk817 charger fixes,
# then the 7.0-series fixes (see patches/README.md).
BR2_GLOBAL_PATCH_DIR="@SWIFT_LINUX@/external/patches/packages @SWIFT_LINUX@/sdk/board/rockchip-rk3326/patches-mainline @SWIFT_LINUX@/sdk/board/rockchip-rk3326/patches @SWIFT_LINUX@/sdk/board/rockchip-rk3326/patches-mainline-rockchip @SWIFT_LINUX@/sdk/board/rockchip-rk3326/patches-7.0 @BOARD@/patches"

# Gamepad controls. The R33S/R36S family's device trees bind
# rocknix-singleadc-joypad, which is not in the kernel patch set but in
# this out-of-tree module.
BR2_PACKAGE_ROCKNIX_JOYPAD=y

include sdk/defconfig/gpu/panfrost.config

BR2_TARGET_GENERIC_GETTY_PORT="tty0"

# Boot: U-Boot v2025.10 + extlinux from the SD card, as upstream boots these
# devices (see patches/README.md). U-Boot only builds u-boot-dtb.bin here;
# rk3326-loader packs it with Rockchip's DDR init, miniloader and BL31 into
# the image written at sector 64, because mainline U-Boot cannot pack its own
# second-stage loader for this SoC. Every RK3326 board uses the same U-Boot
# defconfig, added by patches/uboot/.
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_BUILD_SYSTEM_KCONFIG=y
BR2_TARGET_UBOOT_CUSTOM_VERSION=y
BR2_TARGET_UBOOT_CUSTOM_VERSION_VALUE="2025.10"
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="rk3326-handheld"
BR2_TARGET_UBOOT_CONFIG_FRAGMENT_FILES="@SWIFT_LINUX@/sdk/board/rockchip-rk3326/uboot.fragment"
BR2_TARGET_UBOOT_NEEDS_DTC=y
BR2_TARGET_UBOOT_NEEDS_PYLIBFDT=y
BR2_TARGET_UBOOT_NEEDS_PYELFTOOLS=y
BR2_TARGET_UBOOT_FORMAT_DTB_BIN=y
# "all" also has binman assemble u-boot-rockchip.bin, the mainline SPL image,
# which wants a BL31 this boot chain does not give it. That image is unused,
# so let binman finish without the blob instead of failing the build.
BR2_TARGET_UBOOT_CUSTOM_MAKEOPTS="BINMAN_ALLOW_MISSING=1"
BR2_PACKAGE_RK3326_LOADER=y

# SD-card image: loader at sector 64, then a GPT with boot, root-a/root-b and
# data at the partition UUIDs every image here uses. No GRUB, no UEFI.
BR2_ROOTFS_POST_IMAGE_SCRIPT="@SWIFT_LINUX@/sdk/board/rockchip-rk3326/post-image.sh"

# Kernel pinned to the version the imported patch set targets (see
# patches/README.md); the image default of "latest" would not take the
# patches.
# BR2_LINUX_KERNEL_LATEST_VERSION is not set
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="7.1.2"

# Radio/SoC blobs the mainline linux-firmware set does not carry.
BR2_PACKAGE_FIRMWARE_ARMBIAN=y

# Bluetooth halves of the BCM/AP6xxx combo radios.
BR2_PACKAGE_BROADCOM_BT_FIRMWARE=y
