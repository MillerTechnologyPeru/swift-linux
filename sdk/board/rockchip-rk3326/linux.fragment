# Applied on top of linux.aarch64.conf, which is ROCKNIX's RK3326 config kept
# byte-identical. ROCKNIX's build substitutes these two placeholders; left
# as they are, the kernel would look for an initramfs source file literally
# named "@INITRAMFS_SOURCE@". This repo ships its initramfs separately
# (swift-initramfs), so the kernel embeds none.
CONFIG_INITRAMFS_SOURCE=""
CONFIG_DEFAULT_HOSTNAME="(none)"
