# BittBoy (Allwinner suniv "F1C" family, ARM926EJ-S / armv5te, 32-64 MB RAM).
#
# DEFINITION ONLY - not built or verified in this repo (see README.md). The
# MiyooCFW-family handheld: kernel and U-Boot come from the MiyooCFW project
# (https://github.com/MiyooCFW), whose single miyoo_defconfig covers the
# BittBoy/PocketGo/PowKiddy V90-Q90 boards. Pin both repos to release tags
# before a real build; master is referenced here as the starting point.
#
# Revisions: covers BittBoy 2 through 3.5 - the per-revision differences
# (panels, the v2 button scan codes, rumble on v3, and the v3 change from
# F1C500s to F1C100s - same suniv/ARM926 core) are handled at runtime by
# MiyooCFW's kernel/U-Boot, which this board consumes wholesale. BittBoy 1
# needs hardware modification even under MiyooCFW, and is out of scope.
# PocketGo/PowKiddy Q90-V90-Q20 are separate devices: sibling board.configs
# sharing this kernel/U-Boot/frontend, once someone owns one to verify.
#
# No GPU of any kind, so this board is the reference user of the gmenu2x
# framebuffer frontend - the include below unwinds the default
# EmulationStation/sway stack (board fragments are emitted last and later
# assignments win).
#
# Self-contained (it selects the architecture itself), so
# generate-config.sh --device bittboy uses it in place of an arch fragment.

# ARM926EJ-S (armv5te). EABI, no VFP: the F1C100s has no FPU, so soft-float.
BR2_arm=y
BR2_arm926t=y
BR2_ARM_EABI=y
BR2_ARM_SOFT_FLOAT=y

# MiyooCFW kernel (5.15-era suniv tree with the Miyoo boards' DTS/drivers).
BR2_LINUX_KERNEL_CUSTOM_GIT=y
BR2_LINUX_KERNEL_CUSTOM_REPO_URL="https://github.com/MiyooCFW/kernel.git"
BR2_LINUX_KERNEL_CUSTOM_REPO_VERSION="master"
BR2_LINUX_KERNEL_DEFCONFIG="miyoo"

# MiyooCFW U-Boot for the F1C100s SD-card boot chain (boot0 + SPL). Not
# UEFI: the uefi-ab fragment does not apply to this board.
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_BUILD_SYSTEM_KCONFIG=y
BR2_TARGET_UBOOT_CUSTOM_GIT=y
BR2_TARGET_UBOOT_CUSTOM_REPO_URL="https://github.com/MiyooCFW/uboot.git"
BR2_TARGET_UBOOT_CUSTOM_REPO_VERSION="master"
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="miyoo"

# Serial console on the F1C100s UART (pads); the panel is the frontend's.
BR2_TARGET_GENERIC_GETTY_PORT="ttyS0"

# Frontend: gmenu2x on the framebuffer (no GL(ES) on this SoC).
include sdk/defconfig/frontend/gmenu2x.config

# 32-64 MB of RAM: drop the image baseline's heavyweight optional stacks.
# The GL/desktop graphics baseline goes with the frontend switch; the
# container runtime is unusable at this scale.
# BR2_PACKAGE_PODMAN is not set
# BR2_PACKAGE_CRUN is not set
# BR2_PACKAGE_PASST is not set
# BR2_PACKAGE_MESA3D is not set
# BR2_PACKAGE_XWAYLAND is not set
# BR2_PACKAGE_XORG7 is not set
# BR2_PACKAGE_SDL3 is not set
# BR2_PACKAGE_VULKAN_LOADER is not set
# BR2_PACKAGE_VULKAN_TOOLS is not set
