# Retroid Pocket Flip 2 (Qualcomm Snapdragon 865 / SM8250, aarch64).
#
# DEFINITION ONLY - this board is not built or verified in this repo (see
# README.md). A real build additionally needs a Qualcomm SM8250 kernel with
# the SM8250 patch set and the device tree; Buildroot's mainline kernel and
# mesa do not carry them. The options below are the parts Buildroot can
# express so the target is described in the tree.
#
# This board.config is self-contained (it selects the architecture itself),
# so generate-config.sh --device retroid-pocket-flip2 uses it in place of an
# arch fragment + the generic arm64 board.

# Snapdragon 865: 1x Cortex-A77 + 3x A77 + 4x A55, tuned as A76.A55 (as
# is typical for SM8250).
BR2_aarch64=y
BR2_cortex_a76_a55=y

# Build the device tree into the kernel. The DTS itself must come from a
# Qualcomm SM8250 kernel (see README.md): qcom/sm8250-retroidpocket-flip2.dts
# plus sm8250-retroidpocket-common.dtsi.
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="qcom/sm8250-retroidpocket-flip2"

# Adreno 650 GPU: freedreno gallium driver for OpenGL/GLES and the freedreno
# Vulkan driver (turnip). No LLVM needed. The Vulkan driver requires the mesa3d
# change carried in external/patches/buildroot (Buildroot 2026.05 stock has
# freedreno GL but no freedreno Vulkan - see README.md).
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_FREEDRENO=y
BR2_PACKAGE_MESA3D_VULKAN_DRIVER_FREEDRENO=y
BR2_PACKAGE_VULKAN_LOADER=y
# vulkaninfo, to confirm the turnip ICD loads on the device.
BR2_PACKAGE_VULKAN_TOOLS=y

# Bootloader: these devices boot via UEFI (arm-efi), chainloaded from the
# Qualcomm/Android bootloader, so the same GRUB arm64-efi path as the QEMU
# virt board (bootaa64.efi).
BR2_TARGET_GRUB2_ARM64_EFI=y

# Console on the built-in panel (fbcon); the GENI serial is only on test pads.
BR2_TARGET_GENERIC_GETTY_PORT="tty0"
