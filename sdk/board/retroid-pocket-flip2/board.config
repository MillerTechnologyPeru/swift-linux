# Retroid Pocket Flip 2 (Qualcomm Snapdragon 865 / SM8250, aarch64).
#
# DEFINITION ONLY - not built or verified in this repo (see README.md). The
# shared SM8250 options (CPU, Adreno/freedreno, Vulkan, GRUB, kernel fragment)
# live in the common fragment; only the device tree name is board-specific.
#
# Self-contained (it selects the architecture itself), so
# generate-config.sh --device retroid-pocket-flip2 uses it in place of an arch
# fragment + the generic arm64 board.

include sdk/board/qualcomm-sm8250/common.config

# Device tree: qcom/sm8250-retroidpocket-flip2.dts (from an SM8250 kernel).
BR2_LINUX_KERNEL_INTREE_DTS_NAME="qcom/sm8250-retroidpocket-flip2"
