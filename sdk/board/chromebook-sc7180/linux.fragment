# Qualcomm SC7180 (trogdor) Chromebooks.
CONFIG_ARCH_QCOM=y
CONFIG_PINCTRL_SC7180=y
CONFIG_QCOM_SCM=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_RPMH=y
CONFIG_ARM_QCOM_CPUFREQ_HW=y
CONFIG_DRM=y
CONFIG_DRM_MSM=y
CONFIG_DRM_MSM_DSI=y
CONFIG_ATH10K=y
CONFIG_ATH10K_SNOC=y
CONFIG_QCOM_Q6V5_MSS=y
CONFIG_QCOM_RMTFS_MEM=y
CONFIG_MMC=y
CONFIG_MMC_SDHCI_MSM=y
CONFIG_I2C_QCOM_GENI=y
CONFIG_SPI_QCOM_GENI=y
# The DSI controller's refgen supply: since 7.x the trogdor device tree
# names it, and without the regulator DSI defers forever, leaving the panel
# (behind its eDP bridge) black. Built in so it is there before DSI probes.
CONFIG_REGULATOR_QCOM_REFGEN=y
