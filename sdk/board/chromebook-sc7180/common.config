# Shared board options for Qualcomm SC7180 (Kryo 468, Adreno 618) Chromebooks.
#
# DEFINITION ONLY - see sdk/board/chromebook-common/README.md for the
# Depthcharge boot chain. A device board.config includes this and sets its
# device tree name.

include sdk/board/chromebook-common/common.config

BR2_cortex_a76_a55=y

BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="@SWIFT_LINUX@/sdk/board/common/linux-nfc.fragment @SWIFT_LINUX@/sdk/board/chromebook-common/linux-cros.fragment @SWIFT_LINUX@/sdk/board/chromebook-sc7180/linux.fragment"
# No BR2_LINUX_KERNEL_CUSTOM_DTS_DIR: every board in this family names a
# mainline in-tree device tree (BR2_LINUX_KERNEL_INTREE_DTS_NAME), and
# pointing the option at a directory that does not exist fails the build.
BR2_GLOBAL_PATCH_DIR="@SWIFT_LINUX@/external/patches/packages @SWIFT_LINUX@/sdk/board/chromebook-sc7180/patches @BOARD@/patches"

# Adreno 618 via freedreno GL/GLES + turnip Vulkan.
include sdk/defconfig/gpu/freedreno.config

# Soldered Qualcomm radio: wifi from the ath firmware groups plus its
# qca Bluetooth half (see external/package/firmware-extra).
BR2_PACKAGE_FIRMWARE_EXTRA=y
BR2_PACKAGE_FIRMWARE_EXTRA_ATH_SOC=y
BR2_PACKAGE_FIRMWARE_EXTRA_QCA_BT=y
