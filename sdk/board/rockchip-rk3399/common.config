# Shared board options for Rockchip RK3399 (2x A72 + 4x A53, Mali-T860) handhelds.
#
# A device board.config includes this and adds its device tree name (and,
# where U-Boot applies, its U-Boot defconfig):
#
#     include sdk/board/rockchip-rk3399/common.config
#     BR2_LINUX_KERNEL_INTREE_DTS_NAME="..."
#
# DEFINITION ONLY - not built or verified. A real build needs a kernel with
# these devices' DTS and driver patches (see patches/README.md).

BR2_aarch64=y
BR2_cortex_a72_a53=y

BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="@SWIFT_LINUX@/sdk/board/common/linux-nfc.fragment @SWIFT_LINUX@/sdk/board/rockchip-rk3399/linux.fragment"
BR2_LINUX_KERNEL_CUSTOM_DTS_DIR="@SWIFT_LINUX@/sdk/board/rockchip-rk3399/dts"
BR2_GLOBAL_PATCH_DIR="@SWIFT_LINUX@/external/patches/packages @SWIFT_LINUX@/sdk/board/rockchip-rk3399/patches @BOARD@/patches"

include sdk/defconfig/gpu/panfrost.config

BR2_TARGET_GENERIC_GETTY_PORT="tty0"

# Boot: U-Boot + extlinux from SD/eMMC (device board.config sets the U-Boot
# defconfig).
BR2_TARGET_ARM_TRUSTED_FIRMWARE=y
BR2_TARGET_ARM_TRUSTED_FIRMWARE_PLATFORM="rk3399"
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_BUILD_SYSTEM_KCONFIG=y
BR2_TARGET_UBOOT_NEEDS_DTC=y
BR2_TARGET_UBOOT_NEEDS_PYLIBFDT=y
BR2_TARGET_UBOOT_FORMAT_CUSTOM=y
BR2_TARGET_UBOOT_FORMAT_CUSTOM_NAME="u-boot-rockchip.bin"

# Kernel pinned to the version the imported patch set targets (see
# patches/README.md); the image default of "latest" would not take the
# patches.
# BR2_LINUX_KERNEL_LATEST_VERSION is not set
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.15.6"

# Radio/SoC blobs the mainline linux-firmware set does not carry.
BR2_PACKAGE_FIRMWARE_ARMBIAN=y

# Bluetooth halves of the BCM/AP6xxx combo radios.
BR2_PACKAGE_BROADCOM_BT_FIRMWARE=y
