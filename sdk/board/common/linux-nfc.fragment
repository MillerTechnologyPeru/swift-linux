# NFC, for every board. Merged ahead of each board's own fragment.
#
# Two userlands reach a tag by different routes, and they want different
# things from the kernel:
#
#   libnfc  drives the reader itself - over libusb for a USB dongle, or over
#           a tty, I2C or SPI bus for a PN532 on a header. It needs the bus,
#           not the kernel's NFC stack.
#   neard   speaks to the kernel's NFC subsystem over AF_NFC sockets, and the
#           kernel drives the reader. That needs CONFIG_NFC and a driver.
#
# So the two are alternatives for the same hardware, and enabling a kernel
# driver is what decides which one gets the device: once pn533_usb binds an
# ACR122U, libnfc's pn53x_usb driver cannot claim it. The kernel drivers are
# therefore modules, not built in - nothing binds until something loads one,
# and a libnfc program has the reader by default. For the neard route:
#
#   modprobe pn533_usb        # or pn533_i2c, port100, ...
#
# CONFIG_NFC itself is a module for the same reason; the subsystem costs
# nothing until a driver pulls it in.
#
# A line here whose dependencies are unmet is dropped by olddefconfig without
# a word - no warning in the build log, nothing in the merge output, just a
# symbol absent from the final .config. That is why the protocol stacks and
# the three bus symbols below are stated explicitly rather than left to
# whatever the board's own defconfig happened to turn on: every driver in
# this file names a stack and a bus, and a missing one takes the driver with
# it in silence. Check a change here by grepping the built tree's .config,
# not by reading this file.
CONFIG_NFC=m

# The three protocol stacks, each the entry point for a different family of
# controller. Digital is the one that is easy to miss: it is what a chipset
# whose firmware stops below the protocol layer needs, and port100, trf7970a
# and st95hf are all unreachable without it.
CONFIG_NFC_NCI=m
CONFIG_NFC_NCI_SPI=m
CONFIG_NFC_NCI_UART=m
CONFIG_NFC_HCI=m
CONFIG_NFC_SHDLC=y
CONFIG_NFC_DIGITAL=m

# Buses the drivers below are attached to. I2C and SPI are also what libnfc
# uses to reach a PN532 wired to a header, so they are useful here even with
# every kernel driver left unloaded.
#
# The serial device bus is built in rather than modular on purpose: its TTY
# port controller - what actually makes a serdev device appear on a real UART
# - is "depends on SERIAL_DEV_BUS != m", so a modular bus silently produces a
# bus no UART is ever attached to, and pn532_uart then has nothing to bind.
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_SPI=y
CONFIG_SPI_SPIDEV=m
CONFIG_SERIAL_DEV_BUS=y
CONFIG_SERIAL_DEV_CTRL_TTYPORT=y
CONFIG_GPIOLIB=y

# USB readers. port100 covers the Sony RC-S380; pn533_usb the PN533 and the
# ACR122U built on it; mrvl_usb the Marvell NCI dongles.
CONFIG_NFC_PN533=m
CONFIG_NFC_PN533_USB=m
CONFIG_NFC_PORT100=m
CONFIG_NFC_MRVL=m
CONFIG_NFC_MRVL_USB=m

# PN532/PN533 on a board bus. The UART one is what a PN532 breakout wired to
# a serial header uses.
CONFIG_NFC_PN533_I2C=m
CONFIG_NFC_PN532_UART=m

# Controllers found on ARM boards and phones, over I2C, SPI or UART. NXP
# (pn544, nxp-nci), Samsung (s3fwrn5 and the s3fwrn82 UART part), ST
# (st21nfca, st-nci, st95hf), TI (trf7970a), Marvell and Inside Secure
# (microread), plus NXP's field detect part (fdp).
CONFIG_NFC_PN544=m
CONFIG_NFC_PN544_I2C=m
CONFIG_NFC_NXP_NCI=m
CONFIG_NFC_NXP_NCI_I2C=m
CONFIG_NFC_S3FWRN5=m
CONFIG_NFC_S3FWRN5_I2C=m
CONFIG_NFC_S3FWRN82_UART=m
CONFIG_NFC_ST21NFCA=m
CONFIG_NFC_ST21NFCA_I2C=m
CONFIG_NFC_ST_NCI=m
CONFIG_NFC_ST_NCI_I2C=m
CONFIG_NFC_ST_NCI_SPI=m
CONFIG_NFC_ST95HF=m
CONFIG_NFC_TRF7970A=m
CONFIG_NFC_MICROREAD=m
CONFIG_NFC_MICROREAD_I2C=m
CONFIG_NFC_MRVL_I2C=m
CONFIG_NFC_MRVL_SPI=m
CONFIG_NFC_MRVL_UART=m
CONFIG_NFC_FDP=m
CONFIG_NFC_FDP_I2C=m

# The two readers that sit behind Intel's Management Engine rather than on a
# bus of their own, which is how an NFC part is wired on a good many Intel
# laptops. Gated on INTEL_MEI, which is x86-only, so these three lines are
# dropped on every ARM board and cost nothing there.
CONFIG_INTEL_MEI=m
CONFIG_NFC_MEI_PHY=m
CONFIG_NFC_PN544_MEI=m
CONFIG_NFC_MICROREAD_MEI=m

# Virtual devices, and the only way any of this is exercised without hardware
# in hand: nfcsim registers two loopback devices that talk NFC-DEP to each
# other, and virtual_ncidev presents an NCI device driven from userspace
# through /dev/virtual_nci. Both are modules that register nothing until
# loaded, so they are free on a real board and are what makes the stack
# testable under QEMU, where no reader exists to attach.
CONFIG_NFC_SIM=m
CONFIG_NFC_VIRTUAL_NCI=m
