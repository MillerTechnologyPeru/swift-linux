#!/bin/sh
# Start a GNOME session for the current user (the mutter/Wayland
# counterpart of sway-session; the tty1 profile hook picks whichever the
# image ships). gnome-session runs its builtin (non-systemd) startup;
# elogind is D-Bus activated on first login1 access, and the session must
# have been registered through pam_elogind at login (see /etc/pam.d/login)
# or mutter's native backend will refuse to start.

XDG_RUNTIME_DIR="/tmp/xdg-$(id -u)"
export XDG_RUNTIME_DIR
mkdir -p "${XDG_RUNTIME_DIR}"
chmod 0700 "${XDG_RUNTIME_DIR}"
export XDG_SESSION_TYPE=wayland

# mutter keeps its own typelibs - Meta, Clutter, Cogl, CoglPango, Mtk - in
# /usr/lib/mutter-15 rather than the girepository directory, and gnome-shell's
# JavaScript imports them. Upstream handles that by compiling the path in:
# src/meson.build bakes -DMUTTER_TYPELIB_DIR from
# mutter_dep.get_variable('typelibdir'), and gnome-shell prepends it to the
# search path at startup.
#
# That value is wrong here. libmutter-15.pc derives typelibdir from libdir,
# which pkg-config sysroot-prefixes - unlike a prefix-derived variable - so
# what gets compiled in is the build machine's staging path, and on the target
# it names a directory that does not exist:
#
#   JS ERROR: Error: Requiring Meta, version 15: Typelib file for namespace
#     'Meta', version '15' not found
#
# Name the directory the target actually uses. GI_TYPELIB_PATH prepends rather
# than replaces, so the girepository directory stays reachable.
GI_TYPELIB_PATH="/usr/lib/mutter-15${GI_TYPELIB_PATH:+:$GI_TYPELIB_PATH}"
export GI_TYPELIB_PATH

export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8

# Sound server. sdk/defconfig/audio.config puts PipeWire in this image and
# says so plainly - "All run as user-session daemons launched from the sway
# session" - and the sway config does exactly that. The GNOME session never
# got the same treatment, so on this frontend nothing started PipeWire at all
# and everything that wanted it failed:
#
#   xdg-desktop-portal: Failed connect to PipeWire: Couldn't connect to PipeWire
#   GNOME Shell: Error connecting to the screencast service
#
# pipewire-pulse is the PulseAudio server here - gnome.config enables the
# pulseaudio package only for libpulse, gnome-settings-daemon's volume
# control, and notes that the PulseAudio daemon itself stays off.
#
# Started in order: the session manager and the pulse shim both connect to
# the core, and both retry, but starting them in the order they depend on
# saves a round of that.
for _snd in pipewire wireplumber pipewire-pulse; do
	if [ -x "/usr/bin/$_snd" ]; then
		/usr/bin/$_snd >/dev/null 2>&1 &
	fi
done
unset _snd

# Send the session's output to syslog as well as the console.
#
# Everything the session says - gnome-session's own messages, and mutter's and
# gnome-shell's on the way up - goes to stderr, which on tty1 means an 80x25
# screen with no scrollback. When the session fails and gnome-session restarts
# it, each attempt overwrites the last, so by the time anyone looks the reason
# is gone; and if agetty gives up respawning, what is left on screen is the
# final attempt's tail rather than its first error. That is not a debuggable
# arrangement on an image with no display manager and no journal.
#
# logger -s writes to syslog and echoes to stderr, so the console still shows
# what it always did and /var/log/messages keeps a copy that survives the
# restart. stdin is left alone: only the output is redirected.
dbus-run-session -- gnome-session 2>&1 | logger -t gnome-session -s
