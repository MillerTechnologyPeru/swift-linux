#!/bin/sh
# Mirror the installed flatpak applications into the EmulationStation Apps
# group as launch scripts.
#
# ES scans exactly one directory per system (SystemData reads a single
# <path> element), so Apps cannot watch /var/lib/flatpak itself; instead
# each installed app gets a generated wrapper in /data/apps. Runs at boot
# (S15data) and from the Tools group ("Refresh Apps") after installing or
# removing something.
#
# Generated files carry a marker line and the app id; scripts without the
# marker are the user's own and are never touched, including a user script
# whose name collides with an app's.

APPS=/data/apps
MARK="# generated by es-flatpak-sync"

command -v flatpak >/dev/null 2>&1 || exit 0
[ -d "${APPS}" ] || exit 0

# Drop generated entries whose app is gone.
for f in "${APPS}"/*.sh; do
	[ -f "${f}" ] || continue
	grep -q "^${MARK}" "${f}" || continue
	id=$(sed -n 's/^# flatpak-id: //p' "${f}")
	[ -n "${id}" ] && flatpak info "${id}" >/dev/null 2>&1 && continue
	rm -f "${f}"
done

# Add or refresh an entry per installed app.
tab=$(printf '\t')
flatpak list --app --columns=application,name 2>/dev/null | \
while IFS="${tab}" read -r id name; do
	[ -n "${id}" ] || continue
	[ -n "${name}" ] || name="${id}"
	safe=$(echo "${name}" | tr '/:' '--')
	f="${APPS}/${safe}.sh"
	if [ -f "${f}" ] && ! grep -q "^${MARK}" "${f}"; then
		continue
	fi
	{
		echo '#!/bin/sh'
		echo "${MARK}"
		echo "# flatpak-id: ${id}"
		echo "exec flatpak run ${id}"
	} > "${f}"
	chmod +x "${f}"
	chown swift:swift "${f}" 2>/dev/null || true
done

exit 0
