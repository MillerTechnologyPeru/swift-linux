#!/bin/sh
# WiFi helper with the CLI contract EmulationStation's ApiSystem expects
# (see isScriptingSupported: the WIFI menu appears when /usr/bin/wifictl
# exists):
#
#   wifictl enable | disable
#   wifictl list | scanlist          - one SSID per line
#   wifictl connect <ssid> <psk> [country]
#   wifictl has_ap_mode              - AP/netplay mode: not supported here
#
# Implemented over nmcli: NetworkManager is the manager on every image
# (see sdk/defconfig/network.config). Changing network state is root-only
# and the frontend runs as the session user, so re-exec through the
# NOPASSWD rule in /etc/sudoers.d/es-platform.
[ "$(id -u)" = "0" ] || exec sudo -n "$0" "$@"

# -t (terse) with an explicit field list is the parseable form: one record
# per line. Asking for SSID alone keeps it to a single field, so an SSID
# containing nmcli's ':' separator still comes out intact.
list_networks() {
	nmcli -t -f SSID device wifi list 2>/dev/null | grep -v '^$' | sort -u
}

case "$1" in
	enable)
		nmcli radio wifi on >/dev/null 2>&1
		;;
	disable)
		nmcli radio wifi off >/dev/null 2>&1
		;;
	scanlist)
		nmcli radio wifi on >/dev/null 2>&1
		# --rescan yes forces a fresh scan instead of reusing the cache.
		nmcli -t -f SSID device wifi list --rescan yes 2>/dev/null | \
			grep -v '^$' | sort -u
		;;
	list)
		list_networks
		;;
	connect)
		ssid="$2"
		psk="$3"
		country="$4"
		[ -n "$ssid" ] || exit 1
		[ -n "$country" ] && command -v iw >/dev/null 2>&1 && \
			iw reg set "$country" 2>/dev/null

		nmcli radio wifi on >/dev/null 2>&1
		nmcli device wifi rescan >/dev/null 2>&1

		# "device wifi connect" creates the profile and brings it up in
		# one step; NetworkManager stores it under /var/lib/NetworkManager
		# (persisted by S15data) and reconnects on its own from then on.
		# An open network takes no password argument - passing an empty
		# one is an error rather than a no-op.
		if [ -n "$psk" ]; then
			nmcli device wifi connect "$ssid" password "$psk" >/dev/null 2>&1
		else
			nmcli device wifi connect "$ssid" >/dev/null 2>&1
		fi
		exit 0
		;;
	has_ap_mode)
		exit 1
		;;
	channels)
		# Only meaningful for AP/netplay mode, which is not supported.
		exit 0
		;;
	*)
		echo "usage: wifictl enable|disable|list|scanlist|connect <ssid> <psk> [country]|has_ap_mode" >&2
		exit 1
		;;
esac
