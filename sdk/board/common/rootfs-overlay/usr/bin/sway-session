#!/bin/sh
# Start a Sway session for the current user. Arch/board independent: relies
# on seatd (for non-root DRM/input) and a GBM/EGL capable DRM driver.
#
# Sway launches its own terminal from /etc/sway/config ("exec foot"), so
# unlike the previous Weston session this script does not have to discover
# the Wayland socket and start a client itself.

XDG_RUNTIME_DIR="/tmp/xdg-$(id -u)"
export XDG_RUNTIME_DIR
mkdir -p "${XDG_RUNTIME_DIR}"
chmod 0700 "${XDG_RUNTIME_DIR}"
export XDG_SESSION_TYPE=wayland

# foot and other Wayland terminals require a UTF-8 locale (generated by the
# BR2_GENERATE_LOCALE setting in image.config); the default is plain "C".
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8

# Use seatd for seat management; without this libseat looks for logind first,
# which does not exist here (no systemd).
export LIBSEAT_BACKEND=seatd

exec sway -c /etc/sway/config
