#!/bin/sh
# Start an XFCE session for the current user (the X11 counterpart of
# sway-session; the tty1 profile hook picks whichever the image ships).
#
# startx runs the X server on this VT and startxfce4 as the client. On a
# kernel with modesetting this needs no xorg.conf; input goes through the
# libinput driver. If the server refuses to start as the non-root user,
# the Xorg binary needs setuid (or the session must run as root) - see
# the note in sdk/defconfig/frontend/xfce.config.

XDG_RUNTIME_DIR="/tmp/xdg-$(id -u)"
export XDG_RUNTIME_DIR
mkdir -p "${XDG_RUNTIME_DIR}"
chmod 0700 "${XDG_RUNTIME_DIR}"
export XDG_SESSION_TYPE=x11

# GTK apps want a UTF-8 locale (generated by BR2_GENERATE_LOCALE).
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8

exec startx /usr/bin/startxfce4 -- vt1 -keeptty
