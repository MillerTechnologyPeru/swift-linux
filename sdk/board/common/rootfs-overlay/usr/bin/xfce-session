#!/bin/sh
# Start an XFCE session for the current user (the X11 counterpart of
# sway-session; the tty1 profile hook picks whichever the image ships).
#
# cage (a wlroots kiosk compositor) owns KMS and input through seatd, the
# same non-root path the sway session uses - no setuid X server. Its single
# client, xfce-x11-session, brings up a rootful Xwayland and starts XFCE
# inside it.

XDG_RUNTIME_DIR="/tmp/xdg-$(id -u)"
export XDG_RUNTIME_DIR
mkdir -p "${XDG_RUNTIME_DIR}"
chmod 0700 "${XDG_RUNTIME_DIR}"

# GTK apps want a UTF-8 locale (generated by BR2_GENERATE_LOCALE).
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8

exec cage -- /usr/bin/xfce-x11-session
