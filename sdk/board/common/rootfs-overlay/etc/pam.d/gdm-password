# GDM's stack for logging a real user in.
#
# The distributed pam-* profiles all include system-auth/system-session,
# which this image does not have; its PAM is the minimal one in
# /etc/pam.d/login, so this mirrors that rather than pulling in an include
# chain that does not exist.
#
# pam_elogind is what registers the session with logind. Without it the
# session has no seat and mutter refuses to start - the same failure the
# tty1 path hit before its module path was corrected.
auth		required	pam_unix.so nullok
account		required	pam_unix.so
password	required	pam_unix.so
session		required	pam_unix.so
session		optional	pam_elogind.so
