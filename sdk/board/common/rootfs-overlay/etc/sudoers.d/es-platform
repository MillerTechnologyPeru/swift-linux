# EmulationStation platform helpers. The frontend runs as the session user,
# but NetworkManager and BlueZ are root-only over D-Bus, and poweroff/suspend need
# root outright - each helper re-execs itself through sudo -n, which only
# works without a password prompt. Scoped to exactly these commands; the
# general %wheel rule (see ./wheel) still asks for a password.
# es-squashfs only mounts validated paths read-only with nosuid/nodev under
# /run/es-squash; the app inside the image runs as the session user.
# binfmtctl toggles only the two handlers this image registers, by name
# from a fixed list - the native arm64 Steam client needs the x86
# handlers off while it starts (see steam-run).
swift ALL=(root) NOPASSWD: /usr/bin/wifictl, /usr/bin/rocknix-bluetooth, /usr/bin/shutdown, /usr/sbin/pm-suspend, /usr/bin/es-squashfs, /usr/bin/binfmtctl
