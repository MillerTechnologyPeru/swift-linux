# <device>                          <mount>   <type>   <options>          <dump> <pass>
# pass=0: EROFS is read-only with no fsck.erofs consistency repair the way
# ext4 has e2fsck; checkfs would just skip it, so avoid invoking fsck at all.
/dev/root                           /         erofs    ro                 0      0
proc                                /proc     proc     defaults           0      0
devtmpfs                            /dev      devtmpfs defaults           0      0
# devpts is required for pty allocation - without it terminal emulators fail
# with "failed to fork and create pty (No such device)".
devpts                              /dev/pts  devpts   defaults,gid=5,mode=620 0 0
sysfs                               /sys      sysfs    defaults           0      0
tmpfs                               /tmp      tmpfs    mode=1777          0      0
tmpfs                               /run      tmpfs    mode=0755,nosuid   0      0
# Shared memory. Wayland/GL (wlroots, Mesa) allocate shm buffers here; without
# it sway fails with "Failed to allocate shm file for format table" on the
# read-only rootfs.
tmpfs                               /dev/shm  tmpfs    mode=1777,nosuid,nodev 0 0
# Do NOT mount a tmpfs on /var/lib. It would hide what the image ships there
# (notably Buildroot's "dbus -> /tmp/dbus" symlink, whose loss makes
# dbus-daemon fail to write its machine-id) and the directories that
# /etc/init.d/S15data bind-mounts from the data partition.
# Do NOT add /var/log either: the skeleton symlinks it to ../tmp, so mounting
# a tmpfs on it lands on /tmp and replaces its 1777 mode with 0755, which
# stops non-root users from creating their XDG_RUNTIME_DIR.
# /boot (ESP) and /data are mounted by /etc/init.d/S15data, which runs after
# udev has created /dev/disk/by-partuuid. Mounting them here would be too
# early: the symlinks do not exist yet during rcS.
