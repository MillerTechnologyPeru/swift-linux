#!/bin/sh
# Mount the ESP and the persistent data partition, and move the default user's
# home onto the latter, keeping the rootfs read-only. On first boot the data
# partition is grown to fill the medium and formatted.
#
# Ordering matters: this must run AFTER S10udevd, because both partitions are
# addressed by their /dev/disk/by-partuuid symlinks, which udev creates.
# (Mounting them from /etc/fstab during rcS is too early.)

BOOT_DEV=/dev/disk/by-partuuid/0e0e0e0e-0000-4000-8000-00000000000e
DATA_DEV=/dev/disk/by-partuuid/0d0d0d0d-0000-4000-8000-00000000000d
DATA=/data

# grow_data_partition: images are built at a fixed size, so on a larger medium
# everything past the data partition is unused. Extend it to the end of the
# disk before the filesystem is created or mounted.
#
# This is idempotent and needs no marker file: it compares the partition's end
# with the disk's end and does nothing when the space is already claimed, so it
# also covers a card that is later cloned onto a larger one.
grow_data_partition() {
	part="$(readlink -f "${DATA_DEV}")"
	[ -b "${part}" ] || return 0
	pname="${part#/dev/}"
	# /sys/class/block/<part>/../ is the parent disk for a partition.
	sysdir="/sys/class/block/${pname}"
	[ -d "${sysdir}" ] || return 0
	dname="$(basename "$(readlink -f "${sysdir}/..")")"
	[ -b "/dev/${dname}" ] || return 0
	partnum="$(cat "${sysdir}/partition" 2>/dev/null)" || return 0

	disk_sectors="$(cat "/sys/class/block/${dname}/size" 2>/dev/null)" || return 0
	part_start="$(cat "${sysdir}/start" 2>/dev/null)" || return 0
	part_sectors="$(cat "${sysdir}/size" 2>/dev/null)" || return 0

	# Leave room for the GPT backup header (33 sectors) plus a little slack;
	# only bother when there is a meaningful amount of space to gain (16 MiB).
	free=$((disk_sectors - part_start - part_sectors - 34))
	[ "${free}" -gt 32768 ] || return 0

	command -v parted >/dev/null 2>&1 || return 0
	printf 'Growing data partition to fill the disk: '
	# -f moves the GPT backup header to the new end of the disk, which is
	# what makes the trailing space usable in the first place.
	if parted -s -f "/dev/${dname}" resizepart "${partnum}" 100% >/dev/null 2>&1; then
		# Let the kernel re-read the table so the new size is visible.
		partprobe "/dev/${dname}" >/dev/null 2>&1 || \
			blockdev --rereadpt "/dev/${dname}" >/dev/null 2>&1 || true
		echo OK
	else
		echo "FAIL (continuing with the existing size)"
	fi
}

wait_for_dev() {
	i=0
	while [ ! -b "$1" ] && [ "${i}" -lt 50 ]; do
		sleep 0.2
		i=$((i + 1))
	done
	[ -b "$1" ]
}

start() {
	# ESP: holds GRUB and the grubenv that RAUC updates for A/B.
	if wait_for_dev "${BOOT_DEV}"; then
		mount -o rw,noatime "${BOOT_DEV}" /boot 2>/dev/null
	fi

	if ! wait_for_dev "${DATA_DEV}"; then
		echo "Data partition not found; skipping"
		return 0
	fi

	grow_data_partition

	# First boot: create an ext4 filesystem on the raw data partition.
	# Detect an existing filesystem by ANY blkid output: busybox blkid prints
	# LABEL/UUID but not a TYPE= field, so a type match cannot be relied on.
	# Redirect stdin from /dev/null so mkfs can never block the boot on its
	# "Proceed anyway?" prompt if it is ever pointed at a non-empty device.
	if [ -z "$(blkid "${DATA_DEV}" 2>/dev/null)" ]; then
		printf 'Formatting data partition: '
		mkfs.ext4 -q -L data "${DATA_DEV}" < /dev/null && echo OK || { echo FAIL; return 0; }

	else
		# The filesystem predates the partition it sits on being grown, so
		# stretch it to the partition's current size. resize2fs is a no-op
		# when it already fills it.
		e2fsck -p "${DATA_DEV}" >/dev/null 2>&1 || true
		resize2fs "${DATA_DEV}" >/dev/null 2>&1 || true
	fi

	# /data exists in the rootfs image: the root is read-only and cannot be
	# created at runtime.
	mount "${DATA_DEV}" "${DATA}" || return 0

	# Persist the default user's home directory on the data partition.
	mkdir -p "${DATA}/home"
	if [ ! -d "${DATA}/home/swift" ]; then
		cp -a /home/swift "${DATA}/home/swift" 2>/dev/null || mkdir -p "${DATA}/home/swift"
		chown -R swift:swift "${DATA}/home/swift"
	fi
	mount -o bind "${DATA}/home" /home

	# BlueZ pairings and ConnMan network profiles live under /var/lib, which
	# is a tmpfs on this read-only rootfs; bind them to the data partition so
	# they survive a reboot. Must happen before S40bluetoothd/S45connman.
	for d in bluetooth connman; do
		mkdir -p "${DATA}/lib/${d}" "/var/lib/${d}"
		mount -o bind "${DATA}/lib/${d}" "/var/lib/${d}"
	done
}

stop() {
	umount /var/lib/bluetooth 2>/dev/null || true
	umount /var/lib/connman 2>/dev/null || true
	umount /home 2>/dev/null || true
	umount "${DATA}" 2>/dev/null || true
	umount /boot 2>/dev/null || true
}

case "$1" in
	start) start ;;
	stop)  stop ;;
	restart|reload) stop; start ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
