#!/bin/sh
# Mount the ESP and the persistent data partition, and move the default user's
# home onto the latter, keeping the rootfs read-only. On first boot the data
# partition is grown to fill the medium and formatted.
#
# Ordering matters: udev must be running first, because both partitions are
# addressed by their /dev/disk/by-partuuid symlinks, which udev creates.
# Under OpenRC that holds by construction: udev starts in the sysinit
# runlevel (udev-gentoo-scripts), and this script runs later from the
# default runlevel's sysv-rcs service. (Mounting from /etc/fstab would be
# too early: localmount runs in the boot runlevel, before the coldplug
# has settled.)

BOOT_DEV=/dev/disk/by-partuuid/0e0e0e0e-0000-4000-8000-00000000000e
DATA_DEV=/dev/disk/by-partuuid/0d0d0d0d-0000-4000-8000-00000000000d
DATA=/data

# grow_data_partition: images are built at a fixed size, so on a larger medium
# everything past the data partition is unused. Extend it to the end of the
# disk before the filesystem is created or mounted.
#
# This is idempotent and needs no marker file: it compares the partition's end
# with the disk's end and does nothing when the space is already claimed, so it
# also covers a card that is later cloned onto a larger one.
grow_data_partition() {
	part="$(readlink -f "${DATA_DEV}")"
	[ -b "${part}" ] || return 0
	pname="${part#/dev/}"
	# /sys/class/block/<part>/../ is the parent disk for a partition.
	sysdir="/sys/class/block/${pname}"
	[ -d "${sysdir}" ] || return 0
	dname="$(basename "$(readlink -f "${sysdir}/..")")"
	[ -b "/dev/${dname}" ] || return 0
	partnum="$(cat "${sysdir}/partition" 2>/dev/null)" || return 0

	disk_sectors="$(cat "/sys/class/block/${dname}/size" 2>/dev/null)" || return 0
	part_start="$(cat "${sysdir}/start" 2>/dev/null)" || return 0
	part_sectors="$(cat "${sysdir}/size" 2>/dev/null)" || return 0

	# Leave room for the GPT backup header (33 sectors) plus a little slack;
	# only bother when there is a meaningful amount of space to gain (16 MiB).
	free=$((disk_sectors - part_start - part_sectors - 34))
	[ "${free}" -gt 32768 ] || return 0

	command -v parted >/dev/null 2>&1 || return 0
	printf 'Growing data partition to fill the disk: '
	# -f moves the GPT backup header to the new end of the disk, which is
	# what makes the trailing space usable in the first place.
	if parted -s -f "/dev/${dname}" resizepart "${partnum}" 100% >/dev/null 2>&1; then
		# Let the kernel re-read the table so the new size is visible.
		partprobe "/dev/${dname}" >/dev/null 2>&1 || \
			blockdev --rereadpt "/dev/${dname}" >/dev/null 2>&1 || true
		echo OK
	else
		echo "FAIL (continuing with the existing size)"
	fi
}

wait_for_dev() {
	i=0
	while [ ! -b "$1" ] && [ "${i}" -lt 50 ]; do
		sleep 0.2
		i=$((i + 1))
	done
	[ -b "$1" ]
}

start() {
	# ESP: holds GRUB and the grubenv that RAUC updates for A/B.
	if wait_for_dev "${BOOT_DEV}"; then
		mount -o rw,noatime "${BOOT_DEV}" /boot 2>/dev/null
	fi

	if ! wait_for_dev "${DATA_DEV}"; then
		echo "Data partition not found; skipping"
		return 0
	fi

	grow_data_partition

	# First boot: create an ext4 filesystem on the raw data partition.
	# Detect an existing filesystem by ANY blkid output: busybox blkid prints
	# LABEL/UUID but not a TYPE= field, so a type match cannot be relied on.
	# Redirect stdin from /dev/null so mkfs can never block the boot on its
	# "Proceed anyway?" prompt if it is ever pointed at a non-empty device.
	if [ -z "$(blkid "${DATA_DEV}" 2>/dev/null)" ]; then
		printf 'Formatting data partition: '
		mkfs.ext4 -q -L data "${DATA_DEV}" < /dev/null && echo OK || { echo FAIL; return 0; }

	else
		# The filesystem predates the partition it sits on being grown, so
		# stretch it to the partition's current size. resize2fs is a no-op
		# when it already fills it.
		e2fsck -p "${DATA_DEV}" >/dev/null 2>&1 || true
		resize2fs "${DATA_DEV}" >/dev/null 2>&1 || true
	fi

	# /data exists in the rootfs image: the root is read-only and cannot be
	# created at runtime.
	mount "${DATA_DEV}" "${DATA}" || return 0

	# Persist the default user's home directory on the data partition.
	mkdir -p "${DATA}/home"
	if [ ! -d "${DATA}/home/swift" ]; then
		cp -a /home/swift "${DATA}/home/swift" 2>/dev/null || mkdir -p "${DATA}/home/swift"
		chown -R swift:swift "${DATA}/home/swift"
	fi
	mount -o bind "${DATA}/home" /home

	# The app managers keep their mutable state in the save tree through
	# home-skeleton symlinks (flatpak's ~/.var, lutris' data and config,
	# heroic's config). A home provisioned by an older image predates
	# them - add each, but never over a real directory the user already
	# has data in.
	for pair in \
		".var /data/saves/flatpak" \
		".local/share/lutris /data/saves/lutris/share" \
		".config/lutris /data/saves/lutris/config" \
		".config/heroic /data/saves/heroic" \
		".local/share/Steam /data/saves/steam"; do
		link="/home/swift/${pair%% *}"
		dest="${pair#* }"
		[ -e "${link}" ] && continue
		mkdir -p "$(dirname "${link}")"
		chown swift:swift "$(dirname "${link}")" 2>/dev/null || true
		ln -s "${dest}" "${link}"
		chown -h swift:swift "${link}" 2>/dev/null || true
	done

	# Default install locations, so games land in the content tree rather
	# than the home directory. Seeded only while the app has never written
	# its own configuration - after that, the settings are the user's.
	if [ -x /usr/bin/lutris ] && [ ! -f /data/saves/lutris/config/lutris.conf ]; then
		printf '[system]\ngame_path = /data/roms/lutris\n' \
			> /data/saves/lutris/config/lutris.conf
		chown swift:swift /data/saves/lutris/config/lutris.conf
	fi
	if [ -x /usr/bin/heroic ] && [ ! -f /data/saves/heroic/config.json ]; then
		printf '{"defaultSettings": {"defaultInstallPath": "/data/roms/heroic"}}\n' \
			> /data/saves/heroic/config.json
		chown swift:swift /data/saves/heroic/config.json
	fi

	# EmulationStation user-content groups (see /etc/emulationstation/
	# es_systems.cfg): ROMs, apps and games live on the data partition,
	# owned by the default user so content can be dropped in over sftp.
	#
	# Alongside them: bios/ and screenshots/ next to the ROMs, where a
	# user looks for them (RetroArch's system_directory and
	# screenshot_directory point there, see /etc/retroarch.cfg), and a
	# top-level saves/ that game state is written into, one directory per
	# system - kept out of roms/ so backing up what the player made is
	# separable from the content they supplied (see retro-launch).
	for d in roms/nes roms/snes roms/gbc roms/gba roms/psx roms/dos \
		roms/macintosh roms/palm roms/easyrpg roms/scummvm roms/lutro \
		roms/solarus roms/love roms/pygame roms/ports roms/steam \
		roms/bios roms/screenshots roms/flatpak roms/lutris roms/heroic \
		saves saves/flatpak saves/lutris saves/lutris/share \
		saves/lutris/config saves/heroic saves/steam apps; do
		[ -d "${DATA}/${d}" ] && continue
		mkdir -p "${DATA}/${d}"
		chown swift:swift "${DATA}/${d}"
	done
	chown swift:swift "${DATA}/roms" 2>/dev/null

	# Drop the BIOS/saves note where someone browsing the card will meet
	# it. Not overwritten if it is already there - the user may have
	# replaced it with notes of their own.
	if [ ! -f "${DATA}/roms/bios/README.txt" ] && \
	   [ -f /usr/share/swift-linux/bios-README.txt ]; then
		cp /usr/share/swift-linux/bios-README.txt "${DATA}/roms/bios/README.txt"
		chown swift:swift "${DATA}/roms/bios/README.txt"
	fi

	# Seed the EmulationStation Apps group with an entry per application
	# manager the image ships. The marker file records each entry ever
	# seeded, one name per line: an entry the user deletes stays deleted
	# (its name is recorded), while an image upgraded to one that ships a
	# new manager seeds that one on the next boot (its name is not).
	seed_app() {
		name="$1"; bin="$2"
		[ -x "${bin}" ] || return 0
		[ -f "/usr/share/swift-linux/apps/${name}" ] || return 0
		grep -qxF "${name}" "${DATA}/apps/.seeded" 2>/dev/null && return 0
		cp "/usr/share/swift-linux/apps/${name}" "${DATA}/apps/${name}"
		chown swift:swift "${DATA}/apps/${name}"
		chmod +x "${DATA}/apps/${name}"
		echo "${name}" >> "${DATA}/apps/.seeded"
		chown swift:swift "${DATA}/apps/.seeded"
	}
	seed_app "App Store.sh"  /usr/bin/gnome-software
	seed_app "Lutris.sh"     /usr/bin/lutris
	seed_app "Heroic.sh"     /usr/bin/heroic
	seed_app "PortMaster.sh" /usr/bin/portmaster

	# Seed the Steam system's launch entries (client + Big Picture) when
	# the image ships Steam. Only ever into an empty directory: once the
	# user has arranged their own shortcuts, theirs is the layout.
	if [ -x /usr/bin/steam-run ] && [ -d /usr/share/swift-linux/steam ] && \
	   [ -d "${DATA}/roms/steam" ] && \
	   [ -z "$(ls -A "${DATA}/roms/steam" 2>/dev/null)" ]; then
		cp /usr/share/swift-linux/steam/*.sh "${DATA}/roms/steam/"
		chown swift:swift "${DATA}/roms/steam/"*.sh
		chmod +x "${DATA}/roms/steam/"*.sh
	fi

	# BlueZ pairings and NetworkManager connection profiles live under
	# /var/lib, which is on this read-only rootfs; bind them to the data
	# partition so they survive a reboot. Must happen before S40bluetoothd
	# and S45NetworkManager start.
	for d in bluetooth NetworkManager; do
		mkdir -p "${DATA}/lib/${d}" "/var/lib/${d}"
		mount -o bind "${DATA}/lib/${d}" "/var/lib/${d}"
	done

	# The flatpak system installation (runtimes and apps) is user-supplied
	# content, so it lives with the rest of it: /var/lib/flatpak is backed
	# by /data/roms/flatpak. The apps' own mutable state is separate -
	# ~/.var/app points into /data/saves/flatpak (see the overlay's home
	# skeleton), keeping "what was installed" and "what the apps wrote"
	# independently backupable, like every other system.
	mount -o bind "${DATA}/roms/flatpak" /var/lib/flatpak

	# Reflect the installed flatpak applications into the Apps group
	# (each becomes a generated launch script; see es-flatpak-sync).
	command -v es-flatpak-sync >/dev/null 2>&1 && es-flatpak-sync || true
}

stop() {
	umount /var/lib/bluetooth 2>/dev/null || true
	umount /var/lib/NetworkManager 2>/dev/null || true
	umount /var/lib/flatpak 2>/dev/null || true
	umount /home 2>/dev/null || true
	umount "${DATA}" 2>/dev/null || true
	umount /boot 2>/dev/null || true
}

case "$1" in
	start) start ;;
	stop)  stop ;;
	restart|reload) stop; start ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
