# Kernel options shared by Rockchip RK3566 handhelds. Assume a kernel with
# RK3566 support and the device DTS (see the board READMEs); on a mainline
# arm64 kernel some of these will be absent.

# Rockchip platform
CONFIG_ARCH_ROCKCHIP=y
CONFIG_PINCTRL_RK805=y
CONFIG_MFD_RK808=y
CONFIG_REGULATOR_RK808=y
CONFIG_ROCKCHIP_IODOMAIN=y
CONFIG_ROCKCHIP_THERMAL=y
CONFIG_PWM_ROCKCHIP=y

# Mali (panfrost) + display
CONFIG_DRM=y
CONFIG_DRM_PANFROST=y
CONFIG_DRM_ROCKCHIP=y
CONFIG_ROCKCHIP_DW_MIPI_DSI=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y

# Input: gamepad / analog sticks / buttons
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_JOYSTICK=y
CONFIG_INPUT_ADC_JOYSTICK=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_INPUT_FF_MEMLESS=y
CONFIG_COMPAT=y

# Power: RK817 charger / fuel gauge
CONFIG_CHARGER_RK817=y
CONFIG_RK817_POWER=y

# Storage / USB
CONFIG_MMC=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y
CONFIG_EXT4_FS=y
CONFIG_USB_DWC3=y
CONFIG_PHY_ROCKCHIP_INNO_USB2=y
