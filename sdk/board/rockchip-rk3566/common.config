# Shared board options for Rockchip RK3566 handhelds (quad Cortex-A55, Mali-G52).
#
# A device board.config includes this and adds only its device tree name:
#
#     include sdk/board/rockchip-rk3566/common.config
#     BR2_LINUX_KERNEL_INTREE_DTS_NAME="rockchip/rk3566-<device>"
#
# DEFINITION ONLY - not built or verified. A real build needs an RK3566 kernel
# with the device DTS and Mali/panfrost, plus U-Boot boot support (U-Boot +
# extlinux from SD/eMMC), not the UEFI A/B path used by the QEMU boards here.

BR2_aarch64=y
BR2_cortex_a55=y

BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="@SWIFT_LINUX@/sdk/board/rockchip-rk3566/linux.fragment"

# Mali-G52 GPU via panfrost.
include sdk/defconfig/gpu/panfrost.config

# Console on the built-in panel (fbcon).
BR2_TARGET_GENERIC_GETTY_PORT="tty0"

# --- Boot chain (U-Boot + ATF), device tree and patches -------------------
# These devices boot via U-Boot + extlinux from SD/eMMC. Build U-Boot with the
# Rockchip TPL/SPL and an ATF BL31 (rk3568 platform covers rk3566); the device
# board.config sets the per-device U-Boot defconfig. The combined image
# u-boot-rockchip.bin is written near the start of the card by genimage.
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_BUILD_SYSTEM_KCONFIG=y
BR2_TARGET_UBOOT_NEEDS_ATF_BL31=y
BR2_TARGET_UBOOT_NEEDS_DTC=y
BR2_TARGET_UBOOT_NEEDS_PYLIBFDT=y
BR2_TARGET_UBOOT_FORMAT_CUSTOM=y
BR2_TARGET_UBOOT_FORMAT_CUSTOM_NAME="u-boot-rockchip.bin"

BR2_TARGET_ARM_TRUSTED_FIRMWARE=y
BR2_TARGET_ARM_TRUSTED_FIRMWARE_PLATFORM="rk3568"

# Extra device tree sources / overlays not in the kernel go in dts/; device
# patches (panel timings, gamepad, ...) stack on the family patches.
BR2_LINUX_KERNEL_CUSTOM_DTS_PATH="@SWIFT_LINUX@/sdk/board/rockchip-rk3566/dts"
BR2_GLOBAL_PATCH_DIR="@SWIFT_LINUX@/sdk/board/rockchip-rk3566/patches @BOARD@/patches"

# SD-card image (U-Boot + boot + root) instead of the UEFI A/B disk.
BR2_ROOTFS_POST_IMAGE_SCRIPT="@SWIFT_LINUX@/sdk/board/rockchip-rk3566/post-image.sh"

# Kernel pinned to the version the imported patch set targets (see
# patches/README.md); the image default of "latest" would not take the
# patches.
# BR2_LINUX_KERNEL_LATEST_VERSION is not set
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.15.6"

# Radio/SoC blobs the mainline linux-firmware set does not carry.
BR2_PACKAGE_FIRMWARE_ARMBIAN=y
