# Shared board options for Rockchip RK3566 handhelds (quad Cortex-A55, Mali-G52).
#
# A device board.config includes this and adds only its device tree name:
#
#     include sdk/board/rockchip-rk3566/common.config
#     BR2_LINUX_KERNEL_INTREE_DTS_NAME="rockchip/rk3566-<device>"
#
# Everything here is imported from upstream's RK3566 device tree at one
# commit - kernel version, patch sets, kernel config, U-Boot, ATF and rkbin
# pins - see patches/README.md. The Powkiddy X55 is the board this is built
# for; the others in the family share the kernel and its device trees.
BR2_aarch64=y
BR2_cortex_a55=y
BR2_LINUX_KERNEL_DTS_SUPPORT=y
# Upstream's RK3566 kernel config, byte-identical; linux.fragment fills in the
# two placeholders upstream's build substitutes.
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="@SWIFT_LINUX@/sdk/board/rockchip-rk3566/linux.aarch64.conf"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="@SWIFT_LINUX@/sdk/board/common/linux-nfc.fragment @SWIFT_LINUX@/sdk/board/rockchip-rk3566/linux.fragment"
# Upstream's device trees not in the kernel (RG DS, the RK2023 include); laid
# over arch/arm64/boot/dts/ by Buildroot.
BR2_LINUX_KERNEL_CUSTOM_DTS_DIR="@SWIFT_LINUX@/sdk/board/rockchip-rk3566/dts"
# Patch sets in the order upstream applies them to RK3566 (PKG_PATCH_DIRS in
# its packages/linux/package.mk): the mainline set, the device set, then the
# Rockchip rk817 charger/battery fixes. patches/ also carries the U-Boot
# patches (uboot/2026.01/).
BR2_GLOBAL_PATCH_DIR="@SWIFT_LINUX@/external/patches/packages @SWIFT_LINUX@/sdk/board/rockchip-rk3566/patches-mainline @SWIFT_LINUX@/sdk/board/rockchip-rk3566/patches @SWIFT_LINUX@/sdk/board/rockchip-rk3566/patches-mainline-rockchip @BOARD@/patches"
# Mali-G52 GPU via panfrost.
include sdk/defconfig/gpu/panfrost.config
# Console on the built-in panel (fbcon).
BR2_TARGET_GENERIC_GETTY_PORT="tty0"

# --- Boot chain -----------------------------------------------------------
# Mainline U-Boot at upstream's version, from the Quartz64-A config as
# upstream builds it for the X55 (its "Specific" U-Boot): no board code runs
# at boot, the kernel's device tree comes from extlinux.conf. The two
# upstream patches (patches/uboot/2026.01/) keep a charger from powering
# the device on and try the SD card before the eMMC.
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_BUILD_SYSTEM_KCONFIG=y
BR2_TARGET_UBOOT_CUSTOM_VERSION=y
BR2_TARGET_UBOOT_CUSTOM_VERSION_VALUE="2026.01"
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="quartz64-a-rk3566"
BR2_TARGET_UBOOT_NEEDS_DTC=y
BR2_TARGET_UBOOT_NEEDS_PYLIBFDT=y
BR2_TARGET_UBOOT_NEEDS_PYELFTOOLS=y
BR2_TARGET_UBOOT_NEEDS_ATF_BL31=y
BR2_TARGET_UBOOT_NEEDS_ATF_BL31_ELF=y
# u-boot.itb (U-Boot proper + BL31 + device tree) and the SPL, which
# rk3566-loader packs with rkbin's DDR init. U-Boot's own all-in-one
# u-boot-rockchip.bin would need that DDR blob during the U-Boot build;
# binman is let off building it.
# BR2_TARGET_UBOOT_FORMAT_BIN is not set
BR2_TARGET_UBOOT_FORMAT_ITB=y
BR2_TARGET_UBOOT_SPL=y
BR2_TARGET_UBOOT_SPL_NAME="spl/u-boot-spl.bin"
BR2_TARGET_UBOOT_CUSTOM_MAKEOPTS="BINMAN_ALLOW_MISSING=1"
# BL31 from TF-A at upstream's commit, platform rk3568 (it covers rk3566).
# Newer than Buildroot's v2.12 releases: the mainline RK3566 device trees
# clock the CPUs through SCMI, which this BL31 implements. Fetched with git,
# because TF-A now keeps libfdt in a submodule (contrib/dtc) - rk3566-loader
# turns submodule fetching on for it.
BR2_TARGET_ARM_TRUSTED_FIRMWARE=y
BR2_TARGET_ARM_TRUSTED_FIRMWARE_CUSTOM_GIT=y
BR2_TARGET_ARM_TRUSTED_FIRMWARE_CUSTOM_REPO_URL="https://github.com/ARM-software/arm-trusted-firmware.git"
BR2_TARGET_ARM_TRUSTED_FIRMWARE_CUSTOM_REPO_VERSION="a881364e03b0c5b3a8c00f20ad6fbdda53a57031"
BR2_TARGET_ARM_TRUSTED_FIRMWARE_PLATFORM="rk3568"
BR2_TARGET_ARM_TRUSTED_FIRMWARE_BL31=y
# Only bl31.elf, which U-Boot packs into u-boot.itb; Buildroot installs it
# for U-Boot on its own (BR2_TARGET_UBOOT_NEEDS_ATF_BL31_ELF). The default
# list, "*.bin", matches nothing - this TF-A links no raw bl31.bin for
# rk3568 - and stops the build:
#
#   cp: cannot stat '.../build/rk3568/release/*.bin': No such file or directory
BR2_TARGET_ARM_TRUSTED_FIRMWARE_IMAGES=""
# idbloader (rkbin DDR init + SPL) and u-boot.itb laid out as one file to
# write at sector 64 (see external/package/rk3566-loader).
BR2_PACKAGE_RK3566_LOADER=y
# SD-card image: loader, then boot / root-a / root-b / data (genimage.cfg).
BR2_ROOTFS_POST_IMAGE_SCRIPT="@SWIFT_LINUX@/sdk/board/rockchip-rk3566/post-image.sh"

# Kernel pinned to the version upstream builds RK3566 with (see
# patches/README.md); the image default of "latest" would not take the
# patches.
# BR2_LINUX_KERNEL_LATEST_VERSION is not set
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="7.2.11"
# Radio/SoC blobs the mainline linux-firmware set does not carry.
BR2_PACKAGE_FIRMWARE_ARMBIAN=y
# Bluetooth halves of the BCM/AP6xxx combo radios.
BR2_PACKAGE_BROADCOM_BT_FIRMWARE=y
