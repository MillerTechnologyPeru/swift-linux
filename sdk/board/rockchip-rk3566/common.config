# Shared board options for Rockchip RK3566 handhelds (quad Cortex-A55, Mali-G52).
#
# A device board.config includes this and adds only its device tree name:
#
#     include sdk/board/rockchip-rk3566/common.config
#     BR2_LINUX_KERNEL_INTREE_DTS_NAME="rockchip/rk3566-<device>"
#
# DEFINITION ONLY - not built or verified. A real build needs an RK3566 kernel
# with the device DTS and Mali/panfrost, plus U-Boot boot support (U-Boot +
# extlinux from SD/eMMC), not the UEFI A/B path used by the QEMU boards here.

BR2_aarch64=y
BR2_cortex_a55=y

BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="@SWIFT_LINUX@/sdk/board/rockchip-rk3566/linux.fragment"

# Mali-G52 GPU via panfrost.
include sdk/defconfig/gpu/panfrost.config

# Console on the built-in panel (fbcon).
BR2_TARGET_GENERIC_GETTY_PORT="tty0"
