# Game Console R36S and R35S (Rockchip RK3326 / quad Cortex-A35). The R35S
# shares this device tree: it lists "gameconsole,r35s" as a compatible.
#
# Boots on an R35S (see README.md). Shared Rockchip RK3326 options - kernel,
# U-Boot, SD-card layout - live in the family fragment; this board adds its
# device tree name.

include sdk/board/rockchip-rk3326/common.config

BR2_LINUX_KERNEL_INTREE_DTS_NAME="rockchip/rk3326-gameconsole-r36s"
