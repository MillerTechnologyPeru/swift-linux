# PowKiddy Q90 (Allwinner suniv "F1C" family, ARM926EJ-S / armv5te).
#
# DEFINITION ONLY - not built or verified in this repo (see README.md).
# Landscape form factor (Dec 2019) with an analog stick and an extra "+"
# button ("-" doubles as RESET); otherwise the same SoC and boot chain as
# the rest of the family, with the button matrix handled at runtime by the
# family kernel.
#
# Self-contained (it selects the architecture itself), so
# generate-config.sh --device powkiddy-q90 uses it in place of an arch
# fragment.

include sdk/board/allwinner-suniv/common.config
