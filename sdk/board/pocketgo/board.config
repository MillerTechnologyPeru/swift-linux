# PocketGo (Allwinner suniv "F1C" family, ARM926EJ-S / armv5te).
#
# DEFINITION ONLY - not built or verified in this repo (see README.md). The
# landscape sibling of the BittBoy (May 2019): same SoC and boot chain,
# adds L/R shoulder buttons and physical volume control. Covers the 0.5
# and 1.0 revisions - the 1.0 circuit-board change is handled at runtime
# by the family kernel, like the BittBoy revisions. (The later PocketGo 2
# is a different SoC entirely and does not belong to this family.)
#
# Self-contained (it selects the architecture itself), so
# generate-config.sh --device pocketgo uses it in place of an arch
# fragment.

include sdk/board/allwinner-suniv/common.config
