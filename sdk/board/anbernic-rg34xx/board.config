# Anbernic RG34XX (Allwinner H700 / quad Cortex-A53).
#
# DEFINITION ONLY - not built or verified (see README.md). Shared Allwinner H700 / quad Cortex-A53 options
# live in the family fragment; this board adds its device tree name.

include sdk/board/allwinner-h700/common.config

BR2_LINUX_KERNEL_INTREE_DTS_NAME="allwinner/sun50i-h700-anbernic-rg34xx"

# U-Boot board defconfig (verify against the U-Boot version in use).
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="anbernic_rg35xx_h700_lpddr4"
