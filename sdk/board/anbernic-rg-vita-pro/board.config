# Anbernic RG Vita Pro (Rockchip RK3576 / A72 + A53).
#
# DEFINITION ONLY - not built or verified (see README.md). Shared Rockchip RK3576 / A72 + A53 options
# live in the family fragment; this board adds its device tree name.

include sdk/board/rockchip-rk3576/common.config

BR2_LINUX_KERNEL_INTREE_DTS_NAME="rk3576-anbernic-rg-vita-pro"

# U-Boot board defconfig (verify against the U-Boot version in use).
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="generic-rk3576"
