# Shared board options for Qualcomm SM8250 / Snapdragon 865 handhelds.
#
# A device board.config includes this and adds only its own device tree name:
#
#     include sdk/board/qualcomm-sm8250/common.config
#     BR2_LINUX_KERNEL_INTREE_DTS_NAME="qcom/sm8250-<device>"
#
# DEFINITION ONLY - these boards are not built or verified in this repo. A real
# build additionally needs a Qualcomm SM8250 kernel with the SM8250 patch set
# and the device tree; Buildroot's mainline kernel and mesa do not carry them.

# Snapdragon 865: 1x Cortex-A77 + 3x A77 + 4x A55, tuned as A76.A55.
BR2_aarch64=y
BR2_cortex_a76_a55=y

# Build the device tree into the kernel (device sets the DTS name).
BR2_LINUX_KERNEL_DTS_SUPPORT=y

# Use the shared SM8250 kernel fragment instead of the per-board default.
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="@SWIFT_LINUX@/sdk/board/qualcomm-sm8250/linux.fragment"

# Boot: the vendor bootloader chainloads UEFI GRUB, so the A/B payload is the
# same one the QEMU boards use.
include sdk/defconfig/boot/uefi-ab.config

# Adreno 650 GPU: the freedreno OpenGL/GLES + Vulkan (turnip) capability.
include sdk/defconfig/gpu/freedreno.config

# Bootloader: these devices boot via UEFI (arm-efi), chainloaded from the
# Qualcomm/Android bootloader, so the same GRUB arm64-efi path as the QEMU
# virt board (bootaa64.efi).
BR2_TARGET_GRUB2_ARM64_EFI=y

# Console on the built-in panel (fbcon); the GENI serial is only on test pads.
BR2_TARGET_GENERIC_GETTY_PORT="tty0"
