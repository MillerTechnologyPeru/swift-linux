# Shared board options for Qualcomm SM8250 / Snapdragon 865 handhelds.
#
# A device board.config includes this and adds only its own device tree name:
#
#     include sdk/board/qualcomm-sm8250/common.config
#     BR2_LINUX_KERNEL_INTREE_DTS_NAME="qcom/sm8250-<device>"
#
# NOT YET BUILT on hardware - the kernel side (version, config, patches, device
# trees) is wired up here, but no SM8250 device has been booted from this repo.
# See the device READMEs for what bring-up still needs.

# Snapdragon 865: 1x Cortex-A77 + 3x A77 + 4x A55, tuned as A76.A55.
BR2_aarch64=y
BR2_cortex_a76_a55=y

# Build the device tree into the kernel (device sets the DTS name).
BR2_LINUX_KERNEL_DTS_SUPPORT=y

# The SM8250 kernel config, imported whole rather than expressed as a fragment
# on top of arm64 "defconfig": the platform, Adreno, display-panel, audio and
# power drivers this SoC needs are far more than a fragment can sensibly carry,
# and the patch set below was developed against exactly this config. The image
# profile's own requirements (EROFS/f2fs root and data, initramfs, removable
# media) are added on top by the LINUX_CONFIG_FIXUPS of image-storage,
# swift-initramfs and media-automount, so they are deliberately not repeated
# here. The file is kept byte-identical to its source; see patches/README.md.
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="@SWIFT_LINUX@/sdk/board/qualcomm-sm8250/linux.aarch64.conf"

# Boot: the vendor bootloader chainloads UEFI GRUB, so the A/B payload is the
# same one the QEMU boards use.
include sdk/defconfig/boot/uefi-ab.config

# Adreno 650 GPU: the freedreno OpenGL/GLES + Vulkan (turnip) capability.
include sdk/defconfig/gpu/freedreno.config

# Bootloader: these devices boot via UEFI (arm-efi), chainloaded from the
# Qualcomm/Android bootloader, so the same GRUB arm64-efi path as the QEMU
# virt board (bootaa64.efi).
BR2_TARGET_GRUB2_ARM64_EFI=y

# Console on the built-in panel (fbcon); the GENI serial is only on test pads.
BR2_TARGET_GENERIC_GETTY_PORT="tty0"

# Kernel pinned to the version the imported config and patch set target (see
# patches/README.md); the image default of "latest" would not take the patches.
# BR2_LINUX_KERNEL_LATEST_VERSION is not set
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="7.1.2"

# Kernel patches. This repo's own package patches stay first; the two kernel
# sets follow in the order the source distribution applies them - the SM8250
# device set, then the fixes that belong to the 7.0 kernel series. There is no
# @BOARD@/patches entry, because Buildroot errors out on a BR2_GLOBAL_PATCH_DIR
# entry that does not exist and no SM8250 device needs patches of its own; one
# that does appends its directory to this line from its board.config, the same
# way BR2_ROOTFS_OVERLAY below would be extended.
BR2_GLOBAL_PATCH_DIR="@SWIFT_LINUX@/external/patches/packages @SWIFT_LINUX@/sdk/board/qualcomm-sm8250/patches @SWIFT_LINUX@/sdk/board/qualcomm-sm8250/patches-7.0"

# Device trees imported alongside the patches (see dts/README.md). This is the
# directory form (copied over arch/arm64/boot/dts/ with its qcom/ subdirectory
# intact), not the deprecated BR2_LINUX_KERNEL_CUSTOM_DTS_PATH file list, which
# would flatten them and lose the vendor prefix the kernel's 6.12+ device tree
# makefiles expect. Every SM8250 device tree in the directory is built and
# installed; BR2_LINUX_KERNEL_INTREE_DTS_NAME is what still names the one a
# given board boots, for boardinfo and the boot glue.
BR2_LINUX_KERNEL_CUSTOM_DTS_DIR="@SWIFT_LINUX@/sdk/board/qualcomm-sm8250/dts"

# Family overlay: udev rules for the on-board gamepads and the WCD938x
# headphone-jack fix. Replaces the image profile's default overlay list, which
# no SM8250 device extends further.
BR2_ROOTFS_OVERLAY="@SWIFT_LINUX@/sdk/board/common/rootfs-overlay @SWIFT_LINUX@/sdk/board/qualcomm-sm8250/rootfs-overlay"

# Signed abl bootloader payloads for the Qualcomm flashing flow.
BR2_PACKAGE_ROCKNIX_ABL=y

# Soldered Qualcomm radio: wifi from the ath firmware groups plus its
# qca Bluetooth half (see external/package/firmware-extra).
BR2_PACKAGE_FIRMWARE_EXTRA=y
BR2_PACKAGE_FIRMWARE_EXTRA_ATH_SOC=y
BR2_PACKAGE_FIRMWARE_EXTRA_QCA_BT=y
