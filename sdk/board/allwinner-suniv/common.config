# Shared board options for the Allwinner suniv "F1C" handhelds (ARM926EJ-S /
# armv5te, 32-64 MB embedded DRAM): BittBoy, PocketGo, PowKiddy Q90/V90/Q20.
#
# A device board.config includes this and adds only its own notes - the
# whole family boots the same kernel and U-Boot, from the CFW project that
# maintains these devices:
#
#     kernel: https://github.com/MiyooCFW/kernel  (miyoo_defconfig)
#     u-boot: https://github.com/MiyooCFW/uboot   (miyoo_defconfig)
#
# Both cover every family member with runtime hardware detection (panel
# variants, button matrices, rumble); there are no per-device defconfigs
# upstream. Pin both repos to release tags before a real build; master is
# referenced here as the starting point.
#
# DEFINITION ONLY - these boards are not built or verified in this repo
# (see README.md).

# ARM926EJ-S (armv5te). EABI, no VFP: the suniv SoCs have no FPU, so
# soft-float.
BR2_arm=y
BR2_arm926t=y
BR2_ARM_EABI=y
BR2_ARM_SOFT_FLOAT=y

# Family kernel (5.15-era suniv tree with these devices' DTS/drivers).
BR2_LINUX_KERNEL_CUSTOM_GIT=y
BR2_LINUX_KERNEL_CUSTOM_REPO_URL="https://github.com/MiyooCFW/kernel.git"
BR2_LINUX_KERNEL_CUSTOM_REPO_VERSION="master"
BR2_LINUX_KERNEL_DEFCONFIG="miyoo"

# Family U-Boot for the suniv SD-card boot chain (boot0 + SPL). Not UEFI:
# the uefi-ab fragment does not apply to these boards.
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_BUILD_SYSTEM_KCONFIG=y
BR2_TARGET_UBOOT_CUSTOM_GIT=y
BR2_TARGET_UBOOT_CUSTOM_REPO_URL="https://github.com/MiyooCFW/uboot.git"
BR2_TARGET_UBOOT_CUSTOM_REPO_VERSION="master"
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="miyoo"

# Serial console on the suniv UART (pads); the panel belongs to the
# frontend.
BR2_TARGET_GENERIC_GETTY_PORT="ttyS0"

# Frontend: gmenu2x on the framebuffer - no GL(ES) on this SoC. The
# frontend build ships the family input configs and the CFW stack picks
# the device variant at runtime.
include sdk/defconfig/frontend/gmenu2x.config

# 32-64 MB of RAM: drop the image baseline's heavyweight optional stacks.
# The GL/desktop graphics baseline goes with the frontend switch; the
# container runtime is unusable at this scale.
# BR2_PACKAGE_PODMAN is not set
# BR2_PACKAGE_CRUN is not set
# BR2_PACKAGE_PASST is not set
# BR2_PACKAGE_MESA3D is not set
# BR2_PACKAGE_XWAYLAND is not set
# BR2_PACKAGE_XORG7 is not set
# BR2_PACKAGE_SDL3 is not set
# BR2_PACKAGE_VULKAN_LOADER is not set
# BR2_PACKAGE_VULKAN_TOOLS is not set
