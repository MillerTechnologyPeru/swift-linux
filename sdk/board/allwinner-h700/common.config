# Shared board options for Allwinner H700 handhelds (quad Cortex-A53, Mali-G31).
#
# A device board.config includes this and adds only its device tree name:
#
#     include sdk/board/allwinner-h700/common.config
#     BR2_LINUX_KERNEL_INTREE_DTS_NAME="allwinner/sun50i-h700-<device>"
#
# DEFINITION ONLY - not built or verified. A real build needs an H700 kernel
# with the device DTS and Mali/panfrost, plus U-Boot boot support: these boards
# boot via U-Boot + extlinux from SD/eMMC, not the UEFI A/B path used by the
# QEMU boards in this tree.

BR2_aarch64=y
BR2_cortex_a53=y

BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="@SWIFT_LINUX@/sdk/board/common/linux-nfc.fragment @SWIFT_LINUX@/sdk/board/allwinner-h700/linux.fragment"

# Mali-G31 GPU via panfrost.
include sdk/defconfig/gpu/panfrost.config

# Console on the built-in panel (fbcon).
BR2_TARGET_GENERIC_GETTY_PORT="tty0"

# --- Boot chain (U-Boot + ATF), device tree and patches -------------------
# These devices boot via U-Boot + extlinux from SD/eMMC. H700 (H616 family)
# U-Boot needs an ATF BL31 (sun50i_h616 platform); the device board.config sets
# the per-device U-Boot defconfig. u-boot-sunxi-with-spl.bin is written at 8 KiB.
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_BUILD_SYSTEM_KCONFIG=y
BR2_TARGET_UBOOT_NEEDS_ATF_BL31=y
BR2_TARGET_UBOOT_NEEDS_DTC=y
BR2_TARGET_UBOOT_NEEDS_PYLIBFDT=y
BR2_TARGET_UBOOT_FORMAT_CUSTOM=y
BR2_TARGET_UBOOT_FORMAT_CUSTOM_NAME="u-boot-sunxi-with-spl.bin"

BR2_TARGET_ARM_TRUSTED_FIRMWARE=y
BR2_TARGET_ARM_TRUSTED_FIRMWARE_PLATFORM="sun50i_h616"

BR2_LINUX_KERNEL_CUSTOM_DTS_DIR="@SWIFT_LINUX@/sdk/board/allwinner-h700/dts"
BR2_GLOBAL_PATCH_DIR="@SWIFT_LINUX@/external/patches/packages @SWIFT_LINUX@/sdk/board/allwinner-h700/patches @BOARD@/patches"

BR2_ROOTFS_POST_IMAGE_SCRIPT="@SWIFT_LINUX@/sdk/board/allwinner-h700/post-image.sh"

# Kernel pinned to the version the imported patch set targets (see
# patches/README.md); the image default of "latest" would not take the
# patches.
# BR2_LINUX_KERNEL_LATEST_VERSION is not set
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.15.6"

# Radio/SoC blobs the mainline linux-firmware set does not carry.
BR2_PACKAGE_FIRMWARE_ARMBIAN=y
