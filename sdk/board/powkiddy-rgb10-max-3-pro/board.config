# Powkiddy RGB10 Max 3 Pro (Amlogic S922X / 4x A73 + 2x A53).
#
# DEFINITION ONLY - not built or verified (see README.md). Shared Amlogic S922X / 4x A73 + 2x A53 options
# live in the family fragment; this board adds its device tree name.

include sdk/board/amlogic-s922x/common.config

BR2_LINUX_KERNEL_INTREE_DTS_NAME="amlogic/meson-g12b-powkiddy-rgb10-max-3-pro"

# U-Boot board defconfig (verify against the U-Boot version in use).
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="odroid-go-ultra"
