# Shared board options for Qualcomm SM6115 / Snapdragon 662 (Adreno 610) handhelds.
#
# A device board.config includes this and adds only its device tree name.
#
# DEFINITION ONLY - not built or verified. A real build needs a kernel with
# these devices' DTS and driver patches (see patches/README.md).
#
# Boot: these devices boot as an Android boot image (kernel + dtb wrapped by
# mkbootimg) chainloaded from the Qualcomm/Android bootloader - not U-Boot and
# not the UEFI A/B path used by the QEMU boards. Image assembly for that chain
# is not implemented here.

BR2_aarch64=y
# Kryo 260 (4x A73-class + 4x A53-class).
BR2_cortex_a73_a53=y

BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="@SWIFT_LINUX@/sdk/board/qualcomm-sm6115/linux.fragment"
BR2_LINUX_KERNEL_CUSTOM_DTS_PATH="@SWIFT_LINUX@/sdk/board/qualcomm-sm6115/dts"
BR2_GLOBAL_PATCH_DIR="@SWIFT_LINUX@/sdk/board/qualcomm-sm6115/patches @BOARD@/patches"

# Adreno 610 GPU: freedreno GL/GLES + turnip Vulkan.
include sdk/defconfig/gpu/freedreno.config

BR2_TARGET_GENERIC_GETTY_PORT="tty0"

# Kernel pinned to the version the imported patch set targets (see
# patches/README.md); the image default of "latest" would not take the
# patches.
# BR2_LINUX_KERNEL_LATEST_VERSION is not set
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.15.6"

# Signed abl bootloader payloads for the Qualcomm flashing flow.
BR2_PACKAGE_ROCKNIX_ABL=y

# Soldered Qualcomm radio: wifi from the ath firmware groups plus its
# qca Bluetooth half (see external/package/firmware-extra).
BR2_PACKAGE_FIRMWARE_EXTRA=y
BR2_PACKAGE_FIRMWARE_EXTRA_ATH_SOC=y
BR2_PACKAGE_FIRMWARE_EXTRA_QCA_BT=y
