# Acer Chromebook Tab 10 (scarlet; ChromeOS calls the device dru) - Rockchip
# RK3399 Chromebook tablet.
#
# DEFINITION ONLY - not built or verified (see README.md). Depthcharge boot;
# shared Rockchip RK3399 options live in the family fragment.

include sdk/board/chromebook-rk3399/common.config

# Both device trees, not one. The model shipped with two display suppliers -
# Innolux and Kingdisplay - and the panel is the only thing that differs
# between them, so there is nothing to choose between at build time and no way
# to tell from the outside which one a given tablet has. Depthcharge is handed
# both and matches at boot. postmarketOS covers the whole family from a single
# image the same way, with deviceinfo_dtb="rockchip/rk3399-gru*".
BR2_LINUX_KERNEL_INTREE_DTS_NAME="rockchip/rk3399-gru-scarlet-inx rockchip/rk3399-gru-scarlet-kd"
