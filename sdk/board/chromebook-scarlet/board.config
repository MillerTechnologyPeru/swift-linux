# Acer Chromebook Tab 10 (scarlet; ChromeOS calls the device dru) - Rockchip
# RK3399 Chromebook tablet.
#
# DEFINITION ONLY - not built or verified (see README.md). Depthcharge boot;
# shared Rockchip RK3399 options live in the family fragment.

include sdk/board/chromebook-rk3399/common.config

# Both device trees, not one. The model shipped with two display suppliers -
# Innolux and Kingdisplay - and the panel is the only thing that differs
# between them, so there is nothing to choose between at build time and no way
# to tell from the outside which one a given tablet has. Depthcharge is handed
# both and matches at boot. postmarketOS covers the whole family from a single
# image the same way, with deviceinfo_dtb="rockchip/rk3399-gru*".
BR2_LINUX_KERNEL_INTREE_DTS_NAME="rockchip/rk3399-gru-scarlet-inx rockchip/rk3399-gru-scarlet-kd"

# Radio firmware. Unlike its siblings bob and kevin (Broadcom SDIO radios),
# scarlet carries a Qualcomm QCA6174A combo - the dtsi's wifi reset line is a
# PCIe PERST# and its bluetooth node is USB "usbcf3,e300". Both blobs are in
# upstream linux-firmware, and both drivers (ath10k_pci, btusb) are already
# modules in the arch default kernel configuration this family builds with;
# only the firmware was missing:
#   - ath10k/QCA6174/ for the PCIe wifi
#   - qca/*_usb_*.bin for the USB Rome bluetooth. Buildroot's option installs
#     exactly the USB variants, which is the right half here - the kukui
#     family needed the whole qca/ directory instead because its 6174 is on
#     UART (see chromebook-mt8183/common.config).
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_QUALCOMM_6174=y
BR2_PACKAGE_LINUX_FIRMWARE_QUALCOMM_6174A_BT=y
# The Broadcom BT firmware chromebook-common selects is for the BCM radios in
# bob and kevin; nothing on scarlet uses it (same reasoning, other direction,
# as the mt8183 family). Later assignment wins over the family's =y.
# BR2_PACKAGE_BROADCOM_BT_FIRMWARE is not set

# The tablet cameras (front OV2685, rear OV5695, both wired through the
# RK3399's ISP in the dtsi) and the rkvdec video decoder are not in the arch
# default configuration, so a board fragment adds them. Reassigned rather than
# appended because a defconfig has no += - the family's two fragments are
# repeated here deliberately (later assignment wins).
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="@SWIFT_LINUX@/sdk/board/chromebook-common/linux-cros.fragment @SWIFT_LINUX@/sdk/board/chromebook-rk3399/linux.fragment @BOARD@/linux.fragment"
