# Shared board options for Rockchip RK3399 (2x A72 + 4x A53, Mali-T860) Chromebooks.
#
# DEFINITION ONLY - see sdk/board/chromebook-common/README.md for the
# Depthcharge boot chain. A device board.config includes this and sets its
# device tree name.

include sdk/board/chromebook-common/common.config

BR2_cortex_a72_a53=y

BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="@SWIFT_LINUX@/sdk/board/chromebook-common/linux-cros.fragment @SWIFT_LINUX@/sdk/board/chromebook-rk3399/linux.fragment"
# No BR2_LINUX_KERNEL_CUSTOM_DTS_DIR: every board in this family names a
# mainline in-tree device tree (BR2_LINUX_KERNEL_INTREE_DTS_NAME), and
# pointing the option at a directory that does not exist fails the build.
BR2_GLOBAL_PATCH_DIR="@SWIFT_LINUX@/external/patches/packages @SWIFT_LINUX@/sdk/board/chromebook-rk3399/patches @BOARD@/patches"

# Mali-T860 (midgard) via panfrost.
include sdk/defconfig/gpu/panfrost.config
