# Anbernic RG552 (Rockchip RK3399 / 2x A72 + 4x A53).
#
# DEFINITION ONLY - not built or verified (see README.md). Shared Rockchip RK3399 / 2x A72 + 4x A53 options
# live in the family fragment; this board adds its device tree name.

include sdk/board/rockchip-rk3399/common.config

BR2_LINUX_KERNEL_INTREE_DTS_NAME="rockchip/rk3399-anbernic-rg552"

# U-Boot board defconfig (verify against the U-Boot version in use).
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="evb-rk3399"
