# Powkiddy RGB20 Pro (Rockchip RK3566 / quad Cortex-A55).
#
# DEFINITION ONLY - not built or verified (see README.md). Shared Rockchip RK3566 / quad Cortex-A55 options
# live in the family fragment; this board adds its device tree name.

include sdk/board/rockchip-rk3566/common.config

BR2_LINUX_KERNEL_INTREE_DTS_NAME="rk3566-powkiddy-rgb20-pro"

# U-Boot board defconfig (verify against the U-Boot version in use).
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="anbernic-rgxx3-rk3566"
