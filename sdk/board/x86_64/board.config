# x86_64 board specifics for the image profile (QEMU x86_64, UEFI).
BR2_LINUX_KERNEL_USE_DEFCONFIG=y
BR2_LINUX_KERNEL_DEFCONFIG="x86_64"

# The x86_64 defconfig enables CONFIG_UNWINDER_ORC, whose objtool needs host
# libelf (gelf.h). Build host-elfutils so the kernel's objtool can compile.
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y

# It also enables module signing / CONFIG_SYSTEM_TRUSTED_KEYRING, whose
# certs/extract-cert host tool needs host OpenSSL headers (openssl/bio.h).
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y

# GRUB EFI for x86_64 (bootx64.efi).
BR2_TARGET_GRUB2_X86_64_EFI=y

# Serial console on the 8250 UART.
BR2_TARGET_GENERIC_GETTY_PORT="ttyS0"
