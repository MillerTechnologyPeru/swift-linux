# x86_64 board specifics for the image profile (QEMU x86_64, UEFI).
BR2_LINUX_KERNEL_USE_DEFCONFIG=y
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="@SWIFT_LINUX@/sdk/board/common/linux-nfc.fragment @SWIFT_LINUX@/sdk/board/x86_64/linux.fragment"
BR2_LINUX_KERNEL_DEFCONFIG="x86_64"

# The x86_64 defconfig enables CONFIG_UNWINDER_ORC, whose objtool needs host
# libelf (gelf.h). Build host-elfutils so the kernel's objtool can compile.
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y

# It also enables module signing / CONFIG_SYSTEM_TRUSTED_KEYRING, whose
# certs/extract-cert host tool needs host OpenSSL headers (openssl/bio.h).
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y

# Full desktop GPU stack (AMD/Intel/NVIDIA/virgl + software fallback), so one
# image boots on arbitrary PC hardware as well as in a VM.
include sdk/defconfig/gpu/x86-desktop.config

# GRUB EFI for x86_64 (bootx64.efi).
BR2_TARGET_GRUB2_X86_64_EFI=y

# Serial console on the 8250 UART.
BR2_TARGET_GENERIC_GETTY_PORT="ttyS0"

# Boot: UEFI firmware loads GRUB, which picks the A/B slot from grubenv.
include sdk/defconfig/boot/uefi-ab.config
BR2_ROOTFS_POST_IMAGE_SCRIPT="@SWIFT_LINUX@/sdk/board/x86_64/post-image.sh"

# SOF firmware for the DSP-routed audio the kernel fragment enables -
# without it, modern DMIC laptops (and the Steam Deck booting this image)
# have no sound device at all. The Chromebook UCM profiles ride along:
# x86 Chromebooks flashed with UEFI firmware boot this very image, and the
# profiles are inert unless a matching card is present.
BR2_PACKAGE_SOUND_OPEN_FIRMWARE=y
BR2_PACKAGE_CHROMEBOOK_UCM_CONF=y
