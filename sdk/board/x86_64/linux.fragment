# Extra kernel options for QEMU x86_64: virtio graphics/input, DRM/KMS for
# Weston, evdev input, ext4 root, plus the Bluetooth and wireless subsystems
# BlueZ and NetworkManager need. Merged on top of the arch default config.
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_BOCHS=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_EXT4_FS=y

# Sound (PipeWire needs a kernel sound device). virtio-sound is the portable
# QEMU device; Intel HDA covers most x86 hardware (and QEMU -device intel-hda).
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_PCM=y
CONFIG_SND_VIRTIO=y
CONFIG_SND_HDA_INTEL=y

# Bluetooth: without CONFIG_BT the kernel has no management interface and
# bluetoothd exits with "Failed to access management interface".
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_HIDP=y
CONFIG_BT_HS=y
# Transports: USB dongles, UART/serial, and the virtual controller (vhci),
# which allows testing the stack under QEMU with no real radio.
CONFIG_BT_HCIBTUSB=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_H4=y
CONFIG_BT_HCIVHCI=y

# Wireless: cfg80211/mac80211 are needed by iw and wpa_supplicant.
CONFIG_CFG80211=y
CONFIG_CFG80211_WEXT=y
CONFIG_MAC80211=y
CONFIG_RFKILL=y
# mac80211_hwsim provides a virtual wifi radio, again for testing in QEMU.
CONFIG_MAC80211_HWSIM=y

# --- Real PC hardware -----------------------------------------------------
# The base x86_64 defconfig already covers most of this; these are the pieces
# a generic image must not be missing, so one image boots on real machines as
# well as in a VM. Firmware-needing drivers are modules so their firmware is
# available before they probe.

# GPUs: AMD, Intel and NVIDIA (open), alongside the virtio driver.
CONFIG_DRM=y
CONFIG_DRM_AMDGPU=m
CONFIG_DRM_AMDGPU_SI=y
CONFIG_DRM_AMDGPU_CIK=y
CONFIG_DRM_AMD_DC=y
CONFIG_DRM_RADEON=m
CONFIG_DRM_I915=m
CONFIG_DRM_XE=m
CONFIG_DRM_NOUVEAU=m
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FB_EFI=y

# Storage: NVMe, AHCI/SATA, USB storage and SD readers.
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_MULTIPATH=y
CONFIG_SATA_AHCI=y
CONFIG_ATA_PIIX=y
CONFIG_USB_STORAGE=y
CONFIG_MMC=y
CONFIG_MMC_SDHCI_PCI=y
CONFIG_MMC_REALTEK_PCI=m

# USB controllers and HID.
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_HID_STEAM=m
CONFIG_HID_SONY=m
CONFIG_HID_MICROSOFT=m
CONFIG_HID_NINTENDO=m
CONFIG_JOYSTICK_XPAD=m

# Wired networking.
CONFIG_E1000=m
CONFIG_E1000E=m
CONFIG_IGB=m
CONFIG_IGC=m
CONFIG_R8169=m
CONFIG_ATL1C=m

# Wireless: Intel, Atheros, Realtek, Broadcom.
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m
CONFIG_ATH9K=m
CONFIG_ATH10K_PCI=m
CONFIG_ATH11K_PCI=m
CONFIG_RTW88_8822BE=m
CONFIG_RTW89_8852AE=m
CONFIG_BRCMFMAC=m
CONFIG_BT_HCIBTUSB=m

# Audio: HD-audio codecs plus the SOF path modern laptops use. The
# toplevel switches alone build nothing - the per-platform drivers and
# machine boards below are what actually probe. Firmware comes from the
# sound-open-firmware package (board.config).
CONFIG_SND_HDA_CODEC_REALTEK=m
CONFIG_SND_HDA_CODEC_HDMI=m
CONFIG_SND_SOC=y
CONFIG_SND_SOC_SOF_TOPLEVEL=y
CONFIG_SND_SOC_SOF_PCI=y
CONFIG_SND_SOC_SOF_ACPI=y
CONFIG_SND_SOC_SOF_INTEL_TOPLEVEL=y
CONFIG_SND_SOC_SOF_HDA_AUDIO_CODEC=y
CONFIG_SND_SOC_SOF_APOLLOLAKE=y
CONFIG_SND_SOC_SOF_GEMINILAKE=y
CONFIG_SND_SOC_SOF_CANNONLAKE=y
CONFIG_SND_SOC_SOF_COFFEELAKE=y
CONFIG_SND_SOC_SOF_COMETLAKE=y
CONFIG_SND_SOC_SOF_ICELAKE=y
CONFIG_SND_SOC_SOF_JASPERLAKE=y
CONFIG_SND_SOC_SOF_TIGERLAKE=y
CONFIG_SND_SOC_SOF_ELKHARTLAKE=y
CONFIG_SND_SOC_SOF_ALDERLAKE=y
CONFIG_SND_SOC_SOF_METEORLAKE=y
CONFIG_SND_SOC_SOF_LUNARLAKE=y
CONFIG_SND_SOC_SOF_AMD_TOPLEVEL=y
CONFIG_SND_SOC_SOF_AMD_VANGOGH=y
CONFIG_SND_SOC_SOF_AMD_REMBRANDT=y
CONFIG_SND_SOC_INTEL_MACH=y
CONFIG_SND_SOC_INTEL_SKL_HDA_DSP_GENERIC_MACH=y
CONFIG_SND_SOC_INTEL_SOUNDWIRE_SOF_MACH=y
CONFIG_SND_SOC_AMD_ACP_COMMON=y

# Laptop/platform: battery, backlight, thermal, CPU frequency scaling.
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_AC=y
CONFIG_ACPI_VIDEO=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_THERMAL=y
CONFIG_X86_INTEL_PSTATE=y
CONFIG_X86_AMD_PSTATE=y
CONFIG_AMD_PMC=m
CONFIG_MICROCODE=y
