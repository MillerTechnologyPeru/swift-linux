# Powkiddy RGB30 (Rockchip RK3566 / quad Cortex-A55).
#
# DEFINITION ONLY - not built or verified (see README.md). Shared Rockchip RK3566 / quad Cortex-A55 options
# (CPU, Mali-G52 (panfrost), kernel fragment) live in the family fragment; only the device tree
# name is board-specific.
#
# Self-contained, so generate-config.sh --device powkiddy-rgb30 uses it in place of an
# arch fragment + the generic arm64 board.

include sdk/board/rockchip-rk3566/common.config

# Device tree (from a Rockchip RK3566 / quad Cortex-A55 kernel with this device's DTS).
BR2_LINUX_KERNEL_INTREE_DTS_NAME="rockchip/rk3566-powkiddy-rgb30"

# U-Boot board defconfig (verify it matches your U-Boot version).
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="anbernic-rgxx3-rk3566"
