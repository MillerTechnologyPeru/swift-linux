# ppc board specifics for the image profile (QEMU mac99, G4).
#
# Booted by QEMU's -kernel for now (util/ppc-qemu.sh): OpenBIOS loading
# GRUB comes later, so there is no boot capability fragment and no RAUC.
BR2_LINUX_KERNEL_USE_DEFCONFIG=y
BR2_LINUX_KERNEL_DEFCONFIG="pmac32"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="@SWIFT_LINUX@/sdk/board/common/linux-nfc.fragment @SWIFT_LINUX@/sdk/board/ppc/linux.fragment"
# -kernel on mac99 takes the ELF vmlinux.
BR2_LINUX_KERNEL_VMLINUX=y

# Serial console on the first ESCC port (pmac_zilog).
BR2_TARGET_GENERIC_GETTY_PORT="ttyPZ0"

# No GPU and no LLVM: Mesa with softpipe only, composited with pixman.
include sdk/defconfig/gpu/softpipe.config

# sway and foot. EmulationStation needs real GL and waits for a board with a
# GPU.
include sdk/defconfig/frontend/minimal.config

BR2_ROOTFS_POST_IMAGE_SCRIPT="@SWIFT_LINUX@/sdk/board/ppc/post-image.sh"
