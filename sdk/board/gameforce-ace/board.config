# Gameforce Ace (Rockchip RK3588S / 4x A76 + 4x A55).
#
# DEFINITION ONLY - not built or verified (see README.md). Shared Rockchip RK3588S / 4x A76 + 4x A55 options
# live in the family fragment; this board adds its device tree name.

include sdk/board/rockchip-rk3588/common.config

BR2_LINUX_KERNEL_INTREE_DTS_NAME="rockchip/rk3588s-gameforce-ace"

# U-Boot board defconfig (verify against the U-Boot version in use).
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="orangepi_5"
