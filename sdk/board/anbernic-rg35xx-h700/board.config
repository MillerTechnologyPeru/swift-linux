# Anbernic RG35XX H700 (Allwinner H700 / quad Cortex-A53).
#
# DEFINITION ONLY - not built or verified (see README.md). Shared Allwinner H700 / quad Cortex-A53 options
# (CPU, Mali-G31 (panfrost), kernel fragment) live in the family fragment; only the device tree
# name is board-specific.
#
# Self-contained, so generate-config.sh --device anbernic-rg35xx-h700 uses it in place of an
# arch fragment + the generic arm64 board.

include sdk/board/allwinner-h700/common.config

# Device tree (from a Allwinner H700 / quad Cortex-A53 kernel with this device's DTS).
BR2_LINUX_KERNEL_INTREE_DTS_NAME="allwinner/sun50i-h700-anbernic-rg35xx-h700"

# U-Boot board defconfig (verify it matches your U-Boot version).
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="anbernic-rg35xx-h700"
