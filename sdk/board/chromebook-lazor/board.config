# Acer Chromebook Spin 513 (lazor) (Qualcomm SC7180 Chromebook).
#
# DEFINITION ONLY - not built or verified (see README.md). Depthcharge boot;
# shared Qualcomm SC7180 options live in the family fragment.

include sdk/board/chromebook-sc7180/common.config

# Every lazor tree, one per board revision and SKU (touchscreen, keyboard-only,
# LTE, and the limozeen variants); Depthcharge boots the one whose compatible
# matches the unit, so one image boots every Spin 513.
BR2_LINUX_KERNEL_INTREE_DTS_NAME="qcom/sc7180-trogdor-lazor-limozeen-nots-r4 qcom/sc7180-trogdor-lazor-limozeen-nots-r5 qcom/sc7180-trogdor-lazor-limozeen-nots-r9 qcom/sc7180-trogdor-lazor-limozeen-nots-r10 qcom/sc7180-trogdor-lazor-limozeen-r4 qcom/sc7180-trogdor-lazor-limozeen-r9 qcom/sc7180-trogdor-lazor-limozeen-r10 qcom/sc7180-trogdor-lazor-r1 qcom/sc7180-trogdor-lazor-r1-kb qcom/sc7180-trogdor-lazor-r1-lte qcom/sc7180-trogdor-lazor-r3 qcom/sc7180-trogdor-lazor-r3-kb qcom/sc7180-trogdor-lazor-r3-lte qcom/sc7180-trogdor-lazor-r9 qcom/sc7180-trogdor-lazor-r9-kb qcom/sc7180-trogdor-lazor-r9-lte qcom/sc7180-trogdor-lazor-r10 qcom/sc7180-trogdor-lazor-r10-kb qcom/sc7180-trogdor-lazor-r10-lte"

# Temporarily without Perry, for a quicker image while its 32-bit builds are
# fixed. Remove to bring it back.
# BR2_PACKAGE_PERRY is not set
