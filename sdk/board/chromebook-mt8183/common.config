# Shared board options for MediaTek MT8183 (4x A73 + 4x A53, Mali-G72) Chromebooks.
#
# DEFINITION ONLY - see sdk/board/chromebook-common/README.md for the
# Depthcharge boot chain. A device board.config includes this and sets its
# device tree name.

include sdk/board/chromebook-common/common.config

BR2_cortex_a73_a53=y

BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="@SWIFT_LINUX@/sdk/board/common/linux-nfc.fragment @SWIFT_LINUX@/sdk/board/chromebook-common/linux-cros.fragment @SWIFT_LINUX@/sdk/board/chromebook-mt8183/linux.fragment"
# No BR2_LINUX_KERNEL_CUSTOM_DTS_DIR: every board in this family names a
# mainline in-tree device tree (BR2_LINUX_KERNEL_INTREE_DTS_NAME), and
# pointing the option at a directory that does not exist fails the build.
BR2_GLOBAL_PATCH_DIR="@SWIFT_LINUX@/external/patches/packages @SWIFT_LINUX@/sdk/board/chromebook-mt8183/patches @BOARD@/patches"

# Family overlay on top of the shared and Chromebook ones (a defconfig has no
# +=, so the earlier assignment is repeated): the UCM profile for the
# MT8183/MT6358 card. chromebook-ucm-conf carries no MediaTek configs, so
# without this the speakers stay silent - ALSA finds no use case for the card.
BR2_ROOTFS_OVERLAY="@SWIFT_LINUX@/sdk/board/common/rootfs-overlay @SWIFT_LINUX@/sdk/board/chromebook-common/rootfs-overlay @SWIFT_LINUX@/sdk/board/chromebook-mt8183/rootfs-overlay"

# Radio firmware. Despite the MediaTek SoC the kukui radios are Qualcomm:
# mt8183-kukui.dtsi puts a "qcom,ath10k" part on SDIO (mmc1) and a
# "qcom,qca6174-bt" on UART1, whose firmware-name is nvm_00440302_i2s.bin.
# So this family needs the QCA6174 wifi tree, and the UART Bluetooth blobs
# from the whole qca/ directory - Buildroot's own QCA6174 Bluetooth option
# installs the USB variants only, which this hardware cannot use.
BR2_PACKAGE_LINUX_FIRMWARE_QUALCOMM_6174=y
BR2_PACKAGE_FIRMWARE_EXTRA=y
BR2_PACKAGE_FIRMWARE_EXTRA_QCA_BT=y
# SCP coprocessor image (mediatek/mt8183/scp.img): the video codec hangs off
# it, and mtk_scp does not probe without the blob.
BR2_PACKAGE_FIRMWARE_EXTRA_MTK_SCP=y
# The Broadcom combo firmware chromebook-common selects is for the BCM radios
# in the Rockchip and MT8173 Chromebooks; nothing on kukui uses it.
# BR2_PACKAGE_BROADCOM_BT_FIRMWARE is not set

# Mali-G72 (bifrost) via panfrost.
include sdk/defconfig/gpu/panfrost.config
