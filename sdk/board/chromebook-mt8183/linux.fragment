# MediaTek MT8183 (kukui) Chromebooks.
CONFIG_ARCH_MEDIATEK=y
CONFIG_PINCTRL_MT8183=y
CONFIG_MTK_PMIC_WRAP=y
CONFIG_MTK_SVS=y
CONFIG_DRM=y
# The display chain has to be built in, not modular. There is no initramfs,
# so a module cannot load until the root filesystem is already mounted, and
# the panel would stay dark for the whole of boot. MTK_CMDQ and MTK_MMSYS are
# listed because DRM_MEDIATEK cannot be built in while they are modules -
# Kconfig quietly caps it at m instead.
CONFIG_MTK_CMDQ=y
CONFIG_MTK_MMSYS=y
CONFIG_PHY_MTK_MIPI_DSI=y
CONFIG_DRM_MEDIATEK=y
CONFIG_DRM_PANFROST=y
CONFIG_DRM_PANEL_BOE_TV101WUM_NL6=y
# Audio: the machine driver for the MT6358 codec with the TS3A227E jack
# detector and MAX98357A speaker amp - the card the UCM profile in this
# family's rootfs-overlay configures (hw:mt8183mt6358ts3).
CONFIG_SND_SOC_MT8183_MT6358_TS3A227E_MAX98357A=y
CONFIG_MMC=y
CONFIG_MMC_MTK=y
CONFIG_MTK_SCP=y
CONFIG_I2C_MT65XX=y
CONFIG_SPI_MT65XX=y
