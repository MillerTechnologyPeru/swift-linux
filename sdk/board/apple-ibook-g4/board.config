# Apple iBook G4 (PowerBook6,7 and its siblings), booted from a USB stick.
#
# The QEMU mac99 board's image, made bootable on the real machine: Open
# Firmware loads the kernel from an HFS partition on an Apple partition map
# (see post-image.sh), and the kernel mounts the stick's root partition.
# The machine's own hardware is in linux.fragment.

include sdk/defconfig/arch/ppc.config
include sdk/board/ppc/board.config

# The kernel as zImage.pmac, an ELF that Open Firmware loads and that
# decompresses the kernel itself, in place of the bare vmlinux QEMU takes.
# BR2_LINUX_KERNEL_VMLINUX is not set
BR2_LINUX_KERNEL_IMAGE_TARGET_CUSTOM=y
BR2_LINUX_KERNEL_IMAGE_TARGET_NAME="zImage.pmac"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="@SWIFT_LINUX@/sdk/board/common/linux-nfc.fragment @SWIFT_LINUX@/sdk/board/ppc/linux.fragment @SWIFT_LINUX@/sdk/board/apple-ibook-g4/linux.fragment"

# The screen and keyboard: there is no serial port to log in on.
BR2_TARGET_GENERIC_GETTY_PORT="tty1"

# AirPort Extreme (BCM4318), driven by b43 with Broadcom's firmware.
BR2_PACKAGE_B43_FIRMWARE=y

# The disk image: an Apple partition map with an HFS boot partition.
BR2_PACKAGE_HOST_PARTED=y
BR2_PACKAGE_HOST_HFSUTILS=y
BR2_ROOTFS_POST_IMAGE_SCRIPT="@SWIFT_LINUX@/sdk/board/apple-ibook-g4/post-image.sh"

# Without Perry for now.
# BR2_PACKAGE_PERRY is not set
