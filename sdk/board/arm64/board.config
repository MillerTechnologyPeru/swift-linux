# arm64 board specifics for the image profile (QEMU aarch64 virt, UEFI).
# arm64's in-tree kernel config is literally arch/arm64/configs/defconfig, so
# use the "architecture default configuration" option. Naming it via
# BR2_LINUX_KERNEL_DEFCONFIG="defconfig" would make Buildroot run the target
# "defconfig_defconfig", which does not exist.
BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG=y
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="@SWIFT_LINUX@/sdk/board/common/linux-nfc.fragment @SWIFT_LINUX@/sdk/board/arm64/linux.fragment"

# GRUB EFI for arm64 (bootaa64.efi).
BR2_TARGET_GRUB2_ARM64_EFI=y

# Serial console on the PL011 UART used by QEMU's virt machine.
BR2_TARGET_GENERIC_GETTY_PORT="ttyAMA0"

# Boot: UEFI firmware loads GRUB, which picks the A/B slot from grubenv.
include sdk/defconfig/boot/uefi-ab.config
BR2_ROOTFS_POST_IMAGE_SCRIPT="@SWIFT_LINUX@/sdk/board/arm64/post-image.sh"
