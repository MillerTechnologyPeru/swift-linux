# Extra kernel options for QEMU aarch64 (virt machine): virtio graphics and
# input, DRM/KMS for sway, evdev, ext4 root, plus the Bluetooth and wireless
# subsystems. Merged on top of the arm64 "defconfig".
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_EXT4_FS=y

# binfmt_misc, so S07binfmt can register the box64/box86 handlers (the arm64
# defconfig does not enable it; the x86_64 defconfig does).
CONFIG_BINFMT_MISC=y

# Bluetooth (BR/EDR + LE) and the virtual controller for testing under QEMU.
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_HIDP=y
CONFIG_BT_HCIBTUSB=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_H4=y
CONFIG_BT_HCIVHCI=y

# Wireless: cfg80211/mac80211 for iw and wpa_supplicant, plus a virtual radio.
CONFIG_CFG80211=y
CONFIG_CFG80211_WEXT=y
CONFIG_MAC80211=y
CONFIG_RFKILL=y
CONFIG_MAC80211_HWSIM=y
