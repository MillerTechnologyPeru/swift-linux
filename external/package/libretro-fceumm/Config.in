config BR2_PACKAGE_LIBRETRO_FCEUMM
	bool "libretro-fceumm"
	depends on BR2_PACKAGE_RETROARCH
	help
	  FCEUmm libretro core: NES / Famicom emulation. The first core
	  wired into the image, chosen for its plain-Makefile build and
	  tiny footprint; further systems follow the same pattern.

	  https://github.com/libretro/libretro-fceumm
