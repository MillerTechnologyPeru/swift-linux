config BR2_PACKAGE_GNOME_DESKTOP
	bool "gnome-desktop"
	depends on BR2_PACKAGE_LIBGTK4
	select BR2_PACKAGE_ISO_CODES
	select BR2_PACKAGE_LIBSECCOMP
	select BR2_PACKAGE_GSETTINGS_DESKTOP_SCHEMAS
	select BR2_PACKAGE_XKEYBOARD_CONFIG
	help
	  gnome-desktop-4: shared helpers (languages, wallpaper,
	  thumbnails, xkb info) for gnome-shell and the settings daemon.

	  https://gitlab.gnome.org/GNOME/gnome-desktop
