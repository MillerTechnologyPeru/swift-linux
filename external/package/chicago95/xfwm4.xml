<?xml version="1.0" encoding="UTF-8"?>
<!-- Image-wide defaults: Chicago95 window decorations (see the chicago95
     package). Per-user settings in ~/.config/xfce4 override these. -->
<channel name="xfwm4" version="1.0">
  <property name="general" type="empty">
    <property name="theme" type="string" value="Chicago95"/>
    <property name="title_font" type="string" value="Sans Bold 8"/>
    <!-- The session runs inside a Wayland compositor (cage) that already
         composites; xfwm4 compositing on top would double the work. Also
         period-correct for the theme. -->
    <property name="use_compositing" type="bool" value="false"/>
  </property>
</channel>
