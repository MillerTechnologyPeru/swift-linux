config BR2_PACKAGE_XDG_DESKTOP_PORTAL_GNOME
	bool "xdg-desktop-portal-gnome"
	depends on BR2_PACKAGE_LIBGTK4
	select BR2_PACKAGE_XDG_DESKTOP_PORTAL
	select BR2_PACKAGE_LIBADWAITA
	select BR2_PACKAGE_GNOME_DESKTOP
	help
	  The GNOME backend for xdg-desktop-portal (GTK4/libadwaita
	  dialogs, screencast via mutter).

	  https://gitlab.gnome.org/GNOME/xdg-desktop-portal-gnome
