config BR2_PACKAGE_GNOME_CALCULATOR
	bool "gnome-calculator"
	depends on BR2_PACKAGE_LIBGTK4
	select BR2_PACKAGE_LIBADWAITA
	select BR2_PACKAGE_GTKSOURCEVIEW5
	select BR2_PACKAGE_LIBGEE
	select BR2_PACKAGE_MPFR
	select BR2_PACKAGE_GMP
	select BR2_PACKAGE_LIBSOUP3 # currency rates
	help
	  Calculator, written in Vala; currency conversion pulls rates
	  over libsoup.

	  https://apps.gnome.org/Calculator/
