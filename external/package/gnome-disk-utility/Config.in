config BR2_PACKAGE_GNOME_DISK_UTILITY
	bool "gnome-disk-utility"
	depends on BR2_PACKAGE_LIBGTK4
	select BR2_PACKAGE_LIBADWAITA
	select BR2_PACKAGE_UDISKS2
	select BR2_PACKAGE_LIBPWQUALITY
	select BR2_PACKAGE_LIBSECRET
	select BR2_PACKAGE_LIBDVDREAD
	help
	  Disks, the UI over udisks: partitions, formatting, SMART,
	  images.

	  https://apps.gnome.org/DiskUtility/
