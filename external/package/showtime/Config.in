config BR2_PACKAGE_SHOWTIME
	bool "showtime"
	depends on BR2_PACKAGE_LIBGTK4
	select BR2_PACKAGE_LIBADWAITA
	select BR2_PACKAGE_PYTHON3
	select BR2_PACKAGE_PYTHON_GOBJECT
	select BR2_PACKAGE_GST1_PLUGINS_BASE
	select BR2_PACKAGE_GST1_PLUGINS_GOOD
	help
	  Showtime, the GNOME video player (Python/GTK 4 over
	  GStreamer) - chosen over Totem, whose libhandy/grilo stack
	  this image does not carry.

	  https://apps.gnome.org/Showtime/
