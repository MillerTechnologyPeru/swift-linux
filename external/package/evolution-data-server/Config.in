config BR2_PACKAGE_EVOLUTION_DATA_SERVER
	bool "evolution-data-server"
	depends on BR2_PACKAGE_GCR4
	select BR2_PACKAGE_LIBICAL
	select BR2_PACKAGE_LIBSECRET
	select BR2_PACKAGE_LIBSOUP3
	select BR2_PACKAGE_JSON_GLIB
	select BR2_PACKAGE_SQLITE
	select BR2_PACKAGE_ICU
	help
	  Contact/calendar storage services. A gnome-shell hard build
	  dependency (its calendar reads libecal/libedataserver); built
	  here headless - no GTK UI, no online-accounts, no mail
	  backends beyond the local ones.

	  https://gitlab.gnome.org/GNOME/evolution-data-server
