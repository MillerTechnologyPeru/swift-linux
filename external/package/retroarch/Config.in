config BR2_PACKAGE_RETROARCH
	bool "retroarch"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on !BR2_STATIC_LIBS
	depends on BR2_PACKAGE_HAS_LIBGL || BR2_PACKAGE_HAS_LIBGLES
	select BR2_PACKAGE_ZLIB
	select BR2_PACKAGE_FREETYPE
	select BR2_PACKAGE_ALSA_LIB
	select BR2_PACKAGE_LIBXKBCOMMON
	help
	  The reference libretro frontend: loads emulator cores
	  (*_libretro.so) and gives them video, audio, input and
	  savestate plumbing. EmulationStation launches it with the
	  core matching the selected game's system.

	  Cores are separate packages (libretro-*); the frontend alone
	  runs nothing.

	  https://www.retroarch.com

comment "retroarch needs OpenGL(ES) and a toolchain w/ C++, threads, dynamic library"
	depends on !BR2_PACKAGE_HAS_LIBGL && !BR2_PACKAGE_HAS_LIBGLES
