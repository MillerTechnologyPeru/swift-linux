config BR2_PACKAGE_GNOME_CONTROL_CENTER
	bool "gnome-control-center"
	depends on BR2_PACKAGE_LIBGTK4
	select BR2_PACKAGE_LIBADWAITA
	select BR2_PACKAGE_ACCOUNTSSERVICE
	select BR2_PACKAGE_COLORD_GTK
	select BR2_PACKAGE_CUPS
	select BR2_PACKAGE_GNOME_BLUETOOTH
	select BR2_PACKAGE_GNOME_ONLINE_ACCOUNTS
	select BR2_PACKAGE_GSOUND
	select BR2_PACKAGE_LIBGTOP
	select BR2_PACKAGE_LIBNMA
	select BR2_PACKAGE_LIBPWQUALITY
	select BR2_PACKAGE_MODEM_MANAGER
	select BR2_PACKAGE_UDISKS2
	select BR2_PACKAGE_LIBKRB5
	help
	  Settings (gnome-control-center). The heaviest app of the set:
	  its panels hard-require cups, NetworkManager/libnma,
	  ModemManager, accountsservice, online-accounts and udisks -
	  note the image manages network with NetworkManager; the
	  network panel drives NetworkManager instead.

	  https://apps.gnome.org/Settings/
