config BR2_PACKAGE_SDL3
	bool "sdl3"
	depends on !BR2_STATIC_LIBS # dlopen
	depends on BR2_TOOLCHAIN_HAS_THREADS
	help
	  Simple DirectMedia Layer 3 (SDL3) is a cross-platform library
	  for low level access to audio, keyboard, mouse, joystick and
	  graphics hardware.

	  SDL3 is not packaged by Buildroot (which ships SDL2 only), so
	  this package provides it.

	  https://www.libsdl.org/

if BR2_PACKAGE_SDL3

config BR2_PACKAGE_SDL3_WAYLAND
	bool "Wayland video driver"
	default y
	depends on BR2_PACKAGE_WAYLAND
	select BR2_PACKAGE_LIBXKBCOMMON
	select BR2_PACKAGE_WAYLAND_PROTOCOLS
	help
	  Enable the Wayland video driver.

comment "Wayland video driver needs wayland"
	depends on !BR2_PACKAGE_WAYLAND

config BR2_PACKAGE_SDL3_KMSDRM
	bool "KMS/DRM video driver"
	depends on BR2_PACKAGE_HAS_LIBGBM
	depends on BR2_PACKAGE_HAS_LIBEGL
	select BR2_PACKAGE_LIBDRM
	help
	  Enable the KMS/DRM video driver, for rendering directly to a
	  display with no compositor.

comment "KMS/DRM video driver needs a GBM and EGL provider"
	depends on !BR2_PACKAGE_HAS_LIBGBM || !BR2_PACKAGE_HAS_LIBEGL

config BR2_PACKAGE_SDL3_X11
	bool "X11 video driver"
	depends on BR2_PACKAGE_XORG7
	select BR2_PACKAGE_XLIB_LIBX11
	select BR2_PACKAGE_XLIB_LIBXEXT
	help
	  Enable the X11 video driver.

comment "X11 video driver needs X.org"
	depends on !BR2_PACKAGE_XORG7

config BR2_PACKAGE_SDL3_OPENGLES
	bool "OpenGL ES support"
	default y
	depends on BR2_PACKAGE_HAS_LIBGLES
	help
	  Enable OpenGL ES rendering.

comment "OpenGL ES support needs an OpenGL ES provider"
	depends on !BR2_PACKAGE_HAS_LIBGLES

config BR2_PACKAGE_SDL3_OPENGL
	bool "OpenGL support"
	depends on BR2_PACKAGE_HAS_LIBGL
	help
	  Enable desktop OpenGL rendering.

comment "OpenGL support needs an OpenGL provider"
	depends on !BR2_PACKAGE_HAS_LIBGL

config BR2_PACKAGE_SDL3_ALSA
	bool "ALSA audio"
	depends on BR2_PACKAGE_ALSA_LIB
	help
	  Enable the ALSA audio driver.

comment "ALSA audio needs alsa-lib"
	depends on !BR2_PACKAGE_ALSA_LIB

config BR2_PACKAGE_SDL3_TESTS
	bool "build test programs"
	help
	  Build and install the SDL3 test programs, useful for checking
	  the video and audio drivers on target.

endif
