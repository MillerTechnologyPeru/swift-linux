config BR2_PACKAGE_SHADERC
	bool "shaderc"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on !BR2_STATIC_LIBS
	select BR2_PACKAGE_SPIRV_TOOLS
	select BR2_PACKAGE_SPIRV_HEADERS
	help
	  Google's shader-compilation library over glslang: the
	  libshaderc API Vulkan consumers (RetroArch's vulkan video
	  driver among them) use for runtime shader compilation.

	  https://github.com/google/shaderc
